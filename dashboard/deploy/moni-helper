# ---- memory by session (Memory > Sessions): list, detail, hide / unhide / delete
#
# Reads need claude.memory.read in the panel; every write here needs claude.memory.manage
# (administrators only by default) and is audited with counts, never content. Three rules
# the panel cannot get around, because they live here:
#   * a session that is running now (a live Claude Code process, MINT AI's current
#     session, or a transcript written in the last CC_MM_RECENT seconds) can never be
#     hidden or deleted as a whole -- single items in it can, with a warning;
#   * deleting a whole session needs its name typed back, and ingest.py must already
#     honour exclusions (otherwise the next re-scan would quietly bring it back);
#   * a bulk delete is only carried out if the selection still has the counts the
#     administrator confirmed.

CC_INGEST_PY = CC_MEM_ROOT + "/ingest.py"
CC_MINT_STATE = "/var/lib/moni-ai/state.json"
CC_MINT_LEDGER = "/var/lib/moni-ai/ledger.db"
CC_MM_RECENT = 120
CC_MM_ACTIONS = ("hide", "unhide", "delete")
CC_MM_SCOPES = ("items", "filtered", "session")
CC_MM_STATUSES = ("", "active", "hidden", "superseded")
CC_MM_SHOW = ("", "facts", "chunks")
CC_MACHINES = {"vps": "This server", "windows-laptop": "Windows laptop"}


def cc_mm_ready():
    """True once ingest.py skips excluded sessions and tombstoned chunks."""
    try:
        with open(CC_INGEST_PY) as fh:
            src = fh.read()
    except OSError:
        return False
    return "excluded_sessions" in src and "memory_tombstones" in src


def cc_mint_sessions():
    """(current MINT AI session id, {sid: label}) from the supervisor's state file."""
    try:
        with open(CC_MINT_STATE) as fh:
            st = json.load(fh) or {}
    except Exception:
        st = {}
    labels = {}
    for h in st.get("session_history") or []:
        sid = str((h or {}).get("session_id") or "")
        if UUID_RE.match(sid):
            labels[sid] = "MINT AI (retired %s)" % str(h.get("retired_at") or "")[:10]
    cur = str(st.get("session_id") or "")
    cur = cur if UUID_RE.match(cur) else None
    if cur:
        labels[cur] = "MINT AI"
    return cur, labels


def cc_hired_sessions():
    """{sid: {name, status}} for the sessions MINT AI hired (read-only)."""
    out = {}
    if not os.path.isfile(CC_MINT_LEDGER):
        return out
    try:
        import sqlite3
        con = sqlite3.connect("file:" + CC_MINT_LEDGER + "?mode=ro", uri=True, timeout=2)
        try:
            for name, sid, status in con.execute("SELECT name, session_id, status FROM hired_sessions"):
                if UUID_RE.match(str(sid or "")):
                    out[sid] = {"name": str(name or "")[:80], "status": str(status or "")}
        finally:
            con.close()
    except Exception:
        pass
    return out


def cc_transcripts_of(sid):
    """[(home key, path, archived)] of every <sid>.jsonl on this machine: copies in a writable
    home first (they are the session's own), newest first within each."""
    found = []
    for key, home in CC_HOMES.items():
        roots = [(home["projects"], False)]
        if home["base"]:
            roots.append((cc_archive_root(key), True))
        for root, archived in roots:
            if not root or not os.path.isdir(root):
                continue
            for slug in os.listdir(root):
                if not CC_SLUG_RE.match(slug):
                    continue
                p = os.path.join(root, slug, sid + ".jsonl")
                if os.path.isfile(p) and not os.path.islink(p):
                    found.append((key, p, archived))
    found.sort(key=lambda f: (not CC_HOMES[f[0]]["writable"], -os.path.getmtime(f[1])))
    return found


def cc_mm_describe(rows):
    """Name, origin, machine and liveness for each session row from the bridge."""
    mint_cur, mint = cc_mint_sessions()
    hired = cc_hired_sessions()
    live = {}
    for (key, sid), row in cc_live_sessions().items():
        live.setdefault(sid, row)
    now = time.time()
    for r in rows:
        sid = r["session_id"]
        files = cc_transcripts_of(sid)
        r["transcripts"] = len(files)
        r["transcripts_writable"] = len([f for f in files if CC_HOMES[f[0]]["writable"]])
        title = title_src = None
        if files:
            try:
                summ = cc_summary_cached(files[0][1], os.stat(files[0][1]))
                title, title_src = summ.get("title"), summ.get("title_src")
            except OSError:
                pass
        lrow = live.get(sid)
        if sid in mint:
            name, origin = mint[sid], "MINT AI"
        elif sid in hired:
            name = hired[sid]["name"] or ("Hired " + sid[:8])
            origin = "Hired session" + (" (retired)" if hired[sid]["status"] == "retired" else "")
        else:
            name = (lrow or {}).get("name") or (title if title_src == "custom" else None) or r.get("title") \
                or title or None
            origin = CC_HOMES[files[0][0]]["label"] if files else "No transcript left"
            if r.get("machine") == "windows-laptop":
                origin = "Old Windows session"
        if name:
            name = cc_one_line(re.sub(r"</?[A-Za-z][A-Za-z_-]{0,30}>", " ", str(name)), 90)
        r["name"] = name or "Session " + sid[:8]
        r["origin"] = origin
        r["machine_label"] = CC_MACHINES.get(r.get("machine") or "", r.get("machine") or "—")
        why = None
        if sid == mint_cur:
            why = "MINT AI's current session"
        elif lrow:
            why = "a Claude Code process is running it now"
        elif files and now - max(os.path.getmtime(f[1]) for f in files) < CC_MM_RECENT:
            why = "its transcript was written in the last %d seconds" % CC_MM_RECENT
        r["live"] = bool(why)
        r["live_reason"] = why
    return rows


def cc_mm_one(sid):
    data = cc_bridge("mm_sessions", session=sid)
    got = [r for r in data["sessions"] if r["session_id"] == sid]
    if not got:
        raise CCError("nothing from this session is in memory")
    return cc_mm_describe(got)[0], data["caps"]


def cc_mm_sessions(payload):
    data = cc_bridge("mm_sessions")
    rows = cc_mm_describe(data["sessions"])
    rows.sort(key=lambda r: r.get("last") or "", reverse=True)
    return {"sessions": rows, "caps": data["caps"], "ready": cc_mm_ready()}


def cc_mm_filters(payload):
    q = str(payload.get("q") or "").strip()[:200]
    topic = str(payload.get("topic") or "").strip()
    if topic and not CC_TOPIC_RE.match(topic):
        raise CCError("not a topic")
    status = str(payload.get("status") or "")
    show = str(payload.get("show") or "")
    if status not in CC_MM_STATUSES or show not in CC_MM_SHOW:
        raise CCError("unknown filter")
    if "\x00" in q:
        raise CCError("the text filter contains characters that are not allowed")
    return {"q": q, "topic": topic, "status": status, "show": show}


def cc_mm_session(payload):
    sid = cc_uuid(payload.get("session"))
    meta, caps = cc_mm_one(sid)
    per = 50
    page = cc_int(payload.get("page"), 1, 100000, 1)
    f = cc_mm_filters(payload)
    data = cc_bridge("mm_session", session=sid, limit=per, offset=(page - 1) * per, **f)
    data.update({"session": meta, "filters": f, "page": page, "per_page": per, "ready": cc_mm_ready()})
    return data


def cc_mm_request(payload):
    sid = cc_uuid(payload.get("session"))
    action = str(payload.get("action") or "")
    scope = str(payload.get("scope") or "")
    if action not in CC_MM_ACTIONS:
        raise CCError("unknown action")
    if scope not in CC_MM_SCOPES:
        raise CCError("unknown scope")
    req = {"session": sid, "action": action, "scope": scope}
    if scope == "items":
        for k in ("facts", "chunks"):
            v = payload.get(k) or []
            if not isinstance(v, list) or len(v) > 20000:
                raise CCError("bad selection")
            req[k] = [int(x) for x in v if re.match(r"^\d{1,18}$", str(x))]
        if not req["facts"] and not req["chunks"]:
            raise CCError("nothing is selected")
    elif scope == "filtered":
        req.update(cc_mm_filters(payload))
    return req


def cc_mm_preview(payload):
    req = cc_mm_request(payload)
    meta, caps = cc_mm_one(req["session"])
    out = cc_bridge("mm_preview", **req)
    out.update({"session": meta, "request": req})
    return out


def cc_mm_apply(payload):
    actor = cc_actor(payload)
    req = cc_mm_request(payload)
    sid = req["session"]
    meta, caps = cc_mm_one(sid)
    if req["scope"] == "session" and req["action"] != "unhide" and meta["live"]:
        raise CCError("refused: this session is live (%s). Hide or delete single items instead, "
                      "or wait until it has stopped." % meta["live_reason"])
    if req["action"] == "delete":
        exp = payload.get("expect")
        ok_n = lambda v: isinstance(v, int) and not isinstance(v, bool) and 0 <= v <= 10 ** 9
        if not isinstance(exp, dict) or not ok_n(exp.get("facts")) or not ok_n(exp.get("chunks")):
            raise CCError("a delete must carry the counts that were confirmed")
        req["expect"] = {"facts": exp["facts"], "chunks": exp["chunks"]}
    out = cc_bridge("mm_apply", actor=actor, **req)
    audit("cc-memory-" + req["action"], {
        "by": actor, "session": sid, "scope": req["scope"], "facts": out.get("facts", 0),
        "chunks": out.get("chunks", 0), "live": meta["live"]})
    out["live"] = meta["live"]
    return out


def cc_mm_remove_files(sid):
    """Delete the session's transcripts in the writable Claude homes. Read-only copies stay."""
    removed, kept = 0, 0
    for key, path, archived in cc_transcripts_of(sid):
        home = CC_HOMES[key]
        if not home["writable"]:
            kept += 1
            continue
        root = cc_archive_root(key) if archived else home["projects"]
        real = cc_under(path, root)
        base = real[:-len(".jsonl")]
        for p in (real, base + ".desktop-released.json"):
            if os.path.isfile(p) and not os.path.islink(p):
                for cache in (cc_cache_path(p), cc_cache_path(p) + ".sum"):
                    try:
                        os.unlink(cache)
                    except OSError:
                        pass
                os.unlink(p)
                removed += 1
        if os.path.isdir(base) and not os.path.islink(base):
            cc_under(base, root)
            shutil.rmtree(base)
            removed += 1
    return removed, kept


def cc_mm_delete_session(payload):
    actor = cc_actor(payload)
    sid = cc_uuid(payload.get("session"))
    meta, caps = cc_mm_one(sid)
    if meta["live"]:
        raise CCError("refused: this session is live (%s). Stop it first." % meta["live_reason"])
    if str(payload.get("confirm") or "").strip() != meta["name"]:
        raise CCError("type the session's name exactly to delete it")
    if not cc_mm_ready():
        raise CCError("refused: claude-memory's ingest.py does not honour exclusions yet, so the next "
                      "re-scan would index this session again. Install deploy/claude-memory-manage first.")
    files = bool(payload.get("delete_files"))
    out = cc_bridge("mm_delete_session", session=sid, actor=actor, files_deleted=files)
    out["files_removed"], out["files_kept_readonly"] = 0, 0
    if files:
        try:
            out["files_removed"], out["files_kept_readonly"] = cc_mm_remove_files(sid)
        except (OSError, CCError) as exc:
            out["files_error"] = str(exc)[:200]
    audit("cc-memory-delete-session", {
        "by": actor, "session": sid, "facts": out["facts"], "chunks": out["chunks"],
        "ingest_state": out["ingest_state"], "files_removed": out["files_removed"]})
    return out


