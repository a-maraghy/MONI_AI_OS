diff -ru a/schema.sql b/schema.sql
--- a/schema.sql	2026-09-27 10:44:50.021319962 +0200
+++ b/schema.sql	2026-10-04 16:51:57.438081678 +0200
@@ -53,3 +53,25 @@
 CREATE INDEX IF NOT EXISTS facts_content_trgm    ON facts USING gin (content gin_trgm_ops);
 CREATE INDEX IF NOT EXISTS facts_ts              ON facts (ts);
 CREATE INDEX IF NOT EXISTS facts_live            ON facts (id) WHERE superseded_by IS NULL;
+
+-- Memory managed from the dashboard (2026-10). A hidden chunk is kept but never searched,
+-- injected, extracted or shown in memory_session; a hidden fact is a retracted one
+-- (superseded_by = id), so facts need no column. Deleted sessions are excluded from ingest,
+-- and chunks deleted one by one leave a tombstone so ingest never re-creates them.
+ALTER TABLE chunks ADD COLUMN IF NOT EXISTS hidden boolean NOT NULL DEFAULT false;
+CREATE INDEX IF NOT EXISTS chunks_hidden ON chunks (session_id) WHERE hidden;
+
+CREATE TABLE IF NOT EXISTS excluded_sessions (
+    session_id    text PRIMARY KEY,
+    excluded_at   timestamptz NOT NULL DEFAULT now(),
+    excluded_by   text,
+    reason        text,
+    files_deleted boolean NOT NULL DEFAULT false
+);
+
+CREATE TABLE IF NOT EXISTS memory_tombstones (
+    content_hash text PRIMARY KEY,
+    session_id   text,
+    deleted_at   timestamptz NOT NULL DEFAULT now(),
+    deleted_by   text
+);
