  {
    name: "machine_release",
    op: "machine-release",
    description: "Hand the computer back to the user: ends the control lease at once and closes the session there. Do it as soon as the job is done.",
    inputSchema: {
      type: "object",
      properties: {
        machine: { type: "string", description: "The computer's name or id; may be left out when only one is linked." },
