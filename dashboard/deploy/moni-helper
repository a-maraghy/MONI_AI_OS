# ------------------------------------------------------- memory: the graph

CC_GRAPH_SEM = os.path.join(CC_CACHE, "graph-sem.json")
CC_GRAPH_K = 3              # semantic neighbours per fact
CC_GRAPH_MIN_SIM = 0.75     # cosine similarity floor for a "related by meaning" link
CC_GRAPH_MAX_FACTS = 1500
CC_GRAPH_MAX_CHUNKS = 1000


def cc_graph_params(payload):
    """Validate a graph request: two optional cursors and two optional caps."""
    out = {}
    for key in ("after_f", "after_c"):
        v = payload.get(key)
        if v is None or v == "":
            continue
        if isinstance(v, bool) or not re.match(r"^\d{1,15}$", str(v)):
            raise CCError("bad cursor")
        out[key] = int(v)
    out["limit_f"] = cc_int(payload.get("limit_f"), 1, CC_GRAPH_MAX_FACTS, CC_GRAPH_MAX_FACTS)
    out["limit_c"] = cc_int(payload.get("limit_c"), 0, CC_GRAPH_MAX_CHUNKS, CC_GRAPH_MAX_CHUNKS)
    return out


def cc_graph_sem_cache(signature):
    try:
        with open(CC_GRAPH_SEM) as fh:
            got = json.load(fh)
        if got.get("signature") == signature and got.get("k") == CC_GRAPH_K and got.get("min_sim") == CC_GRAPH_MIN_SIM:
            return got.get("edges")
    except Exception:
        pass
    return None


def cc_graph_sem_store(signature, edges):
    try:
        os.makedirs(CC_CACHE, mode=0o700, exist_ok=True)
        tmp = CC_GRAPH_SEM + ".tmp"
        with open(tmp, "w") as fh:
            json.dump({"signature": signature, "k": CC_GRAPH_K, "min_sim": CC_GRAPH_MIN_SIM, "edges": edges}, fh)
        os.chmod(tmp, 0o600)
        os.replace(tmp, CC_GRAPH_SEM)
    except Exception:
        pass


def cc_memory_graph(payload):
    """The memory as a graph: facts, chunks, sessions, and how they link.

    Read-only. A full request's semantic links come from the cache when the
    facts table has not changed since they were computed (count, highest id
    and the sum of supersessions together catch an add, an edit and a
    forget); otherwise they are recomputed with pgvector and cached. An
    incremental request (after_f / after_c) computes them for the new facts
    only, which is a handful of index lookups.
    """
    params = cc_graph_params(payload)
    inc = "after_f" in params or "after_c" in params
    data = cc_bridge("graph", want_sem=inc, k=CC_GRAPH_K, min_sim=CC_GRAPH_MIN_SIM, **params)
    if not inc:
        sig = data.get("signature")
        sem = cc_graph_sem_cache(sig)
        data["sem_cached"] = sem is not None
        if sem is None:
            t0 = time.time()
            sem = cc_bridge("graph", want_sem=True, k=CC_GRAPH_K, min_sim=CC_GRAPH_MIN_SIM,
                            limit_f=params["limit_f"], limit_c=0).get("sem") or []
            data["sem_ms"] = int((time.time() - t0) * 1000)
            cc_graph_sem_store(sig, sem)
        keep = set(data.get("cur_ids") or [])
        data["sem"] = [e for e in sem if e[0] in keep and e[1] in keep]
    data.pop("cur_ids", None)
    data["limits"] = {"facts": params["limit_f"], "chunks": params["limit_c"],
                      "k": CC_GRAPH_K, "min_sim": CC_GRAPH_MIN_SIM}
    return data


def cmd_cc_memory_graph(args):
    cc_ok(cc_run(lambda: cc_memory_graph(cc_read_payload())))


def cc_memfile_path(slug, name):
    slug = cc_slug(slug)
    if not CC_MEMFILE_RE.match(str(name or "")):
        raise CCError("not a memory file name")
    return os.path.join(CC_MEMFILE_ROOT, slug, "memory", name)


def cmd_cc_memfiles_list(args):
    out = []
    root = CC_MEMFILE_ROOT
    for slug in sorted(os.listdir(root)) if os.path.isdir(root) else []:
        mdir = os.path.join(root, slug, "memory")
        if not CC_SLUG_RE.match(slug) or os.path.islink(mdir) or not os.path.isdir(mdir):
            continue
        for name in sorted(os.listdir(mdir)):
            p = os.path.join(mdir, name)
            if not CC_MEMFILE_RE.match(name) or os.path.islink(p) or not os.path.isfile(p):
                continue
            st = os.stat(p)
            out.append({"project": slug, "name": name, "bytes": st.st_size,
                        "modified": datetime.fromtimestamp(st.st_mtime, timezone.utc).isoformat()})
    cc_ok(out)


def cc_memfile_read(slug, name):
    path = cc_plain_file(cc_memfile_path(slug, name), CC_MEMFILE_ROOT)
    if os.path.getsize(path) > MAX_FILE_BYTES:
        raise CCError("file is too large to show here")
    with open(path, encoding="utf-8", errors="replace") as fh:
        raw = fh.read()
    shown = cc_redact(raw)
    st = os.stat(path)
    return {"project": slug, "name": name, "content": shown,
            # An edit made to a redacted copy would write the placeholders back
            # over the real text, so the panel refuses to save one.
            "redacted": shown != raw, "bytes": st.st_size,
            "modified": datetime.fromtimestamp(st.st_mtime, timezone.utc).isoformat()}


def cmd_cc_memfile_read(args):
