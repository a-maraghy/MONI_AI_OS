def ensure_console_state():
    """The console's state root: traversable, not listable.

    0711 rather than 0700. The console account has to walk through this
    directory to reach its own config and attachments, and root-only 0700 meant
    it could not -- the files underneath were correctly owned and simply
    unreachable. Everything below carries its own 0700, so opening the door
    without opening the cupboards is the right trade.
    """
    os.makedirs(CONSOLE_STATE, mode=0o711, exist_ok=True)
    try:
        os.chmod(CONSOLE_STATE, 0o711)
    except OSError:
        pass


def console_config_dir(access):
    """Where Claude Code keeps this console's own settings and session history.

    Deliberately not root's ~/.claude. The console is the panel's, not a
    person's interactive shell: sharing a config directory would mean the
    panel's chats and somebody's SSH session competing over the same session
    index, and it made the first turn fail outright because root's config had
    been left in a half-restored state. A directory we create ourselves is one
    we know the state of.
    """
    path = os.path.join(CONSOLE_STATE, access)
    profile = CONSOLE_ACCESS[access]
    try:
        pw = pwd.getpwnam(profile["user"])
    except KeyError:
        return path

    ensure_console_state()

    for directory in (profile["home"], path):
        os.makedirs(directory, mode=0o700, exist_ok=True)
        try:
            os.chown(directory, pw.pw_uid, pw.pw_gid)
        except OSError:
            pass

    # Repair anything inside that the console cannot write.
    #
    # Claude Code saves conversations under this directory, and it does so
    # silently: a sessions/ folder owned by somebody else does not raise an
    # error, it just means every chat forgets everything between turns. That is
    # a miserable thing to debug from the symptom, so the ownership is checked
    # rather than assumed. One stat per child, and a full pass only when a child
    # is actually wrong.
    try:
        misowned = any(
            os.stat(os.path.join(path, name)).st_uid != pw.pw_uid
            for name in os.listdir(path)
        )
    except OSError:
        misowned = False

    if misowned:
        chown_tree(path, pw.pw_uid, pw.pw_gid, dir_mode=0o700, file_mode=0o600)

    return path


def console_env(access):
    """Environment for a console turn, including the shared Claude credential.

    The credential is read here rather than left to the child's environment
    because the dashboard runs as an unprivileged user that cannot read the
    file, so it could not pass it through even if we wanted it to.
    """
    profile = CONSOLE_ACCESS[access]
    env = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "HOME": profile["home"],
        "TERM": "dumb",
        "LANG": os.environ.get("LANG", "C.UTF-8"),
        "DEBIAN_FRONTEND": "noninteractive",
        "CLAUDE_CONFIG_DIR": console_config_dir(access),
    }
    try:
        with open(CLAUDE_AUTH) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                if key in ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY") and value:
                    env[key] = value
    except OSError:
        pass
    return env


def cmd_console_open(args):
    """Open a long-lived console conversation and relay it.

    The first line of stdin configures the session; everything after it is a
    user message in the CLI's streaming-input format, and everything the CLI
    emits goes straight to stdout. The process stays up between turns, which is
    what makes the conversation a conversation and skips a cold start on every
    message.

    A session that is allowed to exit -- stdin closed, rather than killed --
    writes its transcript to disk, and `resume` picks that conversation back up.
    That is what lets a setting fixed at spawn, like the root switch, be changed
    without the chat forgetting everything: the process restarts, the
    conversation does not.
    """
    first = sys.stdin.readline()
    if not first:
        fail("no session configuration received")
    try:
        payload = json.loads(first)
    except ValueError:
        fail("session configuration was not valid JSON")

    access = str(payload.get("access") or "full")
    if access not in CONSOLE_ACCESS:
        fail("unknown access level")

    model = str(payload.get("model") or "claude-opus-5")
    if model not in CONSOLE_MODELS:
        fail("unknown model")

    effort = str(payload.get("effort") or "medium")
    if effort not in EFFORT_LEVELS:
        fail("unknown effort level")

    permission_mode = str(payload.get("permission_mode") or "auto")
    if permission_mode not in CONSOLE_PERMISSION_MODES:
        fail("unknown permission mode")

    # Root can be switched off for a whole-server chat without changing which
    # account it runs as or what it can see. Only meaningful for "full": the
    # workspace profile has no sudo entitlement to withdraw.
    root_enabled = payload.get("root_enabled")
    root_enabled = True if root_enabled is None else bool(root_enabled)
    if access != "full":
        root_enabled = False

    # Its own pattern rather than ABS_PATH_RE, which requires at least one
    # character after the slash and so rejects the root directory -- which is
    # precisely where a whole-server console starts.
    cwd = str(payload.get("cwd") or "").strip() or CONSOLE_ACCESS[access]["cwd"]
    if not CONSOLE_PATH_RE.match(cwd) or ".." in cwd:
        fail("working directory must be a plain absolute path")
    if not os.path.isdir(cwd):
        fail("no such directory: " + cwd)

    prompt_key = access if (access != "full" or root_enabled) else "full_noroot"

    argv = [
        "claude",
        "-p",
        "--input-format", "stream-json",
        "--output-format", "stream-json",
        "--include-partial-messages",
        "--verbose",
        "--model", model,
        "--effort", effort,
        "--permission-mode", CONSOLE_PERMISSION_MODES[permission_mode],
        "--append-system-prompt", CONSOLE_PROMPT[prompt_key],
    ]

    resume = str(payload.get("resume") or "").strip()
    if resume:
        if not UUID_RE.match(resume):
            fail("malformed session id")
        argv += ["--resume", resume]

    # Root off is enforced by the kernel, not by asking nicely. no_new_privs
    # makes every setuid binary -- sudo included -- unable to gain privilege for
    # this process and everything it spawns, and the flag cannot be unset once
    # it is set. Telling the model in its prompt is a courtesy so it does not
    # waste a turn discovering the wall; this is the wall.
    if access == "full" and not root_enabled:
        argv = ["setpriv", "--no-new-privs"] + argv

    profile = CONSOLE_ACCESS[access]
    try:
        pw = pwd.getpwnam(profile["user"])
    except KeyError:
        fail("account " + profile["user"] + " does not exist; run the deploy script")

    proc = subprocess.Popen(
        argv,
        cwd=cwd,
        env=console_env(access),
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
        preexec_fn=_drop_to(profile["user"], pw.pw_uid, pw.pw_gid),
    )

    # Two pumps: our stdin into Claude's, and Claude's stdout into ours. Both
    # relay bytes without interpreting them -- anything this helper tried to
    # summarise would be a second place for the event format to drift out of
    # date, and it has no reason to know what a turn means.
    def feed():
        try:
            for line in sys.stdin:
                proc.stdin.write(line)
                proc.stdin.flush()
        except (BrokenPipeError, ValueError):
            pass
        finally:
            try:
                proc.stdin.close()
            except Exception:
                pass

    pump = threading.Thread(target=feed, daemon=True)
    pump.start()

    try:
        for line in proc.stdout:
            sys.stdout.write(line)
            sys.stdout.flush()
    except BrokenPipeError:
        proc.kill()
        return

    proc.wait()
    stderr = (proc.stderr.read() or "").strip()
    trailer = {"type": "moni_done", "exit_code": proc.returncode}
    if proc.returncode != 0 and stderr:
        trailer["stderr"] = stderr[-4000:]
    try:
        sys.stdout.write(json.dumps(trailer) + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        pass


def _drop_to(username, uid, gid):
    """Become the console account, keeping the groups it was given.

    initgroups rather than setgroups([gid]): the console is a member of adm and
    systemd-journal so it can read logs without sudo, and setting the group list
    to the primary group alone silently threw that away. The symptom was an
    account that had been granted journal access and still could not read the
    journal.
    """

    def apply():
        os.setgid(gid)
        os.initgroups(username, gid)
        os.setuid(uid)

    return apply


def cmd_console_upload(args):
    """Save a file pasted into the composer where the console can read it.

    Arrives base64 on stdin rather than as a path, because the dashboard runs
    as a different unprivileged user and has nowhere the console could read
    from. The name is reduced to something harmless and made unique -- it ends
    up in a prompt as a path, and a name that could traverse or collide is a
    name worth not having.
    """
    payload = read_stdin_json()

    chat = str(payload.get("chat") or "")
    if not re.match(r"^[0-9]{1,12}$", chat):
        fail("malformed chat id")

    access = str(payload.get("access") or "full")
    if access not in CONSOLE_ACCESS:
        fail("unknown access level")

    raw_name = str(payload.get("name") or "file")
    name = UPLOAD_NAME_RE.sub("_", os.path.basename(raw_name)).strip("._-")[:80]
    if not name:
        name = "file"

    try:
        data = base64.b64decode(str(payload.get("data") or ""), validate=True)
    except Exception:
        fail("attachment was not valid base64")
    if not data:
        fail("attachment is empty")
    if len(data) > MAX_UPLOAD_BYTES:
        fail("attachment is larger than 32 MB")

    profile = CONSOLE_ACCESS[access]
    try:
        pw = pwd.getpwnam(profile["user"])
    except KeyError:
        fail("console account does not exist; run the deploy script")

    ensure_console_state()
    directory = os.path.join(CONSOLE_UPLOADS, chat)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    os.chown(directory, pw.pw_uid, pw.pw_gid)
    os.chown(CONSOLE_UPLOADS, pw.pw_uid, pw.pw_gid)

    stem, ext = os.path.splitext(name)
    path = os.path.join(directory, stem + "-" + uuid.uuid4().hex[:6] + ext)
    with open(path, "wb") as fh:
        fh.write(data)
    os.chown(path, pw.pw_uid, pw.pw_gid)
    os.chmod(path, 0o600)

    ok({"path": path, "name": name, "bytes": len(data)})


def cmd_console_dirs(args):
    """Directories worth offering as a working directory in the console."""
    roots = ["/", "/opt", "/opt/projects", "/srv", "/etc", "/var/log", AGENTS_DIR]
    for slug in all_agent_slugs():
        roots.append(os.path.join(agent_dir(slug), "vault"))
    ok([p for p in roots if os.path.isdir(p)])


