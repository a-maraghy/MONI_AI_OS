def cc_search(payload):
    query = cc_text(payload.get("query"), "Query", 500)
    k = cc_int(payload.get("k"), 1, 50, 12)
    project = str(payload.get("project") or "") or None
    if project and not CC_PROJECT_RE.match(project):
        raise CCError("bad project filter")
    try:
        res = cc_http("/search", {"query": query, "k": k, "project": project}, timeout=30)
    except Exception as exc:
        raise CCError("memory search is unavailable: " + type(exc).__name__)
    hits = []
    for h in res.get("results") or []:
        content = str(h.get("content") or "")
        hits.append({
            "kind": h.get("kind"), "id": h.get("id"), "score": h.get("score"),
            "topic": h.get("topic"), "session_id": h.get("session_id"), "ts": h.get("ts"),
            "project": h.get("project"), "role": h.get("role"), "source": h.get("source"),
            "content": content[:900], "truncated": len(content) > 900,
        })
    return {"results": hits, "timing_ms": res.get("timing_ms")}


