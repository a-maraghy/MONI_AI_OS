# ------------------------------------------------------------------ running

def cc_load_stops():
    try:
        with open(CC_STOP_STATE) as fh:
            d = json.load(fh)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def cc_save_stops(d):
    os.makedirs(CC_CACHE, mode=0o700, exist_ok=True)
    cutoff = time.time() - 86400
    d = {k: v for k, v in d.items() if isinstance(v, dict) and v.get("ts", 0) > cutoff}
    with open(CC_STOP_STATE + ".tmp", "w") as fh:
        json.dump(d, fh)
    os.replace(CC_STOP_STATE + ".tmp", CC_STOP_STATE)


def cc_public_live(row):
    """A sessions/<pid>.json row with only the whitelisted fields."""
    return {k: row.get(k) for k in ("home", "pid", "alive", "claude", "session_id", "cwd", "kind",
                                    "entrypoint", "name", "status", "version", "started_at",
                                    "updated_at", "status_updated_at")}


def cc_transcript_hints(key, uuid):
    """Model and permission mode from the tail of the live transcript."""
    try:
        _, path = cc_find_session(key, uuid)
    except CCError:
        return {}
    tail = cc_read_tail(path, 128 * 1024)
    model = mode = None
    for rec in reversed(tail):
        if not model and rec.get("type") == "assistant":
            model = (rec.get("message") or {}).get("model")
        if not mode:
            if rec.get("type") == "permission-mode":
                mode = rec.get("permissionMode")
            elif rec.get("type") == "user" and rec.get("permissionMode"):
                mode = rec.get("permissionMode")
        if model and mode:
            break
    sdir = path[:-len(".jsonl")]
    return {"model": model, "permission_mode": mode, "project": os.path.basename(os.path.dirname(path)),
            "subagents": [a for a in cc_subagents(sdir) if a["status"] == "running"]}


def cc_running():
    boot = cc_boot_time()
    stops = cc_load_stops()
    sessions, session_pids = [], set()
    for key, home in CC_HOMES.items():
        for row in cc_session_files(key, home):
            session_pids.add(row["pid"])
            pub = cc_public_live(row)
            pub["home_label"] = home["label"]
            proc = row["proc"]
            pub["uptime"] = cc_uptime(proc, boot) if proc else None
            pub["hints"] = cc_transcript_hints(key, row["session_id"]) if row["session_id"] else {}
            stop = stops.get(str(row["pid"]))
            if stop and proc and str(stop.get("start")) == str(proc["start_ticks"]):
                pub["stop_requested"] = stop.get("ts")
                pub["stop_signal"] = stop.get("signal")
                pub["force_available"] = time.time() - stop.get("ts", 0) >= CC_FORCE_AFTER
            else:
                pub["stop_requested"] = None
                pub["force_available"] = False
            sessions.append(pub)

    others, services = [], []
    for pid in cc_all_pids():
        if pid in session_pids:
            continue
        p = cc_proc(pid)
        if not p:
            continue
        if cc_is_claude(p):
            parent = cc_proc(p["ppid"])
            others.append({"pid": pid, "user": p["user"], "cwd": p["cwd"], "binary": "claude",
                           "parent": parent["comm"] if parent else None,
                           "uptime": cc_uptime(p, boot)})
        elif p["comm"].startswith("claude") or (p["comm"] == "uvicorn" and p["user"] == "claude-mem") \
                or (p["user"] in ("moniagent", "moniconsole") and p["ppid"] == 1):
            services.append({"pid": pid, "user": p["user"], "binary": p["comm"],
                             "uptime": cc_uptime(p, boot)})

    cpu = cc_cpu_sample([s["pid"] for s in sessions if s["alive"]]
                        + [o["pid"] for o in others] + [s["pid"] for s in services])
    for group in (sessions, others, services):
        for row in group:
            row["cpu"] = cpu.get(row["pid"])

    # Subagents run inside their parent CLI, so the only outside sign of one at
    # work is its transcript growing without a final answer yet.
    subagents, now = [], time.time()
    for key, home in CC_HOMES.items():
        if not home["base"] or not os.path.isdir(home["projects"]):
            continue
        for slug in os.listdir(home["projects"]):
            pdir = os.path.join(home["projects"], slug)
            if not CC_SLUG_RE.match(slug) or os.path.islink(pdir) or not os.path.isdir(pdir):
                continue
            for sess in os.listdir(pdir):
                adir = os.path.join(pdir, sess, "subagents")
                if not UUID_RE.match(sess) or not os.path.isdir(adir) or os.path.islink(adir):
                    continue
                recent = [n for n in os.listdir(adir) if n.endswith(".jsonl")
                          and now - os.path.getmtime(os.path.join(adir, n)) < CC_RUNNING_WINDOW]
                if not recent:
                    continue
                for a in cc_subagents(os.path.join(pdir, sess)):
                    if a["status"] == "running":
                        a.update({"home": key, "session": sess})
                        subagents.append(a)

    units = []
    r = run(["systemctl", "list-units", "--all", "--plain", "--no-legend", "--no-pager",
             "moni-agent@*", "moni-whatsapp@*", "claude-memory.service", "moni-whisper.service"],
            timeout=10)
    for line in r.stdout.splitlines():
        parts = line.split(None, 4)
        if len(parts) >= 4 and re.match(r"^[A-Za-z0-9@._\-]+$", parts[0]):
            units.append(cc_unit_brief(parts[0]))

    hooks = [h for h in cc_hook_lines(400) if h["event"] in ("SubagentStart", "SubagentStop")][:12]
    return {"ts": now_iso(), "sessions": sessions, "others": others, "services": services,
            "subagents": subagents, "jobs": cc_memory_jobs(), "units": units,
            "subagent_hooks": hooks}


def cmd_cc_running(args):
    cc_ok(cc_run(cc_running))


def cc_stop(payload):
    actor = cc_actor(payload)
    try:
        pid = int(payload.get("pid"))
    except (TypeError, ValueError):
        raise CCError("pid must be an integer")
    force = bool(payload.get("force"))

    def refuse(reason):
        audit("cc-stop-refused", {"by": actor, "pid": pid, "force": force, "reason": reason})
        raise CCError(reason)

    if pid <= 1:
        refuse("refusing to signal that pid")
    row = None
    for key, home in CC_HOMES.items():
        for r in cc_session_files(key, home):
            if r["pid"] == pid:
                row = r
    if row is None:
        refuse("pid %d is not a Claude Code session known to this machine" % pid)
    if not row["alive"]:
        refuse("that session is no longer running")
    if not row["claude"]:
        refuse("pid %d is not a Claude Code CLI process" % pid)
    start = row["proc"]["start_ticks"]
    stops = cc_load_stops()
    if force:
        prev = stops.get(str(pid))
        if not prev or str(prev.get("start")) != str(start):
            refuse("send an ordinary stop first; force is only offered if that does not work")
        if time.time() - prev.get("ts", 0) < CC_FORCE_AFTER:
            refuse("give the ordinary stop %d seconds to work before forcing" % CC_FORCE_AFTER)
        sig, name = signal.SIGTERM, "SIGTERM"
    else:
        sig, name = signal.SIGINT, "SIGINT"
    os.kill(pid, sig)
    stops[str(pid)] = {"ts": time.time(), "start": start, "signal": name}
    cc_save_stops(stops)
    audit("cc-stop", {"by": actor, "pid": pid, "signal": name, "home": row["home"],
                      "session": row["session_id"], "entrypoint": row["entrypoint"]})
    return {"pid": pid, "signal": name}


def cmd_cc_stop(args):
    cc_ok(cc_run(lambda: cc_stop(cc_read_payload())))


