def cc_boot_time():
    try:
        with open("/proc/stat") as fh:
            for line in fh:
                if line.startswith("btime "):
                    return int(line.split()[1])
    except OSError:
        pass
    return int(time.time())


def cc_proc(pid):
    """What the panel may know about a process: never its environment, and
    never its command line (both can hold tokens)."""
    base = "/proc/%d" % pid
    try:
        with open(base + "/stat") as fh:
            raw = fh.read()
    except OSError:
        return None
    # comm may contain spaces and parentheses; the fields after it are fixed.
    rparen = raw.rfind(")")
    comm = raw[raw.find("(") + 1:rparen]
    fields = raw[rparen + 2:].split()
    try:
        st = os.stat(base)
        user = pwd.getpwuid(st.st_uid).pw_name
    except (OSError, KeyError):
        user = "?"
    try:
        exe = os.readlink(base + "/exe")
    except OSError:
        exe = ""
    try:
        cwd = os.readlink(base + "/cwd")
    except OSError:
        cwd = None
    return {
        "pid": pid, "comm": comm, "state": fields[0], "ppid": int(fields[1]),
        "cpu_ticks": int(fields[11]) + int(fields[12]), "start_ticks": int(fields[19]),
        "user": user, "exe": exe.replace(" (deleted)", ""), "cwd": cwd,
    }


def cc_argv(pid):
    """argv for classification only -- callers must never return it."""
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as fh:
            return [a.decode("utf-8", "replace") for a in fh.read().split(b"\0") if a]
    except OSError:
        return []


def cc_is_claude(proc):
    if not proc:
        return False
    exe = proc["exe"]
    if any(r.match(exe) for r in CC_CLAUDE_EXE_RES):
        return True
    if os.path.basename(exe) in ("node", "bun", "nodejs"):
        argv = cc_argv(proc["pid"])
        return len(argv) > 1 and bool(CC_CLAUDE_SCRIPT_RE.search(argv[1]))
    return False


def cc_all_pids():
    return [int(n) for n in os.listdir("/proc") if n.isdigit()]


def cc_cpu_sample(pids, interval=0.3):
    """CPU percent per pid over a short window."""
    first = {}
    for pid in pids:
        p = cc_proc(pid)
        if p:
            first[pid] = p["cpu_ticks"]
    if not first:
        return {}
    time.sleep(interval)
    out = {}
    for pid, t0 in first.items():
        p = cc_proc(pid)
        if p:
            out[pid] = round((p["cpu_ticks"] - t0) / CC_CLK / interval * 100, 1)
    return out


def cc_uptime(proc, boot):
    return max(0, int(time.time() - (boot + proc["start_ticks"] / CC_CLK)))


def cc_memory_jobs():
    boot = cc_boot_time()
    jobs = []
    for pid in cc_all_pids():
        p = cc_proc(pid)
        if not p or not os.path.basename(p["exe"]).startswith("python"):
            continue
        argv = cc_argv(pid)
        script = None
        for a in argv[1:3]:
            if os.path.basename(a) in CC_JOB_SCRIPTS:
                script = os.path.basename(a)
                break
        if not script:
            continue
        jobs.append({"pid": pid, "script": script, "user": p["user"],
                     "flags": [a for a in argv[2:] if a in CC_JOB_FLAGS],
                     "uptime": cc_uptime(p, boot)})
    units = [cc_unit_brief(u) for u in ("cm-ingest", "cm-ingest-docs", "cm-facts-backfill")]
    return {"processes": jobs, "units": [u for u in units if u["load"] == "loaded"]}


# --------------------------------------------------------- transcripts: files

def cc_find_session(key, uuid, archived=False):
    """(slug, path) of <uuid>.jsonl in a home, searching every project folder."""
    home = cc_home(key)
    root = cc_archive_root(key) if archived else home["projects"]
    if not root or not os.path.isdir(root):
        raise CCError("no such session")
    found = []
    for slug in os.listdir(root):
        if not CC_SLUG_RE.match(slug):
            continue
        p = os.path.join(root, slug, uuid + ".jsonl")
        if os.path.isfile(p) and not os.path.islink(p):
            found.append((slug, cc_under(p, root)))
    if not found:
        raise CCError("no such session")
    found.sort(key=lambda f: os.path.getmtime(f[1]), reverse=True)
    return found[0]


def cc_archive_root(key):
    base = cc_home(key)["base"]
    return os.path.join(base, CC_ARCHIVE_SUBDIR) if base else None


def cc_iter_sessions(key, archived=False):
    home = cc_home(key)
    root = cc_archive_root(key) if archived else home["projects"]
    if not root or not os.path.isdir(root):
        return
    for slug in sorted(os.listdir(root)):
        pdir = os.path.join(root, slug)
        if not CC_SLUG_RE.match(slug) or os.path.islink(pdir) or not os.path.isdir(pdir):
            continue
        for name in os.listdir(pdir):
            m = CC_JSONL_RE.match(name)
            p = os.path.join(pdir, name)
            if m and os.path.isfile(p) and not os.path.islink(p):
                yield slug, m.group(1), p


def cc_parse_lines(blob, drop_first=False):
    lines = blob.split(b"\n")
    if drop_first:
        lines = lines[1:]
    out = []
    for ln in lines:
        if not ln.strip():
            continue
        try:
            rec = json.loads(ln)
        except Exception:
            continue
        if isinstance(rec, dict):
            out.append(rec)
    return out


def cc_read_head(path, limit):
    with open(path, "rb") as fh:
        blob = fh.read(limit)
    if len(blob) == limit and b"\n" in blob:
        blob = blob[:blob.rfind(b"\n")]
    return cc_parse_lines(blob)


def cc_read_tail(path, limit):
    with open(path, "rb") as fh:
        fh.seek(0, os.SEEK_END)
        size = fh.tell()
        start = max(0, size - limit)
        fh.seek(start)
        blob = fh.read()
    return cc_parse_lines(blob, drop_first=start > 0)


def cc_strip_reminders(text):
    return re.sub(r"<system-reminder>.*?</system-reminder>", "", text, flags=re.S).strip()


def cc_user_text(rec):
    """The human-visible text of a user record, or None if it is a tool result."""
    msg = rec.get("message") or {}
    content = msg.get("content")
    if isinstance(content, str):
        return cc_strip_reminders(content)
    if not isinstance(content, list):
        return None
    parts, images = [], 0
    for block in content:
        if not isinstance(block, dict):
            continue
        t = block.get("type")
        if t == "tool_result":
            return None
        if t == "text":
            parts.append(str(block.get("text") or ""))
        elif t in ("image", "document"):
            images += 1
    text = cc_strip_reminders("\n".join(parts))
    if images:
        text = (text + "\n" if text else "") + "[%d attachment%s]" % (images, "" if images == 1 else "s")
    return text


def cc_prompt_kind(rec):
    """'prompt' | 'summary' | 'notification' if this record opens an exchange."""
    if rec.get("type") != "user" or rec.get("isMeta"):
        return None
    if cc_user_text(rec) is None:
        return None
    if rec.get("isCompactSummary"):
        return "summary"
    origin = rec.get("origin") or {}
    if isinstance(origin, dict) and origin.get("kind") not in (None, "human"):
        return "notification"
    return "prompt"


def cc_one_line(text, n):
    text = re.sub(r"\s+", " ", str(text or "")).strip()
    return text if len(text) <= n else text[: n - 1] + "…"


def cc_title_of(head, tail, sdir):
    """Claude Code's own title order: the newest custom-title record, then the
    custom-title.json sidecar, then the first thing the human typed."""
    for rec in reversed(tail):
        if rec.get("type") == "custom-title" and rec.get("customTitle"):
            return str(rec["customTitle"]), "custom"
    side = os.path.join(sdir, "custom-title.json")
    if os.path.isfile(side) and not os.path.islink(side):
        try:
            with open(side) as fh:
                t = (json.load(fh) or {}).get("customTitle")
            if t:
                return str(t), "custom"
        except Exception:
            pass
    for rec in head:
        if rec.get("type") == "custom-title" and rec.get("customTitle"):
            return str(rec["customTitle"]), "custom"
    first = cc_first_prompt(head)
    if first:
        return cc_one_line(first, 90), "first-message"
    return None, None


def cc_first_prompt(records):
    for rec in records:
        if cc_prompt_kind(rec) == "prompt":
            text = cc_user_text(rec)
            if text:
                return text
    return None


# ---- the exchange index: byte offsets of every record that opens an exchange,
# cached per file and extended incrementally as a live transcript grows, so a
# 55 MB session is scanned once rather than on every page view.

def cc_cache_path(path):
    return os.path.join(CC_CACHE, "idx", hashlib.sha1(path.encode()).hexdigest() + ".json")


def cc_index(path):
    st = os.stat(path)
    cpath = cc_cache_path(path)
    entry = None
    try:
        with open(cpath) as fh:
            entry = json.load(fh)
    except Exception:
        entry = None
    if entry and entry.get("ino") == st.st_ino and entry.get("size") == st.st_size \
            and entry.get("mtime") == st.st_mtime_ns:
        return entry
    if not entry or entry.get("ino") != st.st_ino or st.st_size < entry.get("scanned", 0):
        entry = {"ino": st.st_ino, "scanned": 0, "starts": [], "turns": 0, "records": 0}
    with open(path, "rb") as fh:
        fh.seek(entry["scanned"])
        pos = entry["scanned"]
        for line in fh:
            if not line.endswith(b"\n"):
                break  # a record still being written; pick it up next time
            here = pos
            pos += len(line)
            entry["records"] += 1
            if b'"type":"user"' not in line or b'"type":"tool_result"' in line:
                continue
            try:
                rec = json.loads(line)
            except Exception:
                continue
            kind = cc_prompt_kind(rec) if isinstance(rec, dict) else None
            if kind:
                entry["starts"].append([here, kind[0]])
                if kind == "prompt":
                    entry["turns"] += 1
        entry["scanned"] = pos
    entry.update({"size": st.st_size, "mtime": st.st_mtime_ns})
    try:
        os.makedirs(os.path.dirname(cpath), mode=0o700, exist_ok=True)
        tmp = cpath + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(entry, fh)
        os.replace(tmp, cpath)
    except OSError:
        pass
    return entry


def cc_subagent_status(path, mtime):
    """done | running | stopped, from the last assistant record's stop reason."""
    tail = cc_read_tail(path, 128 * 1024)
    for rec in reversed(tail):
        if rec.get("type") == "assistant":
            stop = (rec.get("message") or {}).get("stop_reason")
            if stop == "end_turn":
                return "done"
            break
    return "running" if time.time() - mtime < CC_RUNNING_WINDOW else "stopped"


def cc_subagents(sdir):
    adir = os.path.join(sdir, "subagents")
    if not os.path.isdir(adir) or os.path.islink(adir):
        return []
    out = []
    for name in sorted(os.listdir(adir)):
        m = re.match(r"^agent-([A-Za-z0-9_\-]{1,64})\.jsonl$", name)
        p = os.path.join(adir, name)
        if not m or os.path.islink(p) or not os.path.isfile(p):
            continue
        meta = {}
        mp = os.path.join(adir, "agent-" + m.group(1) + ".meta.json")
        if os.path.isfile(mp) and not os.path.islink(mp):
            try:
                with open(mp) as fh:
                    meta = json.load(fh) or {}
            except Exception:
                meta = {}
        st = os.stat(p)
        out.append({
            "id": m.group(1), "type": meta.get("agentType"), "description": meta.get("description"),
            "depth": meta.get("spawnDepth"), "background": meta.get("requestShape") == "background",
            "bytes": st.st_size, "modified": datetime.fromtimestamp(st.st_mtime, timezone.utc).isoformat(),
            "status": cc_subagent_status(p, st.st_mtime),
        })
    out.sort(key=lambda a: a["modified"])
    return out


def cc_summary_cached(path, st):
    """Title, cwd and timestamps, cached against size+mtime."""
    cpath = cc_cache_path(path) + ".sum"
    try:
        with open(cpath) as fh:
            s = json.load(fh)
        if s.get("size") == st.st_size and s.get("mtime") == st.st_mtime_ns:
            return s
    except Exception:
        pass
    head = cc_read_head(path, 256 * 1024)
    if not cc_first_prompt(head) and st.st_size > 256 * 1024:
        head = cc_read_head(path, 2 * 1024 * 1024)
    tail = cc_read_tail(path, 256 * 1024)
    sdir = path[:-len(".jsonl")]
    title, title_src = cc_title_of(head, tail, sdir)
    first = cc_first_prompt(head)
    cwd = next((r.get("cwd") for r in reversed(tail) if r.get("cwd")), None) \
        or next((r.get("cwd") for r in head if r.get("cwd")), None)
    started = next((r.get("timestamp") for r in head if r.get("timestamp")), None)
    last = next((r.get("timestamp") for r in reversed(tail) if r.get("timestamp")), None)
    model = next(((r.get("message") or {}).get("model") for r in reversed(tail)
                  if r.get("type") == "assistant" and (r.get("message") or {}).get("model")), None)
    entry = next((r.get("entrypoint") for r in reversed(tail) if r.get("entrypoint")), None)
    s = {"size": st.st_size, "mtime": st.st_mtime_ns, "title": title, "title_src": title_src,
         "first": cc_one_line(first, 200) if first else None, "cwd": cwd, "started": started,
         "last": last, "model": model, "entrypoint": entry}
    try:
        os.makedirs(os.path.dirname(cpath), mode=0o700, exist_ok=True)
        with open(cpath + ".tmp", "w") as fh:
            json.dump(s, fh)
        os.replace(cpath + ".tmp", cpath)
    except OSError:
        pass
    return s


def cc_live_sessions():
    """{(home, sessionId): row} for every sessions/<pid>.json whose pid is alive."""
    out = {}
    for key, home in CC_HOMES.items():
        for row in cc_session_files(key, home):
            if row["alive"]:
                out[(key, row["session_id"])] = row
    return out


def cc_session_files(key, home):
    base = home["base"]
    sdir = os.path.join(base, "sessions") if base else None
    if not sdir or not os.path.isdir(sdir):
        return []
    rows = []
    for name in sorted(os.listdir(sdir)):
        m = CC_SESSION_FILE_RE.match(name)  # never the .key siblings
        p = os.path.join(sdir, name)
        if not m or os.path.islink(p) or not os.path.isfile(p) or os.path.getsize(p) > 65536:
            continue
        try:
            with open(p) as fh:
                d = json.load(fh)
        except Exception:
            continue
        pid = int(m.group(1))
        if not isinstance(d, dict) or str(d.get("pid")) != str(pid):
            continue
        proc = cc_proc(pid)
        proc_start = d.get("procStart")
        alive = bool(proc) and (proc_start is None or str(proc["start_ticks"]) == str(proc_start))
        rows.append({
            "home": key, "pid": pid, "alive": alive, "claude": alive and cc_is_claude(proc),
            "session_id": d.get("sessionId") if UUID_RE.match(str(d.get("sessionId") or "")) else None,
            "cwd": d.get("cwd"), "kind": d.get("kind"), "entrypoint": d.get("entrypoint"),
            "name": d.get("name"), "status": d.get("status"), "version": d.get("version"),
            "started_at": d.get("startedAt"), "updated_at": d.get("updatedAt"),
            "status_updated_at": d.get("statusUpdatedAt"), "proc": proc if alive else None,
            "proc_start": proc_start,
        })
    return rows


def cc_sessions_list(payload):
    want_home = str(payload.get("home") or "")
    if want_home:
        cc_home(want_home)
    project = str(payload.get("project") or "")[:255]
    q = str(payload.get("q") or "").strip().lower()[:200]
    archived = bool(payload.get("archived"))
    per = cc_int(payload.get("per_page"), 5, 200, 25)
    page = cc_int(payload.get("page"), 1, 100000, 1)

    live = cc_live_sessions()
    try:
        index = cc_bridge("index_info")
        indexed_paths = set(index["paths"])
        chunk_counts = index["sessions"]
    except CCError:
        indexed_paths, chunk_counts = None, {}

    rows, facets = [], {}
    for key, home in CC_HOMES.items():
        if want_home and key != want_home:
            continue
        if archived and not home["base"]:
            continue
        for slug, uuid, path in cc_iter_sessions(key, archived):
            facets[slug] = facets.get(slug, 0) + 1
            if project and slug != project:
                continue
            st = os.stat(path)
            s = cc_summary_cached(path, st)
            if q and q not in " ".join(str(s.get(k) or "") for k in ("title", "first", "cwd")).lower() \
                    and q not in uuid:
                continue
            sdir = path[:-len(".jsonl")]
            adir = os.path.join(sdir, "subagents")
            n_sub = len([n for n in os.listdir(adir) if n.endswith(".jsonl")]) \
                if os.path.isdir(adir) and not os.path.islink(adir) else 0
            rows.append({
                "home": key, "home_label": home["label"], "project": slug, "uuid": uuid,
                "title": s["title"], "title_src": s["title_src"], "first": s["first"],
                "cwd": s["cwd"], "started": s["started"], "last": s["last"],
                "modified": datetime.fromtimestamp(st.st_mtime, timezone.utc).isoformat(),
                "mtime": st.st_mtime, "bytes": st.st_size, "subagents": n_sub,
                "running": (key, uuid) in live,
                "released": os.path.exists(sdir + ".desktop-released.json"),
                "indexed": None if indexed_paths is None else path in indexed_paths,
                "chunks": chunk_counts.get(uuid, 0),
                "writable": home["writable"] and not archived, "archived": archived,
            })
    rows.sort(key=lambda r: r["mtime"], reverse=True)
    total = len(rows)
    page_rows = rows[(page - 1) * per: page * per]
    # Turn counts need a scan of the whole file (cached), so only the rows on
    # this page pay for it.
    for r in page_rows:
        try:
            path = cc_find_session(r["home"], r["uuid"], archived)[1]
            r["turns"] = cc_index(path)["turns"]
        except (CCError, OSError):
            r["turns"] = None
    return {
        "rows": page_rows, "total": total, "page": page, "per_page": per,
        "homes": [{"key": k, "label": h["label"], "writable": h["writable"]}
                  for k, h in CC_HOMES.items()],
        "projects": sorted(facets.items()), "index_available": indexed_paths is not None,
    }


def cmd_cc_sessions_list(args):
    cc_ok(cc_run(lambda: cc_sessions_list(cc_read_payload())))


# ---- reading one transcript as exchanges

def cc_tool_arg(name, inp):
    if not isinstance(inp, dict):
        return ""
    name = str(name or "")
    if name in ("Agent", "Task"):
        return "%s: %s" % (inp.get("subagent_type") or "agent", inp.get("description") or "")
    if name == "Grep":
        return "%s in %s" % (inp.get("pattern") or "", inp.get("path") or inp.get("glob") or ".")
    if name == "TodoWrite":
        todos = inp.get("todos")
        return "%d items" % len(todos) if isinstance(todos, list) else ""
    for k in ("file_path", "notebook_path", "command", "pattern", "url", "query", "path",
              "description", "skill", "prompt", "subject", "action"):
        v = inp.get(k)
        if isinstance(v, str) and v.strip():
            return v
    for v in inp.values():
        if isinstance(v, str) and v.strip():
            return v
    return ""


def cc_result_size(block):
    content = block.get("content")
    if isinstance(content, str):
        return len(content.encode("utf-8", "replace"))
    try:
        return len(json.dumps(content))
    except Exception:
        return 0


def cc_cap(text, cap):
    if len(text) <= cap:
        return text, False
    return text[:cap], True


def cc_build_exchanges(records):
    """Group records into exchanges: a prompt, then what the assistant said and
    did, with every tool call folded to one line and its output reduced to a
    size. Nothing large is ever copied through."""
    exchanges, cur, tools = [], None, {}

    def new(kind, rec, text):
        ex = {"kind": kind, "ts": rec.get("timestamp") if rec else None, "user": "",
              "user_truncated": False, "items": [], "model": None, "thinking": 0}
        if text is not None:
            ex["user"], ex["user_truncated"] = cc_cap(text, CC_USER_TEXT_CAP)
        exchanges.append(ex)
        return ex

    said = 0
    for rec in records:
        t = rec.get("type")
        kind = cc_prompt_kind(rec)
        if kind:
            cur, tools, said = new(kind, rec, cc_user_text(rec)), {}, 0
            continue
        if t == "assistant":
            if cur is None:
                cur, tools, said = new("preamble", rec, None), {}, 0
            msg = rec.get("message") or {}
            cur["model"] = msg.get("model") or cur["model"]
            for block in msg.get("content") or []:
                if not isinstance(block, dict):
                    continue
                bt = block.get("type")
                if bt == "text":
                    text = str(block.get("text") or "")
                    room = CC_ASSISTANT_TEXT_CAP - said
                    if room <= 0:
                        continue
                    text, cut = cc_cap(text, room)
                    said += len(text)
                    if cur["items"] and cur["items"][-1]["t"] == "text":
                        cur["items"][-1]["text"] += "\n\n" + text
                        cur["items"][-1]["truncated"] = cut
                    else:
                        cur["items"].append({"t": "text", "text": text, "truncated": cut})
                elif bt == "thinking":
                    cur["thinking"] += 1
                elif bt == "tool_use":
                    item = {"t": "tool", "name": str(block.get("name") or "?"),
                            "arg": cc_one_line(cc_tool_arg(block.get("name"), block.get("input")), 200),
                            "size": None, "error": False}
                    tools[block.get("id")] = item
                    cur["items"].append(item)
        elif t == "user" and cur is not None:
            content = (rec.get("message") or {}).get("content")
            if isinstance(content, list):
                for block in content:
                    if isinstance(block, dict) and block.get("type") == "tool_result":
                        item = tools.get(block.get("tool_use_id"))
                        if item is not None:
                            item["size"] = cc_result_size(block)
                            item["error"] = bool(block.get("is_error"))
        elif t == "system" and cur is not None:
            sub = rec.get("subtype")
            if sub == "compact_boundary":
                cur["items"].append({"t": "note", "text": "Conversation compacted"})
            elif rec.get("level") == "error":
                cur["items"].append({"t": "note", "text": cc_one_line(rec.get("content") or sub, 300)})
    return exchanges


def cc_read_range(path, start, end):
    records = []
    with open(path, "rb") as fh:
        fh.seek(start)
        pos = start
        for line in fh:
            if end is not None and pos >= end:
                break
            pos += len(line)
            if not line.endswith(b"\n"):
                break
            try:
                rec = json.loads(line)
            except Exception:
                continue
            if isinstance(rec, dict):
                records.append(rec)
    return records


def cc_session_get(key, uuid, payload):
    home = cc_home(key)
    uuid = cc_uuid(uuid)
    archived = bool(payload.get("archived"))
    slug, path = cc_find_session(key, uuid, archived)
    root = cc_archive_root(key) if archived else home["projects"]
    sdir = path[:-len(".jsonl")]
    agent = str(payload.get("agent") or "")
    target, agent_meta = path, None
    subagents = cc_subagents(sdir)
    if agent:
        if not CC_AGENT_ID_RE.match(agent):
            raise CCError("bad subagent id")
        target = cc_plain_file(os.path.join(sdir, "subagents", "agent-" + agent + ".jsonl"), root)
        agent_meta = next((a for a in subagents if a["id"] == agent), None)
    st = os.stat(path)
    summary = cc_summary_cached(path, st)
    idx = cc_index(target)
    starts = [s[0] for s in idx["starts"]] or [0]
    per = cc_int(payload.get("per_page"), 5, 100, 40)
    pages = max(1, -(-len(starts) // per))
    page = cc_int(payload.get("page"), 1, pages, pages)
    lo = 0 if page == 1 else starts[(page - 1) * per]
    hi = starts[page * per] if page * per < len(starts) else None
    exchanges = cc_build_exchanges(cc_read_range(target, lo, hi))
    live = cc_live_sessions().get((key, uuid))
    cwd = summary.get("cwd")
    resume = None
    if key == "root" and not archived and isinstance(cwd, str) and cwd.startswith("/"):
        resume = "cd %s && claude --resume %s" % (shlex.quote(cwd), uuid)
    return {
        "home": key, "home_label": home["label"], "project": slug, "uuid": uuid,
        "archived": archived, "writable": home["writable"] and not archived,
        "title": summary["title"], "title_src": summary["title_src"], "first": summary["first"],
