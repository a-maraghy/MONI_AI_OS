        fail("usage: cc-memfile-read <project-slug> <name.md>")
    cc_ok(cc_run(cc_memfile_read, args[0], args[1]))


def cc_start_ingest(unit, argv, collect):
    """Start an ingest run as its own transient unit, so it outlives this call
    and is not killed with the dashboard's cgroup on a panel restart."""
    state = cc_systemd(unit, ["ActiveState"]).get("ActiveState", "")
    if state in ("active", "activating"):
        return {"started": False, "unit": unit, "reason": "already running"}
    run(["systemctl", "reset-failed", unit], timeout=10)
    cmd = ["systemd-run", "--unit=" + unit, "--description=claude-memory " + " ".join(argv),
           "--nice=10", "-p", "StandardOutput=append:" + CC_INGEST_LOG,
           "-p", "StandardError=append:" + CC_INGEST_LOG, "--setenv=HOME=/root",
           "--working-directory=" + CC_MEM_ROOT]
    if collect:
        cmd.append("--collect")
    cmd += [CC_VENV_PY, os.path.join(CC_MEM_ROOT, "ingest.py")] + argv
    r = run(cmd, timeout=20)
    if r.returncode != 0:
        raise CCError((r.stderr.strip() or "systemd-run failed")[:300])
    return {"started": True, "unit": unit}


def cc_memfile_write(slug, name, payload):
    actor = cc_actor(payload)
    content = payload.get("content")
    if not isinstance(content, str):
        raise CCError("content is required")
    content = content.replace("\r\n", "\n")
    if len(content.encode("utf-8")) > MAX_FILE_BYTES or "\x00" in content:
        raise CCError("content is too large or contains NUL bytes")
    path = cc_plain_file(cc_memfile_path(slug, name), CC_MEMFILE_ROOT)
    st = os.stat(path)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".moni-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(content)
        os.chmod(tmp, st.st_mode & 0o7777)
        os.chown(tmp, st.st_uid, st.st_gid)
        os.replace(tmp, path)
    except Exception:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    ingest = {"started": False}
    try:
        ingest = cc_start_ingest("cm-ingest-docs", ["--docs"], collect=True)
    except CCError as exc:
        ingest = {"started": False, "reason": str(exc)}
    audit("cc-memfile-write", {"by": actor, "project": slug, "file": name,
                               "bytes": len(content.encode("utf-8"))})
    return {"saved": True, "ingest": ingest}


def cmd_cc_memfile_write(args):
    if len(args) != 2:
        fail("usage: cc-memfile-write <project-slug> <name.md>  (JSON on stdin)")
    cc_ok(cc_run(lambda: cc_memfile_write(args[0], args[1], cc_read_payload())))


