        "unit": unit, "load": p.get("LoadState"), "active": p.get("ActiveState"),
        "sub": p.get("SubState"), "result": p.get("Result"),
        "pid": int(p["MainPID"]) if p.get("MainPID", "0").isdigit() else 0,
        "started": p.get("ExecMainStartTimestamp") or None,
        "exited": p.get("ExecMainExitTimestamp") or None,
        "since": p.get("ActiveEnterTimestamp") or None,
        "memory": int(mem) if mem.isdigit() else None,
    }


