# ---- rename / archive / restore

def cc_refuse_if_busy(key, uuid, path):
    if (key, uuid) in cc_live_sessions():
        raise CCError("this session is running -- stop it or wait for it to end first")
    if time.time() - os.path.getmtime(path) < CC_BUSY_WINDOW:
        raise CCError("this session was written to in the last %d seconds; try again shortly"
                      % CC_BUSY_WINDOW)


def cc_writable_home(key):
    home = cc_home(key)
    if not home["writable"] or not home["base"]:
        raise CCError(home["label"] + " is read-only")
    return home


def cc_session_rename(key, uuid, payload):
    cc_writable_home(key)
    uuid = cc_uuid(uuid)
    actor = cc_actor(payload)
    title = cc_text(payload.get("title"), "Title", 120, single_line=True)
    slug, path = cc_find_session(key, uuid)
    cc_refuse_if_busy(key, uuid, path)
    st = os.stat(path)
    sdir = path[:-len(".jsonl")]
    side = os.path.join(sdir, "custom-title.json")
    if os.path.islink(sdir) or os.path.islink(side):
        raise CCError("refusing to follow a symlink")
    # How Claude Code itself renames: it appends a custom-title record (and an
    # agent-name record alongside it) to the transcript, and mirrors the title
    # into <uuid>/custom-title.json. The newest record wins when it reads back.
    records = [{"type": "custom-title", "customTitle": title, "sessionId": uuid},
               {"type": "agent-name", "agentName": title, "sessionId": uuid}]
    with open(path, "rb+") as fh:
        fh.seek(0, os.SEEK_END)
        lead = b""
        if fh.tell() > 0:
            fh.seek(-1, os.SEEK_END)
            if fh.read(1) != b"\n":
                lead = b"\n"
        fh.seek(0, os.SEEK_END)
        fh.write(lead + b"".join(json.dumps(r, ensure_ascii=False, separators=(",", ":")).encode()
                                 + b"\n" for r in records))
    if not os.path.isdir(sdir):
        os.mkdir(sdir, 0o700)
        os.chown(sdir, st.st_uid, st.st_gid)
    tmp = side + ".moni-tmp"
    with open(tmp, "w") as fh:
        json.dump({"customTitle": title}, fh)
    os.chown(tmp, st.st_uid, st.st_gid)
    os.chmod(tmp, 0o644)
    os.replace(tmp, side)
    audit("cc-session-rename", {"by": actor, "home": key, "session": uuid, "project": slug})
    return {"renamed": True, "title": title}


def cc_session_move(key, uuid, payload, restore):
    home = cc_writable_home(key)
    uuid = cc_uuid(uuid)
    actor = cc_actor(payload)
    archive_root = cc_archive_root(key)
    src_root, dst_root = (archive_root, home["projects"]) if restore else (home["projects"], archive_root)
    slug, path = cc_find_session(key, uuid, archived=restore)
    if not restore:
        cc_refuse_if_busy(key, uuid, path)
    owner = os.stat(home["base"])
    dst_dir = os.path.join(dst_root, slug)
    # The archive lives inside the same .claude directory, so a move is a
    # rename on one filesystem: atomic, and nothing is ever copied or deleted.
    needed = [dst_dir] if restore else [os.path.dirname(archive_root), archive_root, dst_dir]
    for d in needed:
        if os.path.islink(d):
            raise CCError("refusing to follow a symlink")
        if not os.path.isdir(d):
            os.mkdir(d, 0o700)
            os.chown(d, owner.st_uid, owner.st_gid)
    cc_under(dst_dir, dst_root)
    stem_src = os.path.join(src_root, slug, uuid)
    stem_dst = os.path.join(dst_dir, uuid)
    moves = [(stem_src + ".jsonl", stem_dst + ".jsonl")]
    if os.path.isdir(stem_src) and not os.path.islink(stem_src):
        moves.append((stem_src, stem_dst))
    if os.path.isfile(stem_src + ".desktop-released.json"):
        moves.append((stem_src + ".desktop-released.json", stem_dst + ".desktop-released.json"))
    for _, dst in moves:
        if os.path.lexists(dst):
            raise CCError("something already exists at the destination; nothing was moved")
    done = []
    try:
        for src, dst in moves:
            cc_under(src, src_root)
            os.rename(src, dst)
            done.append((src, dst))
    except OSError as exc:
        for src, dst in reversed(done):
            os.rename(dst, src)
        raise CCError("move failed, nothing changed: " + str(exc))
    audit("cc-session-restore" if restore else "cc-session-archive",
          {"by": actor, "home": key, "session": uuid, "project": slug, "moved": len(done)})
    return {"moved": len(done), "project": slug, "restored": restore}


