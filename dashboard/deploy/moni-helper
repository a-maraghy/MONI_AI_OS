# ========================================================= system services ===


def check_unit(unit):
    if unit not in MANAGED_UNITS:
        fail("service not managed by this panel: " + repr(unit))
    return unit


SHOW_PROPS = ("Id", "LoadState", "ActiveState", "UnitFileState", "ActiveEnterTimestamp", "MemoryCurrent")


def parse_show(text):
    """`systemctl show u1 u2 -p ...` output: one KEY=VALUE block per unit, in order."""
    blocks, cur = [], {}
    for line in text.splitlines():
        if not line.strip():
            if cur:
                blocks.append(cur)
                cur = {}
            continue
        k, _, v = line.partition("=")
        cur[k] = v
    if cur:
        blocks.append(cur)
    return blocks


def service_states(units, kinds=None):
    """The state of several units in one systemctl call rather than four each.

    The overview asks for every tracked unit on every render, and four
    subprocesses per unit made that the slowest thing on the page.
    """
    units = list(units)
    if not units:
        return []
    r = run(["systemctl", "show", "-p", ",".join(SHOW_PROPS), "--"] + [u + ".service" for u in units], timeout=20)
    blocks = parse_show(r.stdout)
    by_id = {b.get("Id", ""): b for b in blocks}
    out = []
    for i, unit in enumerate(units):
        b = by_id.get(unit + ".service") or (blocks[i] if i < len(blocks) else {})
        active = b.get("ActiveState") or "unknown"
        if b.get("LoadState") == "not-found":
            active = "inactive"
        enabled = b.get("UnitFileState") or "unknown"
        if enabled == "enabled-runtime":
            enabled = "enabled"
        # Socket-activated units look alarming otherwise: on Ubuntu 24.04
        # ssh.service is 'disabled' while ssh.socket is enabled, and SSH comes
        # back on boot perfectly well. Reporting the raw service state would
        # have an operator "fixing" a service that was never broken.
        via_socket = False
        if enabled in ("disabled", "static", "unknown", ""):
            socket_unit = unit.split("@")[0].split(".")[0] + ".socket"
            if run(["systemctl", "is-enabled", socket_unit]).stdout.strip() == "enabled":
                enabled = "enabled"
                via_socket = True
        try:
            mem_bytes = int(b.get("MemoryCurrent", ""))
            if mem_bytes < 0 or mem_bytes >= 2 ** 63 - 1:
                mem_bytes = None
        except (TypeError, ValueError):
            mem_bytes = None
        kind = (kinds or {}).get(unit, "system")
        out.append({
            "unit": unit,
            "active": active,
            "enabled": enabled,
            "socket_activated": via_socket,
            "since": b.get("ActiveEnterTimestamp", ""),
            "memory": mem_bytes,
            "kind": kind,
            # Only MANAGED_UNITS can be started, stopped or restarted from
            # /services; the rest are shown there read-only.
            "managed": unit in MANAGED_UNITS,
            "stoppable": unit in MANAGED_UNITS and unit not in UNSTOPPABLE_UNITS,
        })
    return out


def service_state(unit):
    return service_states([unit])[0]


def tracked_units():
    """Every unit the panel reports on, with its kind.

    MANAGED_UNITS can be acted on; READONLY_UNITS, the agents and the WhatsApp
    bridges are only reported, so the dashboard's picture of the machine is
    complete without widening what it may do to it.
    """
    kinds = {}
    for u in MANAGED_UNITS + READONLY_UNITS:
        kinds[u] = "system"
    for slug in all_agent_slugs():
        kinds[UNIT_PREFIX + slug] = "agent"
    for meta in all_channels():
        slug = meta.get("slug")
        if meta.get("type") == "whatsapp" and isinstance(slug, str) and SLUG_RE.match(slug):
            kinds[WA_UNIT_PREFIX + slug] = "whatsapp"
    return kinds


