class TelegramRefused(Exception):
    pass


def redact_tokens(text):
    return TOKEN_IN_TEXT_RE.sub("[token]", str(text))


def telegram_call(token, method, params=None):
    """One Bot API call. The token is in the URL, so no error text ever carries the URL."""
    url = TELEGRAM_API + "/bot" + token + "/" + method
    data = urllib.parse.urlencode(params or {}).encode()
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=data), timeout=10) as r:
            body = json.loads(r.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        try:
            body = json.loads(e.read().decode("utf-8", "replace"))
        except Exception:
            raise TelegramUnreachable("HTTP " + str(e.code))
    except Exception as e:
        raise TelegramUnreachable(type(e).__name__)
    if not isinstance(body, dict) or not body.get("ok"):
        desc = body.get("description") if isinstance(body, dict) else ""
        raise TelegramRefused(redact_tokens(desc or "refused"))
    return body.get("result")


def telegram_topic_problems(token, mode, chat_id):
    """Ask Telegram whether topic mode can work. A list of sentences, or None if Telegram could not be reached.

    Only what would stop the bot from starting, or leave it unable to make a
    single topic, is reported.
    """
    try:
        me = telegram_call(token, "getMe")
        if mode == "private":
            if isinstance(me, dict) and me.get("has_topics_enabled") is False:
                return ["Topics are not turned on for this bot. In @BotFather: /mybots, the bot, "
                        "Bot Settings, Topics, turn on. Then save again."]
            return []
        try:
            chat = telegram_call(token, "getChat", {"chat_id": chat_id})
        except TelegramRefused as e:
            return ["Telegram cannot open chat " + chat_id + " for this bot (" + str(e) + "). "
                    "Add the bot to the group as an administrator, then save again."]
        problems = []
        ctype = (chat or {}).get("type")
        if ctype != "supergroup":
            problems.append("Chat " + chat_id + " is a " + str(ctype) + ", not a group with Topics.")
        elif not chat.get("is_forum"):
            problems.append("Topics are switched off in that group: open the group's settings, "
                            "turn on Topics, then save again.")
        try:
            member = telegram_call(token, "getChatMember", {"chat_id": chat_id, "user_id": me.get("id")})
            status = (member or {}).get("status")
            if status == "creator":
                pass
            elif status != "administrator":
                problems.append("The bot is not an administrator of that group (it is '" + str(status)
                                + "'); it needs to be one, with the Manage Topics right, to make topics.")
            elif member.get("can_manage_topics") is False:
                problems.append("The bot is an administrator of that group but lacks the Manage Topics right.")
        except TelegramRefused as e:
            problems.append("Could not read the bot's place in that group (" + str(e) + ").")
        return problems
    except TelegramUnreachable:
        return None
    except TelegramRefused as e:
        return ["Telegram refused the bot's token (" + str(e) + ")."]


# --- did it start? ------------------------------------------------------------

TOPICS_START_TIMEOUT = 45
FATAL_EVENTS = ("Configuration error", "Unexpected error", "Application error",
                "Failed to load configuration", "Error running bot")


def plain_bot_error(text):
    """The bot's error, as one readable sentence with no token in it."""
    t = redact_tokens(text or "")
    m = re.search(r"Value error, (.*?)(?: \[type=|$)", t, re.S)
    if m:
        t = m.group(1)
    t = re.sub(r"^(Configuration loading failed: )", "", t.strip())
    t = t.splitlines()[0] if t else ""
    if "Private chat topics are not enabled" in t:
        # The runtime words every "this chat has no topics" refusal this way,
        # group mode included -- which is how an ordinary group shows up.
        t += (" -- Telegram says the chat has no Topics: in group mode the group needs Topics "
              "turned on (its id then starts with -100); in private mode the bot needs Topics "
              "turned on in @BotFather")
    return t[:400]


def unit_props(unit, props=("ActiveState", "SubState", "NRestarts")):
    r = run(["systemctl", "show", unit, "-p", ",".join(props)])
    out = {}
    for line in r.stdout.splitlines():
        k, _, v = line.partition("=")
        out[k] = v
    return out


def agent_start_check(slug, since, timeout=TOPICS_START_TIMEOUT, sleep=None, clock=None):
    """Watch the agent's journal from `since` (epoch seconds) until it is polling Telegram or has failed.

    The runtime logs "Starting bot" only after configuration, the projects file
    and the group's topic sync have all gone through; a fatal event, a process
    exit or a failed unit means it did not. In group mode, a sync that made no
    usable topic at all is a failure too: the bot would run, but answer nothing.
    """
    sleep = sleep or time.sleep
    clock = clock or time.time
    unit = unit_name(slug)
    deadline = clock() + timeout
    result = {"ok": False, "state": "timeout", "error": "", "sync": None}
    sync_errors = []
    while True:
        r = run(["journalctl", "-u", unit, "--since", "@" + str(int(since)), "--no-pager", "-o", "cat"], timeout=20)
        started = False
        fatal = ""
        exited = False
        sync_errors = []
        lines = [l.strip() for l in r.stdout.splitlines()]
        # Whatever the old process said while it was being stopped is not this
        # start's business: read from the first start of the unit on.
        first = next((i for i, l in enumerate(lines) if l.startswith("Started " + unit)), None)
        for line in (lines[first + 1:] if first is not None else []):
            if line.startswith("{"):
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(ev, dict):
                    continue
                name = ev.get("event")
                if name == "Starting bot":
                    started = True
                elif name == "Project thread startup sync complete":
                    result["sync"] = {k: ev.get(k) for k in ("created", "reused", "renamed", "failed", "deactivated")}
                elif name == "Failed to sync project topic":
                    sync_errors.append(plain_bot_error(ev.get("error")))
                elif name in FATAL_EVENTS and not fatal:
                    fatal = plain_bot_error(ev.get("error") or name)
            elif "Main process exited" in line and "status=0" not in line:
                exited = True
        if fatal or exited:
            result.update(state="crashed", error=fatal or "the bot's process exited during start-up")
            return result
        if started:
            sync = result["sync"]
            if sync and not (sync.get("created") or sync.get("reused")) and sync.get("failed"):
                result.update(state="no-topics", error="no topic could be made in the group" + (
                    ": " + sync_errors[0] if sync_errors else ""))
                return result
            result.update(ok=True, state="running")
            return result
        props = unit_props(unit)
        if props.get("ActiveState") == "failed" or props.get("SubState") == "auto-restart":
            result.update(state="crashed", error="the unit stopped during start-up")
            return result
        if clock() >= deadline:
            # Still starting (Telegram slow?) but not crashed: leave it running.
            result.update(ok=props.get("ActiveState") == "active", state="slow",
                          error="" if props.get("ActiveState") == "active" else "the unit is " + str(props.get("ActiveState")))
            return result
        sleep(1)


def snapshot_files(paths):
    snap = {}
    for p in paths:
        try:
            st = os.lstat(p)
            with open(p, "rb") as fh:
                snap[p] = (fh.read(), st.st_mode & 0o7777, st.st_uid, st.st_gid)
        except FileNotFoundError:
            snap[p] = None
    return snap


def restore_files(snap):
    for p, saved in snap.items():
        if saved is None:
            if os.path.lexists(p):
                os.unlink(p)
            continue
        data, mode, uid, gid = saved
        d = os.path.dirname(p)
        os.makedirs(d, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=d, prefix=".restore-")
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        os.chown(tmp, uid, gid)
        os.chmod(tmp, mode)
        os.replace(tmp, p)


def topic_files(agent_slug):
    if not agent_slug:
        return []
    d = agent_dir(agent_slug)
    return [os.path.join(d, "agent.env"), os.path.join(d, PROJECTS_FILE)]


def restart_agent_unit(slug):
    run(["systemctl", "reset-failed", unit_name(slug)])
    run(["systemctl", "restart", unit_name(slug)], timeout=45)


def needs_start_check(cfg):
    """Settings the bot can refuse to start on: Topics, or answering in groups only when asked."""
    return bool(cfg.get("agent")) and cfg.get("type") == "telegram" and (
        bool(cfg.get("topics_enabled")) or cfg.get("respond_mode") == "mention")


def topics_safety_net(cfg, previous, snap, since):
    """After a save that leaves Topics on: make sure the agent came up; if not, put the old files back.

    Returns None when all is well (or Topics are off), else a dict for the
    caller to report: what the bot said, and what the agent is running now.
    """
    agent = cfg.get("agent")
    if not needs_start_check(cfg):
        return None
    check = agent_start_check(agent, since)
    if check["ok"]:
        return {"ok": True, "check": check}

    # Back to exactly what was there before this save: channel files, env and
    # projects file. Then restart and make sure that comes up.
    restore_files(snap)
    since2 = time.time()
    if previous.get("agent") and previous.get("agent") != agent:
        # The channel moved agents in this save: rebuild both from the restored
        # channel, which stops the one it no longer feeds.
        reconfigure_agent(previous["agent"])
        reconfigure_agent(agent)
    else:
        restart_agent_unit(agent)
    bound = channel_bound_to(agent)
    if bound and bound.get("type") == "telegram":
        after = agent_start_check(agent, since2)
    else:
        after = {"ok": True, "state": "not connected"}
    fallback = False
    respond_forced_all = False
    if not after["ok"]:
        # The previous configuration does not start either. If Topics were on
        # in it, switch them off: never leave the agent in a crash loop.
        restored = read_channel_json(cfg["slug"])
        if restored.get("topics_enabled") or restored.get("respond_mode") == "mention":
            respond_forced_all = restored.get("respond_mode") == "mention"
            restored["topics_enabled"] = False
            restored["respond_mode"] = "all"
            uid, gid = agent_ids()
            write_channel_files(restored, uid, gid, keep_token=channel_token(cfg["slug"]))
            since3 = time.time()
            reconfigure_agent(agent)
            fallback = True
            after = agent_start_check(agent, since3)
    return {"ok": False, "check": check, "after": after, "topics_forced_off": fallback,
            "respond_forced_all": fallback and respond_forced_all}


def topics_audit(cfg):
    if not cfg.get("topics_enabled"):
        return {"enabled": False}
    out = {"enabled": True, "mode": cfg.get("topics_mode"), "chat_id": cfg.get("topics_chat_id"),
           "projects": [[p["slug"], p["path"]] + (["auto"] if p.get("auto") else []) for p in cfg.get("topics_projects") or []]}
    extras = topic_extras(cfg)
    if extras != topic_extras({}):
        out["options"] = extras
    return out


def respond_audit(cfg):
    return {"mode": cfg.get("respond_mode") or "all", "aliases": len(cfg.get("name_aliases") or [])}


def topics_failure_text(net, cfg=None):
    check, after = net["check"], net.get("after") or {}
    if cfg is not None and not cfg.get("topics_enabled"):
        text = "The settings were not saved: the bot did not start with them"
    else:
        text = "Topics were not turned on: the bot did not start in topic mode"
    if check.get("error"):
        text += " (it said: " + check["error"] + ")"
    text += "."
    if net.get("topics_forced_off"):
        text += (" The previous settings did not start either, so Topics are now off"
                 + (" and the bot answers every group message." if net.get("respond_forced_all") else "."))
    else:
        text += " The previous settings are back."
    text += (" The agent is running again." if after.get("ok")
             else " The agent is still not running (" + str(after.get("error") or after.get("state")) + "); check its log.")
    return text


def preflight_topics(cfg, token):
    """Refuse a Topics save Telegram says cannot work. Unreachable Telegram does not block: the safety net still runs."""
    if cfg.get("type") != "telegram" or not cfg.get("topics_enabled") or not cfg.get("agent") or not token:
        return
    problems = telegram_topic_problems(token, cfg.get("topics_mode") or "group", cfg.get("topics_chat_id") or "")
    if problems:
        fail("Topics not saved: " + " ".join(problems))


def cmd_channel_topics_folders(args):
    """Folders a topic may map to: directories inside the bound agent's folder (APPROVED_DIRECTORY).

    Read-only. Links are left out -- the runtime follows them, and one that
    leaves the folder is refused -- as are hidden folders. Three levels deep.
    """
    if not args:
        fail("usage: channel-topics-folders <slug>")
    slug = check_channel_slug(args[0])
    existing_channel(slug)
    meta = read_channel_json(slug)
    agent = meta.get("agent") or ""
    if not agent or not os.path.isdir(agent_dir(agent)):
        ok({"slug": slug, "agent": "", "approved_directory": "", "folders": [], "default_projects": [],
            "auto": read_auto_file("")})
    root = os.path.realpath(agent_vault(agent))
    folders = ["."]
    if os.path.isdir(root):
        for cur, dirs, _files in os.walk(root):
            depth = 0 if cur == root else os.path.relpath(cur, root).count("/") + 1
            keep = []
            for d in sorted(dirs):
                full = os.path.join(cur, d)
                if d.startswith(".") or os.path.islink(full):
                    continue
                folders.append(os.path.relpath(full, root))
                keep.append(d)
            dirs[:] = keep if depth < 2 else []
            if len(folders) >= 300:
                break
    folders = ["."] + sorted(folders[1:])
    ok({
        "slug": slug,
        "agent": agent,
        "approved_directory": root,
        "folders": folders[:300],
        "default_projects": default_topic_projects(agent, read_agent_json(agent).get("name")),
        "default_aliases": default_aliases(agent, read_agent_json(agent).get("name")),
        "auto": read_auto_file(agent),
    })


def validate_channel(cfg, creating):
    out = {}
    slug = cfg.get("slug", "")
    check_channel_slug(slug)
    out["slug"] = slug

    name = str(cfg.get("name") or slug).strip()
    if not NAME_RE.match(name):
        fail("channel name contains disallowed characters")
    out["name"] = name

    ctype = str(cfg.get("type") or "telegram").strip()
    if ctype not in CHANNEL_TYPES:
        fail("channel type must be one of: " + ", ".join(CHANNEL_TYPES))
    out["type"] = ctype

    agent = str(cfg.get("agent") or "").strip()
    if agent:
        check_slug(agent)
        if not os.path.isdir(agent_dir(agent)):
            fail("no such agent: " + agent)
        # One poller per token, so one channel per agent.
        for other in all_channels():
            if other.get("agent") == agent and other.get("slug") != slug:
                fail(
                    "agent " + agent + " is already connected to channel "
                    + str(other.get("slug"))
                    + "; disconnect it first"
                )
    out["agent"] = agent

    out["addons"] = validate_addon_ids(cfg.get("addons"))
    out["addon_env"] = validate_env_map(cfg.get("addon_env"))

    if ctype == "telegram":
        username = str(cfg.get("telegram_bot_username") or "").lstrip("@").strip()
        if username and not BOT_USERNAME_RE.match(username):
            fail("bot username must be 4-32 characters of letters, digits or underscore")
        out["telegram_bot_username"] = username

        # An ordered list, not a set. Position zero is the administrator, whom
        # the runtime treats as the default user. Reordering the list is how
        # the administrator changes.
        allowed = normalise_principals(cfg.get("allowed_users"), USER_ID_RE, "Telegram user ID")
        out["allowed_users"] = ",".join(allowed)

        topics = bool(cfg.get("topics_enabled"))
        chat_id = str(cfg.get("topics_chat_id") or "").strip()
        if chat_id and not CHAT_ID_RE.match(chat_id):
            fail("Telegram chat id must be numeric (groups start with -100)")
        mode = str(cfg.get("topics_mode") or "group").strip().lower()
        if mode not in TOPICS_MODES:
            fail("Topics: the mode must be 'group' or 'private'")
        projects = normalise_topic_projects(cfg.get("topics_projects"))
        if any(p.get("auto") for p in projects):
            # Folders the runtime made for new topics come back from the panel
            # flagged: only edited ones are kept, as overrides (fold_auto_rows).
            auto = read_auto_file(agent) if agent else {"projects": []}
            projects = fold_auto_rows(projects, auto["projects"], cfg.get("_stored_projects"))
        try:
            general = str(cfg.get("topics_general") or "").strip().lower()
            if general == "off":
                general = ""
            if general and not TOPIC_SLUG_RE.match(general):
                raise TopicError("Topics: the General topic must go to one of the projects, or be off")
            deleted = str(cfg.get("topics_deleted") or "trash").strip().lower()
            if deleted not in TOPICS_DELETED:
                raise TopicError("Topics: a deleted topic's folder is either moved to the trash or kept "
                                 "('trash' or 'keep')")
            trash_days = parse_trash_days(cfg.get("topics_trash_days"))
            respond = str(cfg.get("respond_mode") or "all").strip().lower()
            if respond not in RESPOND_MODES:
                raise TopicError("Respond in groups: answer every message ('all') or only when asked "
                                 "('mention'), not '" + respond[:20] + "'")
            aliases = parse_aliases(cfg.get("name_aliases"))
        except TopicError as e:
            fail(str(e))
        if respond == "mention" and not aliases and agent:
            aliases = default_aliases(agent, read_agent_json(agent).get("name"))
        if topics:
            # Everything the runtime checks before it starts in topic mode,
            # checked now: a save it would refuse never reaches the agent.
            if agent and not projects:
                projects = default_topic_projects(agent, read_agent_json(agent).get("name"))
            err = topic_chat_error(mode, chat_id)
            if not err and agent:
                err = check_topic_projects(projects, agent_vault(agent))
            if not err and mode == "group":
                err = general_error(general, projects)
            if err:
                fail("Topics not saved: " + err + ".")
        out["topics_enabled"] = topics
        out["topics_chat_id"] = chat_id
        out["topics_mode"] = mode
        out["topics_projects"] = projects
        out["topics_general"] = general
        out["topics_auto"] = parse_flag(cfg.get("topics_auto"), False)
        out["topics_auto_announce"] = parse_flag(cfg.get("topics_auto_announce"), True)
        out["topics_deleted"] = deleted
        out["topics_trash_days"] = trash_days
        out["respond_mode"] = respond
        out["name_aliases"] = aliases

        token = cfg.get("token") or ""
        if token and not BOT_TOKEN_RE.match(token):
            fail("that does not look like a Telegram bot token")
        if creating and not token:
            fail("a Telegram bot token is required to create a Telegram channel")
        out["_token"] = token
    else:
        numbers = normalise_principals(cfg.get("allowed_numbers"), PHONE_RE, "phone number in E.164 form")
        out["allowed_numbers"] = ",".join(numbers)
        out["_token"] = ""

    return out


def write_channel_files(cfg, uid, gid, keep_token=""):
    d = channel_dir(cfg["slug"])
    os.makedirs(d, exist_ok=True)

    token = cfg.get("_token") or keep_token
    env_path = os.path.join(d, "channel.env")
    fd, tmp = tempfile.mkstemp(dir=d)
    with os.fdopen(fd, "w") as fh:
        fh.write("# Generated by the MONI dashboard.\n")
        fh.write("CHANNEL_TOKEN=" + token + "\n")
    os.chown(tmp, uid, gid)
    os.chmod(tmp, 0o600)
    os.replace(tmp, env_path)

    meta = {k: v for k, v in cfg.items() if not k.startswith("_")}
    meta["updated_at"] = now_iso()
    meta_path = os.path.join(d, "channel.json")
    with open(meta_path, "w") as fh:
        json.dump(meta, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.chown(meta_path, uid, gid)
    os.chmod(meta_path, 0o640)
    os.chown(d, uid, gid)
    os.chmod(d, 0o770)


def reconfigure_agent(agent_slug):
    """Regenerate an agent's environment from its current channel and restart it.

    Called whenever a channel changes, because the agent's EnvironmentFile is
    derived from the channel and would otherwise still hold the old token.
    """
    if not agent_slug or not os.path.isdir(agent_dir(agent_slug)):
        return {"reconfigured": False}
    cfg = validate_config(read_agent_json(agent_slug), creating=False)
    uid, gid = agent_ids()
    channel = channel_bound_to(agent_slug)
    plan = write_agent_files(cfg, uid, gid, channel)
    chown_tree(agent_dir(agent_slug), uid, gid)
    seal_agent_files(agent_slug, gid)
    topics = {"enabled": bool(plan.get("enabled"))}
    if plan.get("skipped"):
        topics["skipped"] = plan["skipped"]

    run(["systemctl", "daemon-reload"])
    run(["systemctl", "reset-failed", unit_name(agent_slug)])

    # moni-agent@ is the *Telegram* runtime. An agent reached only over WhatsApp
    # is served by its bridge instead, so starting this unit would just produce a
    # crash loop over a missing bot token and a "failed" badge on a healthy
    # agent. No channel at all means nothing to listen to either way.
    if channel and channel.get("type") == "telegram":
        r = run(["systemctl", "enable", "--now", unit_name(agent_slug)], timeout=45)
        if unit_state(agent_slug)["active"] == "active":
            run(["systemctl", "restart", unit_name(agent_slug)], timeout=45)
        return {"reconfigured": True, "running": r.returncode == 0, "topics": topics}

    run(["systemctl", "disable", "--now", unit_name(agent_slug)], timeout=45)
    run(["systemctl", "reset-failed", unit_name(agent_slug)])
    return {
        "reconfigured": True,
        "running": False,
        "note": "served by its WhatsApp bridge" if channel else "no channel connected",
    }


