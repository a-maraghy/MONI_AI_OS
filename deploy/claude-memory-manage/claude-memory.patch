+# Memory managed from the dashboard (Agents & sessions > Memory > Sessions):
+#   excluded_sessions   a session deleted there is never indexed again, even though its
+#                       transcript (or a read-only archive copy) may still be on disk;
+#   memory_tombstones   a chunk deleted there one by one (by content_hash) is never re-created
+#                       when the still-growing last exchange of its transcript is re-read.
+# Both tables are optional: with an older schema they are simply not consulted.
+SESSION_IN_PATH = re.compile(
+    r"/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?:\.jsonl$|/subagents/)")
+EXCLUDED = set()
+TOMBSTONES = False
+
+
+def load_exclusions(conn):
+    """Refresh EXCLUDED (session ids) and TOMBSTONES (table present) from the database."""
+    global EXCLUDED, TOMBSTONES
+    ex, tb = conn.execute("SELECT to_regclass('excluded_sessions') IS NOT NULL, "
+                          "to_regclass('memory_tombstones') IS NOT NULL").fetchone()
+    EXCLUDED = {r[0] for r in conn.execute("SELECT session_id FROM excluded_sessions").fetchall()} if ex else set()
+    TOMBSTONES = bool(tb)
+    conn.commit()
+    return EXCLUDED
+
 
