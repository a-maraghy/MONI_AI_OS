CC_HOOK_LINE_RE = re.compile(r"^(\S+)\s+([A-Za-z]+)\s+(\{.*\})\s*$")


def cc_hook_lines(n):
    if not os.path.exists(CC_HOOK_LOG):
        return []
    with open(CC_HOOK_LOG, "rb") as fh:
        fh.seek(0, os.SEEK_END)
        size = fh.tell()
        fh.seek(max(0, size - 256 * 1024))
        lines = fh.read().decode("utf-8", "replace").splitlines()[-n:]
    out = []
    for ln in lines:
        m = CC_HOOK_LINE_RE.match(ln)
        if not m:
            continue
        try:
            detail = json.loads(m.group(3))
        except Exception:
            detail = {}
        if not isinstance(detail, dict):
            detail = {}
        # The log is content-free by design; keep it that way on the way out by
        # passing on scalars only.
        detail = {str(k)[:40]: v for k, v in detail.items()
                  if isinstance(v, (int, float, bool)) or v is None
                  or (isinstance(v, str) and len(v) <= 80)}
        out.append({"ts": m.group(1), "event": m.group(2), "detail": detail})
    return list(reversed(out))


