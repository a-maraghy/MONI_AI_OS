def cmd_system_probe(args):
    """Report which optional capabilities are actually installed.

    The add-on catalogue claims things like voice transcription are available;
    this is what lets the panel show that as a fact rather than a hope.
    """
    def have_binary(name):
        return bool(shutil.which(name))

    whisper_bin = os.path.join(SHARED_DIR, "whisper.cpp", "build", "bin", "whisper-cli")
    whisper_model = os.path.join(SHARED_DIR, "whisper.cpp", "models", "ggml-base.bin")
    models_dir = os.path.join(SHARED_DIR, "models")

    claude_configured = False
    if os.path.isfile(CLAUDE_AUTH):
        with open(CLAUDE_AUTH, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                key, _, value = line.strip().partition("=")
                if key.strip() in ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY") and value.strip():
                    claude_configured = True
                    break

    runtime_rev = ""
    r = run(["git", "-C", RUNTIME_DIR, "rev-parse", "--short", "HEAD"])
    if r.returncode == 0:
        runtime_rev = r.stdout.strip()

    # An agent that started before the credential was last written is still
    # running with the old environment, because systemd reads EnvironmentFile
    # only at unit start. Without this the panel would report the credential as
    # configured while the agent that needs it has never seen it.
    stale = []
    if os.path.isfile(CLAUDE_AUTH) and os.path.isdir(AGENTS_DIR):
        written = os.path.getmtime(CLAUDE_AUTH)
        for slug in sorted(os.listdir(AGENTS_DIR)):
            if not SLUG_RE.match(slug) or not os.path.isdir(agent_dir(slug)):
                continue
            if unit_state(slug)["active"] != "active":
                continue
            wall = run(
                ["systemctl", "show", unit_name(slug),
                 "-p", "ActiveEnterTimestamp", "--value"]
            ).stdout.strip()
            if not wall:
                continue
            try:
                # `date -d` handles systemd's locale-ish timestamp format for us.
                epoch = run(["date", "-d", wall, "+%s"]).stdout.strip()
                if epoch and float(epoch) < written:
                    stale.append(slug)
            except Exception:
                continue

    ok(
        {
            "files": {
                "whisper_binary": os.path.isfile(whisper_bin),
                "whisper_model": os.path.isfile(whisper_model),
                "embedding_model": os.path.isdir(models_dir) and bool(os.listdir(models_dir)),
                "vault_template": os.path.isdir(TEMPLATE_DIR),
                "runtime_venv": os.path.isfile(
                    os.path.join(RUNTIME_DIR, "venv", "bin", "claude-telegram-bot")
                ),
            },
            "binaries": {
                "ffmpeg": have_binary("ffmpeg"),
                "claude": have_binary("claude"),
                "obsidian": have_binary("obsidian"),
                "node": have_binary("node"),
                "git": have_binary("git"),
            },
            "claude_credential": claude_configured,
            "credential_stale_agents": stale,
            "runtime_revision": runtime_rev,
            "counts": {
                "agents": len(
                    [s for s in os.listdir(AGENTS_DIR) if SLUG_RE.match(s)]
                )
                if os.path.isdir(AGENTS_DIR)
                else 0,
                "channels": len(all_channels()),
            },
        }
    )


