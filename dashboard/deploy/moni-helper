SLUG_RE = re.compile(r"^[a-z][a-z0-9-]{1,30}$")
# Display names are shown, never interpolated into a shell or a path, so the set
# is generous. It still excludes the characters that would end up in generated
# files: quotes, angle brackets, newlines, backslashes.
NAME_RE = re.compile(r"^[\w .,'()&/@:+#!?-]{1,64}$", re.UNICODE)
BOT_TOKEN_RE = re.compile(r"^\d{6,12}:[A-Za-z0-9_-]{30,60}$")
USERNAME_RE = re.compile(r"^[A-Za-z0-9._-]{3,32}$")
BOT_USERNAME_RE = re.compile(r"^[A-Za-z0-9_]{4,32}$")
USER_ID_RE = re.compile(r"^\d{4,15}$")
USER_IDS_RE = re.compile(r"^\d{4,15}(,\d{4,15})*$")
MODEL_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{2,60}$")
CHAT_ID_RE = re.compile(r"^-?\d{4,20}$")
ABS_PATH_RE = re.compile(r"^/[A-Za-z0-9._/-]{1,200}$")
