def cmd_channel_update(args):
    payload = read_stdin_json()
    slug = check_channel_slug(payload.get("slug", ""))
    existing_channel(slug)
    current = read_channel_json(slug)
    previous_agent = current.get("agent") or ""

    merged = dict(current)
    merged.update({k: v for k, v in payload.items() if v is not None})
    cfg = validate_channel(merged, creating=False)

    uid, gid = agent_ids()
    write_channel_files(cfg, uid, gid, keep_token=channel_token(slug))

    results = {}
    # Order matters: rebuild the agent that lost the channel first, so it stops
    # before the new one starts polling the same token.
    if previous_agent and previous_agent != cfg.get("agent"):
        results["previous"] = reconfigure_agent(previous_agent)
    results["current"] = reconfigure_agent(cfg.get("agent"))
    results["whatsapp"] = reconcile_whatsapp(slug)
    audit("channel-update", {"slug": slug, "agent": cfg.get("agent"),
                             "token_changed": bool(cfg.get("_token"))})
    ok({"slug": slug, **results})


