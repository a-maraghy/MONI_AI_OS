        raise CCError("bad fact id")
    content, topic, kind = cc_fact_fields(payload)
    res = cc_bridge("fact_edit", id=fid, content=content, topic=topic, kind=kind, actor=actor)
    audit("cc-fact-edit", {"by": actor, "fact": fid, "new": res.get("id"), "topic": topic})
    return res


def cc_fact_forget(payload):
