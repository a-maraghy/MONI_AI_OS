    "ALLOW_DRAWING",
    "DRAW_MAX_RENDER_PX",
    "DRAW_MAX_RENDERS_PER_REPLY",
    "SVG_MAX_KB",
}


def render_env(cfg, channel=None, topics=None):
    """Build the agent's systemd EnvironmentFile.

    Three sources merge here, in increasing order of precedence:

      1. baseline    what every agent needs to run at all
      2. add-ons     capability switches chosen in the panel
      3. identity    paths and credentials the helper computes itself

    Identity comes last on purpose: an add-on cannot redirect an agent at
    another agent's vault or bot token, whatever the dashboard sends. Every
    value has been through validate_config, so none can contain a newline that
    would inject a second variable.

    `topics` is the topic_plan() for this agent and channel. Topic mode is
    written only when the plan is enabled, and then always as the full set --
    including PROJECTS_CONFIG_PATH, which the runtime refuses to start without.
    """
    if topics is None:
        topics = topic_plan(cfg, channel)
    d = agent_dir(cfg["slug"])
    vault = os.path.join(d, "vault")

    env = {
        # --- baseline -------------------------------------------------------
        "USE_SDK": "true",
        "AGENTIC_MODE": "true",
        "ENABLE_TOKEN_AUTH": "false",
        "DISABLE_SECURITY_PATTERNS": "true",
        "DISABLE_TOOL_VALIDATION": "false",
        "SESSION_TIMEOUT_HOURS": "720",
        "MAX_SESSIONS_PER_USER": "10",
        "RATE_LIMIT_REQUESTS": "30",
        "RATE_LIMIT_WINDOW": "60",
        "RATE_LIMIT_BURST": "60",
        "CLAUDE_MODEL": cfg["model"],
        "CLAUDE_EFFORT": cfg.get("effort", "medium"),
        "CLAUDE_MAX_TURNS": str(cfg["max_turns"]),
        "CLAUDE_TIMEOUT_SECONDS": str(cfg["timeout_seconds"]),
        "VERBOSE_LEVEL": str(cfg["verbose_level"]),
    }

    # --- add-ons ------------------------------------------------------------
    env.update(cfg.get("addon_env") or {})
    if channel:
        env.update(channel.get("addon_env") or {})

    # --- identity: computed here, never overridable -------------------------
    env.update(
        {
            "APPROVED_DIRECTORY": vault,
            "DATABASE_URL": "sqlite:///" + os.path.join(d, "data", "bot.db"),
            "MCP_CONFIG_PATH": os.path.join(d, "mcp.json"),
            "MONI_AGENT_SLUG": cfg["slug"],
            "MONI_VAULT": vault,
            "MONI_VECTOR_DB": os.path.join(d, "vectors", "memory.db"),
            "ENVIRONMENT": "production",
            "DEVELOPMENT_MODE": "false",
            "ALLOW_FILE_SEND": "true" if cfg.get("file_send", True) else "false",
            "ALLOW_DRAWING": "true"
            if cfg.get("file_send", True) and cfg.get("drawing", True)
            else "false",
        }
    )

    if channel and channel.get("type") == "telegram":
        env["TELEGRAM_BOT_TOKEN"] = channel.get("_token", "")
        env["TELEGRAM_BOT_USERNAME"] = channel.get("telegram_bot_username", "")
        env["ALLOWED_USERS"] = channel.get("allowed_users", "")
        respond = respond_settings(channel, cfg["slug"], cfg.get("name"))
        env["GROUP_RESPOND_MODE"] = respond["mode"]
        env["BOT_NAME_ALIASES"] = ",".join(respond["aliases"])
        if topics.get("enabled"):
            env["ENABLE_PROJECT_THREADS"] = "true"
            env["PROJECT_THREADS_MODE"] = topics["mode"]
            if topics["mode"] == "group":
                env["PROJECT_THREADS_CHAT_ID"] = topics["chat_id"]
            env["PROJECTS_CONFIG_PATH"] = topics["path"]
            # topic_plan() carries these; a plan built elsewhere may not, so
            # the channel's own fields are the fallback (checked the same way).
            extras = topic_extras(channel)
            extras.update({k: topics[k] for k in extras if k in topics})
            general = extras["general"]
            if topics["mode"] != "group" or general_error(general, topics.get("projects") or []):
                general = ""
            env["PROJECT_THREADS_GENERAL_PROJECT"] = general or "off"
            env["PROJECT_THREADS_AUTO_MAP"] = "true" if extras["auto"] else "false"
            env["PROJECT_THREADS_AUTO_ANNOUNCE"] = "true" if extras["auto_announce"] else "false"
            env["PROJECT_THREADS_DELETED_TOPICS"] = extras["deleted"]
            env["PROJECT_THREADS_TRASH_DAYS"] = str(extras["trash_days"])
        else:
            env["ENABLE_PROJECT_THREADS"] = "false"

    lines = [
        "# Generated by the MONI dashboard. Edit through the panel, not by hand.",
        "# Regenerated on every configuration change to this agent or its channel.",
    ]
    for key in sorted(env):
        lines.append(key + "=" + env[key])
    return "\n".join(lines) + "\n"


def render_mcp(cfg):
    d = agent_dir(cfg["slug"])
    servers = {
        "memory": {
            "command": os.path.join(RUNTIME_DIR, "venv", "bin", "python"),
            "args": ["-m", "moni_memory.mcp_server"],
            "env": {
                "MONI_VAULT": os.path.join(d, "vault"),
                "MONI_VECTOR_DB": os.path.join(d, "vectors", "memory.db"),
                "MONI_MODEL_CACHE": os.path.join(SHARED_DIR, "models"),
