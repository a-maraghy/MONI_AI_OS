#!/usr/bin/env node
"use strict";
/**
 * moni-ai-mcp: MINT AI's own tools, as a stdio MCP server.
 *
 * The supervisor starts MINT AI with this server in --mcp-config. Each tool is
 * one call to the supervisor's control socket as actor "moni-ai", so the
 * supervisor validates it, records it in the ledger, audits it and pushes it
 * to the Command Center. Nothing here touches the machine: missions and
 * decisions are MINT AI's record of what it plans and proposes.
 *
 * Tools
 *   mission_create        a multi-step goal with its steps
 *   mission_step_add      another step
 *   mission_step_update   a step's status / target / result
 *   mission_update        close a mission (done, failed, cancelled) or retitle it
 *   mission_list          open missions (or all)
 *   mission_get           one mission with its steps
 *   decision_propose      the finding and fix for a watcher's decision card
 *   decision_update       the result of running an approved fix
 *   status_snapshot       this VPS at a glance (read-only): services, disk,
 *                         memory, live sessions, missions, open decisions and
 *                         pending approvals -- counts and titles, never a command
 *   ui_actions_list       the screen actions that exist right now (read-only)
 *   session_hire          hire a worker session (its own context, supervised, gated)
 *   session_retire        ASK the administrator to retire one it hired (a consent card; never ends it)
 *   machine_list / machine_take_over / machine_tell / machine_release
 *                         the user's own computers (Path A laptop control): a session ON the
 *                         computer under a lease the user can stop; lib/machines.js
 *   ui_do                 do one: change what the administrator sees in the tab
 *                         they asked from (open a page or a panel, end the
 *                         call...), during their own turn only; never approves,
 *                         denies or changes a setting. Its schema never changes.
 *
 * Plain JSON-RPC 2.0 over newline-delimited stdio (MCP's stdio transport).
 */
const net = require("net");
const path = require("path");
const readline = require("readline");
const { FORBIDDEN_KEYS } = require(path.join(__dirname, "..", "lib", "snapshot.js"));
const UiActions = require(path.join(__dirname, "..", "lib", "ui-actions.js"));

const SOCKET = process.env.MONI_AI_SOCKET || "/run/moni-ai/moni-ai.sock";
const STEP_STATUSES = ["planned", "delegated", "working", "waiting_approval", "done", "failed", "skipped"];
const missionId = { type: "string", description: 'The mission, e.g. "M-12".' };

/*
 * Screen actions. A resumed claude CLI keeps the schema it first loaded for an
 * MCP tool (a deferred_tools_record in its transcript) even after this server
 * changes it -- so the tool that acts has a schema that never changes (ui_do:
 * `action` a plain string, the arguments a fixed superset; validation stays on
 * the supervisor and the page), and what exists right now is read at run time
 * from ui_actions_list. Adding an action or a page never touches either schema.
 * (The first tool, ui_action, carried an enum of the actions; a CLI that loaded
 * it before page.open existed would never see page.open, whatever it was
 * served later. It is gone, and ui_do is a new name, so it is discovered fresh.)
 */
function uiTools() {
  return [
    {
      name: "ui_actions_list",
      description:
        "Read-only: the screen actions ui_do can do right now -- each action's name, what it does, its tier, whether it needs the administrator's " +
        "confirmation, whether it works once a request, and its arguments with their allowed values (for page.open: the page keys and what each needs). " +
        "Call it before ui_do whenever you are not sure an action or a value exists; it changes as Mint OS grows.",
      inputSchema: { type: "object", properties: {}, additionalProperties: false },
      noArgs: true,
      local: () => UiActions.catalog(),
    },
    {
      name: "ui_do",
      op: "ui-action",
      description:
        "Change what the administrator sees in the tab they asked from (the Command Center, or the MINT AI dock on another Mint OS page), at once -- " +
        "for example open another page of Mint OS, open or close a panel, or end their voice call. The actions, their arguments and allowed values " +
        "are listed by ui_actions_list: call it first; pass the action and its arguments as plain fields. " +
        "Use it only while you answer a request the administrator sent from the Command Center, and only when they asked for it in that request. " +
        "It cannot approve, deny or confirm anything, change keys, users, rules or settings, restart or deploy: approving stays the administrator's click. " +
        "Actions marked needs_confirm only ASK: their result is confirm, nothing has changed yet, and the administrator confirms on screen or by voice; say only that you are waiting for their confirmation (never tell them to say yes); " +
        "never say it is done and never confirm for them. The result says ok, refused (with why), confirm or no-screen; say what really happened.",
      inputSchema: UiActions.stableSchema(),
      map(given) {
        const f = UiActions.fromTool(given);
        if (f.extra.length) throw new Error("ui_do does not take: " + f.extra.join(", ") + " (see ui_actions_list)");
        return { action: String(f.action || ""), args: f.args };
      },
      shape: (d) => d,
    },
  ];
}

const TOOLS = [
  {
    name: "mission_create",
    op: "mission-create",
    description:
      "Create a mission for a multi-step goal and record its steps. Use it whenever a goal needs more than one delegation or more than one session. " +
      'Each step names who does it: a live session\'s name, or "moni-ai" (you, MINT AI; "MINT AI" is accepted too) for a step you do yourself. Returns the mission with its id (M-<n>). ' +
      'Then delegate each step with "M-<n> step <k>" in the first line of the message, so the Command Center links the delegation to the step.',
    inputSchema: {
      type: "object",
      properties: {
        title: { type: "string", description: "Short title, under 80 characters." },
        goal: { type: "string", description: "The goal in one or two sentences, as the administrator gave it." },
        steps: {
          type: "array",
          items: {
            type: "object",
            properties: { title: { type: "string" }, detail: { type: "string" }, target: { type: "string", description: 'Session name, or "moni-ai" for yourself (MINT AI).' } },
            required: ["title"],
            additionalProperties: false,
          },
        },
      },
      required: ["title", "goal", "steps"],
      additionalProperties: false,
    },
  },
  {
    name: "mission_step_add",
    op: "mission-step-add",
    description: "Add a step to an open mission (numbered after the last one).",
    inputSchema: {
      type: "object",
      properties: { mission_id: missionId, title: { type: "string" }, detail: { type: "string" }, target: { type: "string" } },
      required: ["mission_id", "title"],
      additionalProperties: false,
    },
  },
  {
    name: "mission_step_update",
    op: "mission-step-update",
    description:
      "Update one step: its status (" +
      STEP_STATUSES.join(", ") +
      "), target, result or note. Delegations tagged with the step move it automatically (sent -> delegated, working, done); " +
      "set it yourself for steps you do, to record a result, or to mark a step done, failed or skipped.",
    inputSchema: {
      type: "object",
      properties: {
        mission_id: missionId,
        step: { type: "integer", minimum: 1 },
        status: { type: "string", enum: STEP_STATUSES },
