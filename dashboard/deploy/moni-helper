def _short(text, n):
    text = " ".join(str(text or "").split())
    return text if len(text) <= n else text[:n - 1] + "…"


def _chunk_label(src, content, meta):
    if src == "doc":
        head = (meta or {}).get("heading") or (meta or {}).get("rel") or ""
        return _short(head.split(" > ")[-1] if head else content, 70)
    if src == "memory_file":
        return _short((meta or {}).get("file") or content, 70)
    text = str(content or "")
    for prefix in ("[cont.] ", "User: "):
        if text.startswith(prefix):
            text = text[len(prefix):]
    return _short(text.split("\n", 1)[0], 70)


def _sem_edges(c, ids, k, min_sim):
    """Nearest current facts by embedding, k per fact, above min_sim.

    One LATERAL query over the HNSW index; ef_search raised so the filter on
    superseded_by does not starve the candidate list.
    """
    if not ids:
        return []
    c.execute("SET LOCAL hnsw.ef_search = 100")
    got = c.execute(
        "SELECT a.id, n.id, n.sim FROM facts a CROSS JOIN LATERAL ("
        " SELECT b.id, 1 - (a.embedding <=> b.embedding) AS sim FROM facts b"
        " WHERE b.superseded_by IS NULL AND b.embedding IS NOT NULL AND b.id <> a.id"
        " ORDER BY a.embedding <=> b.embedding LIMIT %s) n"
        " WHERE a.id = ANY(%s) AND a.superseded_by IS NULL AND a.embedding IS NOT NULL",
        (k, list(ids))).fetchall()
    out = []
    for a, b, sim in got:
        if sim is not None and sim >= min_sim:
            out.append([int(a), int(b), round(float(sim), 3)])
    return out


def graph(c, req):
    """Nodes and links for the memory graph.

    Full when after_f/after_c are absent; otherwise only facts and chunks newer
    than those ids, with whatever hubs they hang from and their links. Always
    returns the ids of the facts still remembered, so a page can let a
    forgotten one go. Semantic links are cached by the helper keyed on the
    facts table's signature (see cc_memory_graph).
    """
    lim_f, lim_c = int(req.get("limit_f", 1500)), int(req.get("limit_c", 1000))
    after_f, after_c = req.get("after_f"), req.get("after_c")
    k, min_sim = int(req.get("k", 3)), float(req.get("min_sim", 0.75))
    inc = after_f is not None or after_c is not None
    fwhere = "(superseded_by IS NULL OR superseded_by <> id)"
    fargs = []
    if inc:
        fwhere += " AND id > %s"
        fargs.append(int(after_f or 0))
    facts = rows(c, "SELECT id, topic, ts, source_session, superseded_by, meta->>'kind' AS kind, "
                    "meta->>'project' AS project, left(content, 360) AS content FROM facts WHERE " + fwhere +
                    " ORDER BY id DESC LIMIT %s", fargs + [lim_f])
    cwhere, cargs = "NOT " + hid(c), []
    if inc:
        cwhere += " AND id > %s"
        cargs.append(int(after_c or 0))
    chunks = rows(c, "SELECT id, source, session_id, project, ts, role, left(content, 240) AS content, "
                     "meta->>'title' AS title, meta->>'heading' AS heading, meta->>'rel' AS rel, "
                     "meta->>'file' AS file FROM chunks WHERE " + cwhere + " ORDER BY id DESC LIMIT %s",
                cargs + [lim_c])
    sessions = {}
    sids = {f["source_session"] for f in facts if f["source_session"]} | {ch["session_id"] for ch in chunks if ch["session_id"]}
    if sids:
        for r in rows(c, "SELECT session_id, min(ts) AS first, max(ts) AS last, count(*) AS n, "
                         "max(project) AS project, max(meta->>'title') AS title FROM chunks "
                         "WHERE session_id = ANY(%s) AND NOT " + hid(c) + " GROUP BY session_id", (list(sids),)):
            sessions[r["session_id"]] = r
    sig = c.execute("SELECT count(*), coalesce(max(id), 0), coalesce(sum(superseded_by), 0) FROM facts").fetchone()
    alive = [r[0] for r in c.execute("SELECT id FROM facts WHERE superseded_by IS NULL OR superseded_by <> id "
                                     "ORDER BY id DESC LIMIT %s", (lim_f,)).fetchall()]
    supers = [[r[0], r[1]] for r in c.execute(
        "SELECT id, superseded_by FROM facts WHERE superseded_by IS NOT NULL AND superseded_by <> id "
        "AND (id = ANY(%s) OR superseded_by = ANY(%s))",
        ([f["id"] for f in facts], [f["id"] for f in facts])).fetchall()]
    cur_ids = [f["id"] for f in facts if f["superseded_by"] is None]
    sem = None
    if req.get("want_sem"):
        sem = _sem_edges(c, cur_ids, k, min_sim)
    maxes = c.execute("SELECT (SELECT coalesce(max(id), 0) FROM facts), (SELECT coalesce(max(id), 0) FROM chunks)").fetchone()
    for ch in chunks:
        ch["label"] = _chunk_label(ch["source"], ch["content"], {"heading": ch.get("heading"), "rel": ch.get("rel"), "file": ch.get("file")})
    return {"facts": facts, "chunks": chunks, "sessions": list(sessions.values()), "supers": supers,
            "sem": sem, "alive": alive, "signature": list(sig), "cursor": {"f": maxes[0], "c": maxes[1]},
            "cur_ids": cur_ids, "incremental": inc}


# ---- memory by session: list, detail, hide / unhide / delete (Memory > Sessions)
#
# Hide keeps a row but takes it out of every read path: a fact is retracted the way
# memory_forget does it (superseded_by = id), a chunk gets chunks.hidden. Unhide undoes
# exactly that. Delete removes the rows (and with them their embeddings); a deleted chunk
# leaves a tombstone (its content_hash) so ingest never re-creates it, and a deleted session
# is written to excluded_sessions so ingest never indexes it again. Every write is scoped
# to one session: ids that are not that session's are ignored, never acted on.

FACT_STATUS = {
    "active": "superseded_by IS NULL",
    "hidden": "superseded_by = id",
    "superseded": "superseded_by IS NOT NULL AND superseded_by <> id",
}


def like_any(s):
    return "%" + s.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%"


def mm_sessions(c, req):
    one = req.get("session")
    cw, fw, args = "", "", []
    if one:
        cw, fw, args = " AND session_id = %s", " AND source_session = %s", [one]
    out = {}
    for r in rows(c,
            "SELECT session_id, min(ts) AS first, max(ts) AS last, count(*) AS chunks, "
            "count(*) FILTER (WHERE " + hid(c) + ") AS chunks_hidden, "
            "count(*) FILTER (WHERE role = 'summary') AS summaries, "
            "mode() WITHIN GROUP (ORDER BY project) AS project, "
            "mode() WITHIN GROUP (ORDER BY machine) AS machine, "
            "(array_agg(meta->>'title' ORDER BY ts DESC) FILTER (WHERE meta ? 'title'))[1] AS title, "
            "count(DISTINCT meta->>'subagent_id') AS subagents "
            "FROM chunks WHERE source = 'transcript' AND session_id IS NOT NULL" + cw +
            " GROUP BY session_id", args):
        r.update(facts=0, facts_hidden=0, facts_superseded=0, excluded=None)
        out[r["session_id"]] = r
    for r in rows(c,
            "SELECT source_session AS session_id, min(ts) AS first, max(ts) AS last, "
            "count(*) FILTER (WHERE superseded_by IS NULL) AS active, "
            "count(*) FILTER (WHERE superseded_by = id) AS hidden, "
            "count(*) FILTER (WHERE superseded_by IS NOT NULL AND superseded_by <> id) AS superseded, "
            "mode() WITHIN GROUP (ORDER BY meta->>'project') AS project "
            "FROM facts WHERE source_session IS NOT NULL" + fw + " GROUP BY 1", args):
        sid = r["session_id"]
        cur = out.get(sid)
        if cur is None:
            cur = out[sid] = {"session_id": sid, "first": r["first"], "last": r["last"], "chunks": 0,
                              "chunks_hidden": 0, "summaries": 0, "project": r["project"], "machine": None,
                              "title": None, "subagents": 0, "excluded": None}
        else:
            cur["first"] = min(cur["first"], r["first"])
            cur["last"] = max(cur["last"], r["last"])
        cur.update(facts=r["active"], facts_hidden=r["hidden"], facts_superseded=r["superseded"])
    if caps(c)["excluded"]:
        for r in rows(c, "SELECT session_id, excluded_at, excluded_by, reason, files_deleted "
                         "FROM excluded_sessions WHERE TRUE" + cw, args):
            cur = out.get(r["session_id"])
            if cur is None:
                cur = out[r["session_id"]] = {"session_id": r["session_id"], "first": None, "last": r["excluded_at"],
                                              "chunks": 0, "chunks_hidden": 0, "summaries": 0, "project": None,
                                              "machine": None, "title": None, "subagents": 0, "facts": 0,
                                              "facts_hidden": 0, "facts_superseded": 0}
            cur["excluded"] = r
    return {"sessions": list(out.values()), "caps": caps(c)}


def _fact_where(c, req, filtered):
    w, a = ["source_session = %s"], [req["session"]]
    if filtered:
        if req.get("show") == "chunks":
            w.append("FALSE")
        if req.get("q"):
            w.append("content ILIKE %s")
            a.append(like_any(req["q"]))
        if req.get("topic"):
            w.append("(topic = %s OR topic LIKE %s)")
            a += [req["topic"], like_prefix(req["topic"] + ".")]
        if req.get("status") in FACT_STATUS:
            w.append(FACT_STATUS[req["status"]])
    return " AND ".join(w), a


def _chunk_where(c, req, filtered):
    w, a = ["session_id = %s", "source = 'transcript'"], [req["session"]]
    if filtered:
        # Chunks have no topic: a topic filter is a filter on facts.
        if req.get("show") == "facts" or req.get("topic") or req.get("status") == "superseded":
            w.append("FALSE")
        if req.get("q"):
            w.append("content ILIKE %s")
            a.append(like_any(req["q"]))
        if req.get("status") == "active":
            w.append("NOT " + hid(c))
        elif req.get("status") == "hidden":
            w.append(hid(c))
    return " AND ".join(w), a


def mm_session(c, req):
    sid = req["session"]
    fw, fa = _fact_where(c, req, True)
    cw, ca = _chunk_where(c, req, True)
    lim, off = int(req.get("limit", 50)), int(req.get("offset", 0))
    flim = int(req.get("fact_limit", 300))
    facts = rows(c, "SELECT id, topic, ts, superseded_by, meta->>'kind' AS kind, meta->>'forgotten' AS forgotten, "
                    "left(content, 400) AS content, length(content) AS chars FROM facts WHERE " + fw +
                 " ORDER BY ts DESC, id DESC LIMIT %s", fa + [flim])
    chunks = rows(c, "SELECT id, role, ts, turn_index, " + hid(c) + " AS hidden, left(content, 320) AS content, "
                     "length(content) AS chars, meta->>'agent_type' AS agent_type, "
                     "meta->>'subagent_id' AS subagent_id FROM chunks WHERE " + cw +
                  " ORDER BY turn_index NULLS LAST, ts, id LIMIT %s OFFSET %s", ca + [lim, off])
    nf = c.execute("SELECT count(*) FROM facts WHERE " + fw, fa).fetchone()[0]
    nc = c.execute("SELECT count(*) FROM chunks WHERE " + cw, ca).fetchone()[0]
    topics = rows(c, "SELECT topic, count(*) AS n FROM facts WHERE source_session = %s AND topic IS NOT NULL "
                     "GROUP BY topic ORDER BY count(*) DESC, topic LIMIT 300", (sid,))
    return {"facts": facts, "facts_total": nf, "chunks": chunks, "chunks_total": nc, "topics": topics,
            "caps": caps(c)}


def _ids(v):
    out = []
    for x in v or []:
        try:
            n = int(x)
        except (TypeError, ValueError):
            continue
        if 0 < n < 2 ** 62:
            out.append(n)
    return sorted(set(out))[:20000]


def _resolve(c, req):
    """(fact ids, chunk ids) the request means, always inside its one session."""
    scope = req.get("scope")
    if scope == "items":
        fw, fa = _fact_where(c, req, False)
        cw, ca = _chunk_where(c, req, False)
        f = [r[0] for r in c.execute("SELECT id FROM facts WHERE " + fw + " AND id = ANY(%s)",
                                     fa + [_ids(req.get("facts"))]).fetchall()]
        ch = [r[0] for r in c.execute("SELECT id FROM chunks WHERE " + cw + " AND id = ANY(%s)",
                                      ca + [_ids(req.get("chunks"))]).fetchall()]
    elif scope in ("filtered", "session"):
        filt = scope == "filtered"
        fw, fa = _fact_where(c, req, filt)
        cw, ca = _chunk_where(c, req, filt)
        f = [r[0] for r in c.execute("SELECT id FROM facts WHERE " + fw, fa).fetchall()]
        ch = [r[0] for r in c.execute("SELECT id FROM chunks WHERE " + cw, ca).fetchall()]
    else:
        raise ValueError("unknown scope")
    return sorted(f), sorted(ch)


def _breakdown(c, f, ch):
    fs = c.execute("SELECT count(*) FILTER (WHERE superseded_by IS NULL), count(*) FILTER (WHERE superseded_by = id), "
                   "count(*) FILTER (WHERE superseded_by IS NOT NULL AND superseded_by <> id) "
                   "FROM facts WHERE id = ANY(%s)", (f,)).fetchone()
    cs = c.execute("SELECT count(*) FILTER (WHERE NOT " + hid(c) + "), count(*) FILTER (WHERE " + hid(c) + ") "
                   "FROM chunks WHERE id = ANY(%s)", (ch,)).fetchone()
    return {"facts": len(f), "facts_active": fs[0], "facts_hidden": fs[1], "facts_superseded": fs[2],
            "chunks": len(ch), "chunks_active": cs[0], "chunks_hidden": cs[1]}


def mm_preview(c, req):
    f, ch = _resolve(c, req)
    return _breakdown(c, f, ch)


def _need_caps(c):
    k = caps(c)
    if not (k["hidden"] and k["excluded"] and k["tombstones"]):
        raise ValueError("the memory database has not been migrated for memory management yet "
                         "(deploy/claude-memory-manage/install.sh)")


def _delete_facts(c, ids, actor):
    """Delete facts and keep the supersession chains honest.

    facts.superseded_by is ON DELETE SET NULL, so deleting a newer version would silently
    make every older version current again. Instead an older version is re-pointed at the
    nearest surviving newer one, or, when none survives, hidden (retracted) with a note.
    """
    ids = sorted(set(ids))
    if not ids:
        return {"deleted": 0, "repointed": 0, "hidden_older": 0}
    nxt = dict(c.execute("SELECT id, superseded_by FROM facts WHERE id = ANY(%s)", (ids,)).fetchall())
    gone = set(nxt)

    def survivor(t):
        seen = set()
        while t is not None and t in gone and t not in seen:
            seen.add(t)
            n = nxt.get(t)
            t = None if n is None or n == t else n
        return t

    rep = hidden_older = 0
    deps = c.execute("SELECT id, superseded_by FROM facts WHERE superseded_by = ANY(%s) AND NOT (id = ANY(%s))",
                     (list(gone), list(gone))).fetchall()
    for d, s in deps:
        t = survivor(s)
        if t is not None:
            c.execute("UPDATE facts SET superseded_by = %s WHERE id = %s", (t, d))
            rep += 1
        else:
            c.execute("UPDATE facts SET superseded_by = id, meta = meta || %s::jsonb WHERE id = %s",
                      (json.dumps({"forgotten": "its newer version #%d was deleted" % s,
                                   "forgotten_via": "dashboard", "forgotten_by": actor}), d))
            hidden_older += 1
    n = c.execute("DELETE FROM facts WHERE id = ANY(%s)", (list(gone),)).rowcount
    return {"deleted": n, "repointed": rep, "hidden_older": hidden_older}


def mm_apply(c, req):
    _need_caps(c)
    action, actor = req["action"], req["actor"]
    f, ch = _resolve(c, req)
    exp = req.get("expect")
    if isinstance(exp, dict) and (int(exp.get("facts", -1)) != len(f) or int(exp.get("chunks", -1)) != len(ch)):
        raise ValueError("the selection changed since it was confirmed (now %d facts and %d chunks); "
                         "review it again" % (len(f), len(ch)))
    out = {"action": action, "facts_selected": len(f), "chunks_selected": len(ch)}
    if action == "hide":
        out["facts"] = c.execute(
            "UPDATE facts SET superseded_by = id, meta = meta || %s::jsonb "
            "WHERE id = ANY(%s) AND superseded_by IS NULL",
            (json.dumps({"forgotten": "hidden from the dashboard", "forgotten_via": "dashboard",
                         "forgotten_by": actor}), f)).rowcount
        out["chunks"] = c.execute("UPDATE chunks SET hidden = true WHERE id = ANY(%s) AND NOT hidden", (ch,)).rowcount
    elif action == "unhide":
        out["facts"] = c.execute(
            "UPDATE facts SET superseded_by = NULL, "
            "meta = (meta - 'forgotten' - 'forgotten_via' - 'forgotten_by') || %s::jsonb "
            "WHERE id = ANY(%s) AND superseded_by = id",
            (json.dumps({"unhidden_by": actor, "unhidden_via": "dashboard"}), f)).rowcount
        out["chunks"] = c.execute("UPDATE chunks SET hidden = false WHERE id = ANY(%s) AND hidden", (ch,)).rowcount
    elif action == "delete":
        d = _delete_facts(c, f, actor)
        c.execute("INSERT INTO memory_tombstones (content_hash, session_id, deleted_by) "
                  "SELECT content_hash, session_id, %s FROM chunks WHERE id = ANY(%s) "
                  "ON CONFLICT (content_hash) DO NOTHING", (actor, ch))
        out["chunks"] = c.execute("DELETE FROM chunks WHERE id = ANY(%s)", (ch,)).rowcount
        out["facts"] = d["deleted"]
        out["repointed"], out["hidden_older"] = d["repointed"], d["hidden_older"]
    else:
        raise ValueError("unknown action")
    c.commit()
    return out


def _facts_lock_key(sid):
    import hashlib
    return int.from_bytes(hashlib.sha1(("claude-memory-facts:" + sid).encode()).digest()[:8], "big", signed=True)


def mm_delete_session(c, req):
    """Everything one session left in memory, permanently, and keep ingest from bringing it back."""
    _need_caps(c)
    sid, actor = req["session"], req["actor"]
    paths = [r[0] for r in c.execute(
        "SELECT file_path FROM ingest_state WHERE file_path LIKE %s OR file_path LIKE %s",
        ("%/" + sid + ".jsonl", "%/" + sid + "/%")).fetchall()]
    # An ingest or a fact extraction running on this session right now holds these locks.
    for key in [D.lock_key(p) for p in paths] + [_facts_lock_key(sid)]:
        if not c.execute("SELECT pg_try_advisory_xact_lock(%s)", (key,)).fetchone()[0]:
            raise ValueError("this session is being indexed right now; try again in a minute")
    fids = [r[0] for r in c.execute("SELECT id FROM facts WHERE source_session = %s", (sid,)).fetchall()]
    d = _delete_facts(c, fids, actor)
    n_chunks = c.execute("DELETE FROM chunks WHERE session_id = %s", (sid,)).rowcount
    c.execute("DELETE FROM memory_tombstones WHERE session_id = %s", (sid,))
    n_state = c.execute("DELETE FROM ingest_state WHERE file_path = ANY(%s) OR file_path = %s",
                        (paths, "facts:" + sid)).rowcount
    c.execute("INSERT INTO excluded_sessions (session_id, excluded_by, reason, files_deleted) "
              "VALUES (%s, %s, 'deleted from the dashboard', %s) ON CONFLICT (session_id) DO UPDATE SET "
              "excluded_at = now(), excluded_by = EXCLUDED.excluded_by, reason = EXCLUDED.reason, "
              "files_deleted = excluded_sessions.files_deleted OR EXCLUDED.files_deleted",
              (sid, actor, bool(req.get("files_deleted"))))
    c.commit()
    return {"facts": d["deleted"], "repointed": d["repointed"], "hidden_older": d["hidden_older"],
            "chunks": n_chunks, "ingest_state": n_state}


def mm_reindex(c, req):
    """Lift a deleted session's exclusion: the next ingest indexes its transcript, if any is left."""
    _need_caps(c)
    n = c.execute("DELETE FROM excluded_sessions WHERE session_id = %s", (req["session"],)).rowcount
    c.commit()
    return {"lifted": n}


