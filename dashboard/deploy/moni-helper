def cc_fact_fields(payload):
    content = cc_text(payload.get("content"), "Content", 4000)
    topic = cc_text(payload.get("topic"), "Topic", 121, single_line=True)
    if not CC_TOPIC_RE.match(topic):
        raise CCError("topic must be dotted words: letters, digits, _ . -")
    kind = str(payload.get("kind") or "fact")
    if kind not in CC_KINDS:
        raise CCError("kind must be one of " + ", ".join(CC_KINDS))
    return content, topic, kind


def cc_fact_add(payload):
    actor = cc_actor(payload)
    content, topic, kind = cc_fact_fields(payload)
    project = str(payload.get("project") or "")
    if project and not CC_PROJECT_RE.match(project):
        raise CCError("bad project name")
    res = cc_bridge("fact_add", content=content, topic=topic, kind=kind, project=project,
                    actor=actor)
    audit("cc-fact-add", {"by": actor, "fact": res.get("id"), "topic": topic})
    return res


def cc_fact_edit(payload):
    actor = cc_actor(payload)
