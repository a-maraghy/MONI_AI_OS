# /etc/systemd/system/moni-whatsapp@.service
#
# One instance per WhatsApp channel: `systemctl start moni-whatsapp@support`.
# Everything instance-specific is in /opt/moni-agents/channels/%i, written by
# the dashboard through moni-helper.

[Unit]
Description=MONI WhatsApp channel %i
Documentation=https://github.com/a-maraghy/MONI_AI_OS
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=moniagent
Group=moniagent
WorkingDirectory=/opt/moni-agents/whatsapp

Environment=HOME=/opt/moni-agents/shared/home
Environment=PATH=/opt/moni-agents/runtime/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production

# The Claude credential, shared with every agent.
EnvironmentFile=-/opt/moni-agents/shared/claude-auth.env
# Channel identity, allowed numbers and add-on switches.
EnvironmentFile=/opt/moni-agents/channels/%i/bridge.env

ExecStart=/usr/bin/node /opt/moni-agents/whatsapp/bridge.mjs

Restart=always
RestartSec=10
MemoryMax=4G
TasksMax=512

# Same posture as the agent unit: this process runs model-authored commands.
# It needs write access to the channel directory (session credentials) and to
# the agent's vault (attachments and memory), and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/moni-agents/channels/%i /opt/moni-agents/agents /opt/moni-agents/shared
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=moni-whatsapp-%i

[Install]
WantedBy=multi-user.target
