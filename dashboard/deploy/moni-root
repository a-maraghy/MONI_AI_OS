#!/usr/bin/env python3
"""Brokered root execution for the server-operator agent.

The operator agent is allowed to run anything on this machine. What it is not
allowed to do is decide, on its own, that it should. Everything here exists to
keep those two facts apart.

    agent                    moni-root (root)              administrator
      |                            |                             |
      |-- propose(cmd, why) ------>|                             |
      |<-- ticket id --------------|                             |
      |                            |                             |
      |                    (bot shows the ticket) --------------->|
      |                            |<-- approve(id, 6-digit code)-|
      |                            |  verify TOTP, then execute   |
      |<-- result -----------------|                             |

Approval is a code from the authenticator app of a named panel user -- the same
one they sign in to the dashboard with. Not a shared passphrase: a passphrase is
a standing secret that has to be stored, typed repeatedly into a chat, and
remembered by whoever might need it, and one that leaks stays leaked. A TOTP
code is single-use, expires in seconds, and proves possession of the phone that
enrolled rather than knowledge of a string.

Four properties hold this together, and each is enforced here rather than asked
for in a prompt:

  1. The agent can only PROPOSE. `propose` never executes anything; it writes a
     ticket and returns an id. Execution happens in `approve`.

  2. The code is verified inside this program, as root, against the TOTP secret
     in the panel's own user database -- a file the agent account cannot read.
     So the agent cannot compute a valid code, and cannot test guesses offline.

  3. Every accepted code is burned. A code already used cannot be replayed
     inside its own validity window, which is what makes it safe for the code
     to travel through a chat message at all.

  4. Approval is bound to the exact command proposed. The ticket stores an HMAC
     of the command; `approve` recomputes it. A ticket cannot be approved and
     then quietly pointed at a different command.

Tickets are single-use and expire. Failed codes are counted and lock the broker
for a while, because the agent -- or anything that has taken it over -- can call
this in a loop, and six digits do not survive an unthrottled loop.

Invoked only through one sudoers rule:

    moniagent ALL=(root) NOPASSWD: /usr/local/sbin/moni-root

Never give the agent account any other sudo entitlement. Every guarantee above
disappears the moment it can run something else as root.
"""

import base64
import errno
import fcntl
import hashlib
import hmac
import json
import os
import re
import secrets
import sqlite3
import struct
import shlex
import subprocess
import sys
import time
import uuid

STATE_DIR = "/var/lib/moni-root"
APPROVER_FILE = os.path.join(STATE_DIR, "approver")      # 0600 root:root
TICKET_KEY_FILE = os.path.join(STATE_DIR, "ticket.key")  # 0600 root:root
TICKET_DIR = os.path.join(STATE_DIR, "tickets")          # 0700 root:root
LOCK_FILE = os.path.join(STATE_DIR, "lock")
ATTEMPT_FILE = os.path.join(STATE_DIR, "attempts")
BURNED_FILE = os.path.join(STATE_DIR, "burned")
AUDIT_LOG = "/var/log/moni-root.log"

# The panel's user database. Read here, as root, and never copied: the approver's
# authenticator secret must always be the one they are actually using, so that
# resetting their two-factor in the panel takes effect on the next approval
# rather than leaving a stale copy that still works.
PANEL_DB = os.environ.get("MONI_DASHBOARD_DB", "/var/lib/moni-dashboard/moni.db")

# A ticket is meant to be approved while the administrator is looking at it. An
# hour-old proposal is not something anyone still has in mind.
TICKET_TTL_SECONDS = 900
MAX_PENDING = 20

# Wrong codes are rate limited hard. Six digits is a million possibilities, but
# a caller that can loop uncontested gets through a million in far less time
# than a code stays valid, so the limit is what makes the length sufficient.
MAX_ATTEMPTS = 5
LOCKOUT_SECONDS = 900

# TOTP, RFC 6238: SHA1, 30-second steps, six digits -- the parameters every
# authenticator app assumes, and the ones the panel enrols with.
TOTP_STEP = 30
TOTP_DIGITS = 6
# One step either side, so a code is accepted for about ninety seconds. Wide
# enough for a phone with a drifting clock and a person typing; narrow enough
# that a code read over someone's shoulder is stale before it is useful.
TOTP_WINDOW = 1
# Burned codes are kept a little longer than they can possibly be accepted, so
# the replay check cannot be beaten by waiting.
BURN_RETENTION = TOTP_STEP * (TOTP_WINDOW * 2 + 4)

TICKET_ID_RE = re.compile(r"^[0-9a-f]{32}$")


def die(msg, code=1):
    json.dump({"ok": False, "error": msg}, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(code)


def ok(payload):
    out = {"ok": True}
    out.update(payload)
    json.dump(out, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(0)


def audit(event, **fields):
    """Append-only record of every proposal, approval and refusal.

    Written as root to a file the agent cannot modify. If the agent is ever
    compromised, this is the only account of what it tried.
    """
    line = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "event": event}
    line.update(fields)
    try:
        fd = os.open(AUDIT_LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as fh:
            fh.write(json.dumps(line, sort_keys=True) + "\n")
    except OSError:
        pass


def ensure_state():
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    os.makedirs(TICKET_DIR, mode=0o700, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    os.chmod(TICKET_DIR, 0o700)


class Lock:
    """Serialise attempt counting and ticket consumption across processes."""

    def __enter__(self):
        self.fd = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o600)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)


# ---------------------------------------------------------------- approver ---


def read_approver():
    """The panel user whose authenticator approves root actions."""
    try:
        with open(APPROVER_FILE) as fh:
            record = json.load(fh)
    except (OSError, ValueError):
        return None
    return record if record.get("username") else None


def approver_secret(username):
    """That user's TOTP secret, read live from the panel's database.

    Read rather than copied on purpose. If the approver loses their phone and
    an administrator resets their two-factor in the panel, the new secret has
    to take effect immediately -- a copy taken when the binding was made would
    keep honouring the authenticator they no longer control.

    Opened read-only. This program has no business writing to the panel's data,
    and read-only means a bug here cannot corrupt the account table.
    """
    try:
        uri = "file:" + PANEL_DB + "?mode=ro"
        conn = sqlite3.connect(uri, uri=True, timeout=5)
    except sqlite3.Error:
        return None
    try:
        row = conn.execute(
            "SELECT totp_secret, totp_confirmed, disabled FROM users WHERE username = ?",
            (username,),
        ).fetchone()
    except sqlite3.Error:
        return None
    finally:
        conn.close()

    if not row:
        return None
    secret, confirmed, disabled = row
    # A disabled account cannot sign in to the panel; it must not be able to
    # approve a root command either. An unenrolled one has no usable secret.
    if disabled or not confirmed or not secret:
        return None
    return secret


# -------------------------------------------------------------------- TOTP ---


def totp_candidates(secret_b32, at):
    """Every code valid at `at`, mapped to the time step that produced it.

    Implemented here rather than pulled from a library: it is twenty lines of
    RFC 6238, and this program runs as root through sudo, where every import is
    a file somebody else might one day be able to write.
    """
    padded = secret_b32.strip().replace(" ", "").upper()
    padded += "=" * ((8 - len(padded) % 8) % 8)
    try:
        key = base64.b32decode(padded)
    except Exception:
        return {}

    out = {}
    current = int(at // TOTP_STEP)
    for drift in range(-TOTP_WINDOW, TOTP_WINDOW + 1):
        counter = current + drift
        digest = hmac.new(key, struct.pack(">Q", counter), hashlib.sha1).digest()
        offset = digest[-1] & 0x0F
        code = struct.unpack(">I", digest[offset : offset + 4])[0] & 0x7FFFFFFF
        out[str(code % (10 ** TOTP_DIGITS)).zfill(TOTP_DIGITS)] = counter
    return out


def verify_totp(secret, supplied):
    """Return the time step a code belongs to, or None.

    Compared with compare_digest against every candidate rather than by
    dictionary lookup, so the time taken does not depend on how nearly right
    the guess was.
    """
    supplied = "".join(ch for ch in str(supplied) if ch.isdigit())
    if len(supplied) != TOTP_DIGITS:
        return None
    matched = None
    for code, counter in totp_candidates(secret, time.time()).items():
        if hmac.compare_digest(code, supplied):
            matched = counter
    return matched


def burned_steps():
    try:
        with open(BURNED_FILE) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return {}
    cutoff = time.time() - BURN_RETENTION
    return {k: v for k, v in data.items() if v > cutoff}


def burn_step(username, counter):
    """Record a code as spent so it cannot be replayed while still valid.

    Without this, a code is a bearer token for its whole window -- and it
    travels through a chat message, which is exactly where something might be
    watching. Burning it makes the window irrelevant.
    """
    data = burned_steps()
    data[username + ":" + str(counter)] = time.time()
    tmp = BURNED_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh)
    os.chmod(tmp, 0o600)
    os.replace(tmp, BURNED_FILE)


def is_burned(username, counter):
    return (username + ":" + str(counter)) in burned_steps()


def ticket_key():
    """Key for the ticket HMAC.

    A random key of its own, rotated whenever the approver binding changes, so
    that re-pointing approvals at a different person invalidates every proposal
    that was waiting for the previous one.
    """
    try:
        with open(TICKET_KEY_FILE, "rb") as fh:
            key = fh.read()
            if len(key) == 32:
                return key
    except OSError:
        pass
    key = secrets.token_bytes(32)
    fd = os.open(TICKET_KEY_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as fh:
        fh.write(key)
    return key


def rotate_ticket_key():
    try:
        os.unlink(TICKET_KEY_FILE)
    except OSError as e:
        if e.errno != errno.ENOENT:
            raise
    ticket_key()


# ---------------------------------------------------------------- lockout ---


def attempts_state():
    try:
        with open(ATTEMPT_FILE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {"count": 0, "locked_until": 0}


def write_attempts(state):
    tmp = ATTEMPT_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(state, fh)
    os.chmod(tmp, 0o600)
    os.replace(tmp, ATTEMPT_FILE)


def check_lockout():
    state = attempts_state()
    remaining = int(state.get("locked_until", 0) - time.time())
    if remaining > 0:
        audit("locked_out", remaining=remaining)
        die(
            "too many failed passphrase attempts; locked for another "
            + str(remaining // 60 + 1)
            + " minute(s)"
        )


def record_failure():
    state = attempts_state()
    state["count"] = int(state.get("count", 0)) + 1
    if state["count"] >= MAX_ATTEMPTS:
        state["locked_until"] = time.time() + LOCKOUT_SECONDS
        state["count"] = 0
    write_attempts(state)


def clear_failures():
    write_attempts({"count": 0, "locked_until": 0})


# ---------------------------------------------------------------- tickets ---


def prune_tickets():
    now = time.time()
    kept = []
    for name in sorted(os.listdir(TICKET_DIR)):
        path = os.path.join(TICKET_DIR, name)
        try:
            with open(path) as fh:
                ticket = json.load(fh)
        except (OSError, ValueError):
            os.unlink(path)
            continue
        if ticket.get("expires_at", 0) < now:
            os.unlink(path)
        else:
            kept.append(ticket)
    return kept


def ticket_path(ticket_id):
    # Belt and braces: the id is validated as 32 hex characters before it ever
    # reaches a path join, so a "../" can never appear here.
    if not TICKET_ID_RE.match(ticket_id or ""):
        die("malformed ticket id")
    return os.path.join(TICKET_DIR, ticket_id + ".json")


# --------------------------------------------------------------- commands ---


def cmd_status(args):
    approver = read_approver()
    username = (approver or {}).get("username", "")
    # "Bound" is not the same as "usable": the account may since have been
    # disabled, deleted, or had its two-factor reset without re-enrolling. The
    # panel needs to be able to say which, so both are reported.
    usable = bool(username) and bool(approver_secret(username))
    state = attempts_state()
    with Lock():
        pending = prune_tickets()
    ok(
        {
            "configured": usable,
            "approver": username,
            "approver_usable": usable,
            "pending": len(pending),
            "locked_for": max(0, int(state.get("locked_until", 0) - time.time())),
        }
    )


def cmd_set_approver(args):
    """Name the panel user whose authenticator approves root actions.

    The user must exist, be enabled, and have finished two-factor enrolment --
    checked here rather than trusted from the caller, because binding approvals
    to an account that cannot produce a code would disable root actions in a way
    that only shows up when somebody urgently needs one.
    """
    username = (args.get("username") or "").strip()
    if not username:
        die("no username given")
    if not re.match(r"^[A-Za-z0-9._-]{3,32}$", username):
        die("that is not a valid username")
    if not approver_secret(username):
        die(
            "that account cannot approve: it does not exist, is disabled, or has "
            "not finished authenticator enrolment"
        )

    tmp = APPROVER_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump({"username": username, "bound_at": time.time()}, fh)
    os.chmod(tmp, 0o600)
    os.replace(tmp, APPROVER_FILE)

    # Re-pointing approvals at somebody else revokes everything the previous
    # approver had waiting: those proposals were shown to a different person.
    with Lock():
        for name in os.listdir(TICKET_DIR):
            os.unlink(os.path.join(TICKET_DIR, name))
        rotate_ticket_key()
        clear_failures()
    audit("approver_set", username=username)
    ok({"configured": True, "approver": username})


def cmd_clear_approver(args):
    """Unbind the approver, which disables root execution entirely."""
    try:
        os.unlink(APPROVER_FILE)
    except OSError as e:
        if e.errno != errno.ENOENT:
            raise
    with Lock():
        for name in os.listdir(TICKET_DIR):
            os.unlink(os.path.join(TICKET_DIR, name))
        rotate_ticket_key()
    audit("approver_cleared")
    ok({"configured": False})


def cmd_propose(args):
    """Record a request to run something as root. Executes nothing.

    Called by the agent. The reason is stored alongside the command so the
    administrator approves a described action rather than a bare shell line.
    """
    approver = read_approver()
    if not approver or not approver_secret(approver["username"]):
        die("no approver is configured; root actions are disabled")

    command = sys.stdin.read()
    if not command.strip():
        die("empty command")
    if len(command) > 4000:
        die("command is too long")

    reason = (args.get("reason") or "").strip()
    if not reason:
        die("a reason is required: the administrator approves a description, not a shell line")
    if len(reason) > 2000:
        die("reason is too long")

    requested_by = (args.get("requested-by") or "").strip()[:64]

    with Lock():
        pending = prune_tickets()
        if len(pending) >= MAX_PENDING:
            die("too many proposals are already waiting for approval")

        ticket_id = uuid.uuid4().hex
        now = time.time()
        ticket = {
            "id": ticket_id,
            "command": command,
            "reason": reason,
            "requested_by": requested_by,
            "created_at": now,
            "expires_at": now + TICKET_TTL_SECONDS,
            # Binds the approval to this exact command. approve() recomputes it
            # from the stored command, so a tampered ticket file fails closed.
            "mac": hmac.new(
                ticket_key(), command.encode(), hashlib.sha256
            ).hexdigest(),
        }
        path = ticket_path(ticket_id)
        with open(path, "w") as fh:
            json.dump(ticket, fh)
        os.chmod(path, 0o600)

    audit(
        "proposed",
        ticket=ticket_id,
        requested_by=requested_by,
        reason=reason[:200],
        command=command[:500],
    )
    ok(
        {
            "ticket": ticket_id,
            "expires_in": TICKET_TTL_SECONDS,
            "command": command,
            "reason": reason,
        }
    )


def cmd_show(args):
    """Read back a pending ticket so the bot can render it for approval."""
    with Lock():
        prune_tickets()
        path = ticket_path(args.get("ticket"))
        try:
            with open(path) as fh:
                ticket = json.load(fh)
        except (OSError, ValueError):
            die("no such proposal, or it has expired")
    ok(
        {
            "ticket": ticket["id"],
            "command": ticket["command"],
            "reason": ticket["reason"],
            "requested_by": ticket.get("requested_by", ""),
            "expires_in": max(0, int(ticket["expires_at"] - time.time())),
        }
    )


def cmd_pending(args):
    """List proposals waiting for approval.

    The bot calls this after a privileged turn and shows what came back. It is
    how a proposal reaches a human at all -- the agent's own account of what it
    did is not trusted to be complete.
    """
    with Lock():
        tickets = prune_tickets()
    now = time.time()
    ok(
        {
            "pending": [
                {
                    "ticket": t["id"],
                    "command": t["command"],
                    "reason": t["reason"],
                    "requested_by": t.get("requested_by", ""),
                    "expires_in": max(0, int(t["expires_at"] - now)),
                }
                for t in sorted(tickets, key=lambda t: t["created_at"])
            ]
        }
    )


def cmd_approve(args):
    """Verify an authenticator code and run the proposed command as root.

    The code arrives on stdin from the bot's transport layer. It must never have
    passed through the model: the point of the whole mechanism is that approval
    comes from a person, and a code the model has read is a code the model can
    replay inside its window. Burning the code closes that window too, but the
    first defence is that the model never sees it.
    """
    check_lockout()

    approver = read_approver()
    if not approver:
        die("no approver is configured; root actions are disabled")
    username = approver["username"]
    secret = approver_secret(username)
    if not secret:
        die(
            "the approver's account can no longer produce a code: it has been "
            "disabled, removed, or had its authenticator reset"
        )

    code = sys.stdin.read().strip()
    if not code:
        die("no code supplied")

    with Lock():
        prune_tickets()
        path = ticket_path(args.get("ticket"))
        try:
            with open(path) as fh:
                ticket = json.load(fh)
        except (OSError, ValueError):
            die("no such proposal, or it has expired")

        counter = verify_totp(secret, code)
        if counter is None:
            record_failure()
            audit("approval_rejected", ticket=ticket["id"], reason="bad code")
            die("that code is not valid — check the app and try the next one")

        # A code is a bearer token for its whole window, and this one travelled
        # through a chat. Spending it here is what stops it being spent twice.
        if is_burned(username, counter):
            record_failure()
            audit("approval_rejected", ticket=ticket["id"], reason="code reused")
            die("that code has already been used — wait for the next one")
        burn_step(username, counter)

        expected = hmac.new(
            ticket_key(), ticket["command"].encode(), hashlib.sha256
        ).hexdigest()
        if not hmac.compare_digest(expected, ticket.get("mac", "")):
            os.unlink(path)
            audit("approval_rejected", ticket=ticket["id"], reason="ticket tampered")
            die("this proposal has been altered since it was made; it has been discarded")

        # Single use. Consumed before running, so a command that hangs or
        # crashes cannot be approved a second time by retrying.
        os.unlink(path)
        clear_failures()

    audit(
        "approved",
        ticket=ticket["id"],
        approver=username,
        requested_by=ticket.get("requested_by", ""),
        command=ticket["command"][:500],
    )

    timeout = 900
    try:
        proc = subprocess.run(
            ["/bin/bash", "-lc", ticket["command"]],
            capture_output=True,
            text=True,
            timeout=timeout,
            cwd="/",
            env={
                "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                "HOME": "/root",
                "TERM": "dumb",
                "DEBIAN_FRONTEND": "noninteractive",
            },
        )
    except subprocess.TimeoutExpired:
        audit("execution_timeout", ticket=ticket["id"])
        die("command timed out after " + str(timeout) + " seconds")

    audit("executed", ticket=ticket["id"], exit_code=proc.returncode)
    ok(
        {
            "ticket": ticket["id"],
            "exit_code": proc.returncode,
            "stdout": proc.stdout[-20000:],
            "stderr": proc.stderr[-20000:],
        }
    )


def cmd_deny(args):
    """Discard a proposal. Needs no passphrase -- refusing is always allowed."""
    with Lock():
        path = ticket_path(args.get("ticket"))
        try:
            os.unlink(path)
        except OSError:
            die("no such proposal, or it has expired")
    audit("denied", ticket=args.get("ticket"))
    ok({"denied": args.get("ticket")})


def cmd_audit(args):
    """Tail the audit log for the panel."""
    try:
        limit = min(500, max(1, int(args.get("lines") or 100)))
    except ValueError:
        limit = 100
    try:
        with open(AUDIT_LOG) as fh:
            lines = fh.readlines()[-limit:]
    except OSError:
        lines = []
    entries = []
    for line in lines:
        try:
            entries.append(json.loads(line))
        except ValueError:
            continue
    ok({"entries": entries})


COMMANDS = {
    "status": cmd_status,
    "set-approver": cmd_set_approver,
    "clear-approver": cmd_clear_approver,
    "propose": cmd_propose,
    "pending": cmd_pending,
    "show": cmd_show,
    "approve": cmd_approve,
    "deny": cmd_deny,
    "audit": cmd_audit,
}

# Only the operator agent may propose; only the panel may change the
# passphrase. Both arrive as root through sudo, so the separation is by
# sudoers rule, and this list documents which is which.
AGENT_COMMANDS = {"propose", "pending", "show", "approve", "deny", "status"}


def parse_args(argv):
    """--key value pairs. No shell metacharacters reach a shell from here."""
    args = {}
    i = 0
    while i < len(argv):
        token = argv[i]
        if not token.startswith("--"):
            die("unexpected argument: " + shlex.quote(token))
        key = token[2:]
        if i + 1 >= len(argv):
            die("missing value for --" + key)
        args[key] = argv[i + 1]
        i += 2
    return args


def main():
    if os.geteuid() != 0:
        die("moni-root must run as root (through its sudoers rule)")
    if len(sys.argv) < 2:
        die("usage: moni-root <" + "|".join(sorted(COMMANDS)) + "> [--key value]")

    name = sys.argv[1]
    handler = COMMANDS.get(name)
    if not handler:
        die("unknown subcommand; allowed: " + ", ".join(sorted(COMMANDS)))

    ensure_state()
    handler(parse_args(sys.argv[2:]))


if __name__ == "__main__":
    main()
