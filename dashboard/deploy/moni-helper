# ----------------------------------------------------------- memory graph --
#
# An agent's vault as a graph: one node per note, typed by its folder (or its
# frontmatter `type:`), [[wikilinks]] and #tags as links, and "related by
# meaning" links from the agent's own vector index. Read-only throughout: the
# vault is walked as root, and the index is opened read-only as the agent
# account inside the agent runtime (which is where sqlite-vec lives).

AGENT_GRAPH_MAX_NOTES = 1500
AGENT_GRAPH_K = 3
AGENT_GRAPH_MIN_SIM = 0.6
AGENT_GRAPH_SKIP = {".obsidian", ".git", ".trash", ".claude", "node_modules"}
AGENT_NOTE_TYPES = {
    "people": "people", "person": "people", "contacts": "people",
    "decisions": "decision", "decision": "decision",
    "figures": "figure", "figure": "figure", "numbers": "figure",
    "traps": "trap", "trap": "trap", "gotchas": "trap",
    "runs": "run", "run": "run",
    "conversations": "conversation", "conversation": "conversation", "chats": "conversation", "calls": "call",
    "research": "research", "reports": "report", "report": "report", "outputs": "output", "output": "output",
    "preferences": "preference", "preference": "preference", "goals": "goal", "goal": "goal",
    "patterns": "pattern", "work-patterns": "pattern", "topics": "topic", "topic": "topic",
    "attachments": "file", "files": "file", "uploads": "file", "documents": "document", "docs": "document",
    "glossary": "document", "projects": "project",
}
WIKILINK_RE = re.compile(r"\[\[([^\]\|#\n]{1,160})(?:#[^\]\|\n]*)?(?:\|[^\]\n]*)?\]\]")
TAG_RE = re.compile(r"(?:^|\s)#([A-Za-z؀-ۿ][\w؀-ۿ/\-]{1,40})")
FRONT_RE = re.compile(r"\A---\s*\n(.*?)\n---\s*\n", re.S)


def note_frontmatter(text):
    m = FRONT_RE.match(text)
    if not m:
        return {}, text
    meta = {}
    for line in m.group(1).splitlines():
        if ":" in line and not line.startswith((" ", "\t", "-")):
            k, v = line.split(":", 1)
            meta[k.strip().lower()] = v.strip().strip("'\"")
        elif line.strip().startswith("- ") and meta.get("_last") == "tags":
            meta.setdefault("tags_list", []).append(line.strip()[2:].strip())
        if ":" in line and not line.startswith((" ", "\t", "-")):
            meta["_last"] = line.split(":", 1)[0].strip().lower()
    return meta, text[m.end():]


def note_type(rel, meta):
    t = str(meta.get("type") or "").lower().strip()
    if t in AGENT_NOTE_TYPES:
        return AGENT_NOTE_TYPES[t]
    parts = rel.split("/")
    for seg in reversed(parts[:-1]):
        if seg.lower() in AGENT_NOTE_TYPES:
            return AGENT_NOTE_TYPES[seg.lower()]
    base = parts[-1].lower()
    if base in ("claude.md", "memory.md", "readme.md"):
        return "document"
    if base == "worklog.md":
        return "pattern"
    return "note"


def note_tags(meta, body):
    tags = set()
    raw = meta.get("tags") or ""
    for t in re.split(r"[,\[\]\s]+", raw):
        t = t.strip().lstrip("#")
        if t:
            tags.add(t[:40])
    for t in meta.get("tags_list") or []:
        tags.add(t.lstrip("#")[:40])
    in_code = False
    for line in body.splitlines():
        if line.strip().startswith("```"):
            in_code = not in_code
            continue
        if not in_code:
            for m in TAG_RE.finditer(line):
                tags.add(m.group(1)[:40])
    return sorted(tags)[:20]


AGENT_SEM_SNIPPET = r"""
import json, sqlite3, sys
import numpy as np
db, k, floor = sys.argv[1], int(sys.argv[2]), float(sys.argv[3])
conn = sqlite3.connect("file:" + db + "?mode=ro", uri=True)
conn.enable_load_extension(True)
import sqlite_vec
sqlite_vec.load(conn)
conn.enable_load_extension(False)
by_path = {}
for path, blob in conn.execute(
        "SELECT c.path, vec_to_json(v.embedding) FROM chunks c JOIN chunks_vec v ON v.chunk_id = c.id"):
    by_path.setdefault(path, []).append(json.loads(blob))
paths = sorted(by_path)
if len(paths) < 2:
    print(json.dumps({"edges": [], "files": len(paths)}))
    sys.exit(0)
m = np.array([np.mean(np.array(by_path[p], dtype=np.float32), axis=0) for p in paths])
m = m / np.maximum(np.linalg.norm(m, axis=1, keepdims=True), 1e-9)
sim = m @ m.T
np.fill_diagonal(sim, -1.0)
edges, seen = [], set()
for i, p in enumerate(paths):
    for j in np.argsort(-sim[i])[:k]:
        s = float(sim[i, j])
        if s < floor:
            break
        key = (min(i, j), max(i, j))
        if key in seen:
            continue
        seen.add(key)
        edges.append([p, paths[j], round(s, 3)])
print(json.dumps({"edges": edges, "files": len(paths)}))
"""


def agent_semantic_links(slug):
    """Note-to-note similarity from the agent's own index: mean chunk vectors."""
    d = agent_dir(slug)
    db = os.path.join(d, "vectors", "memory.db")
    python = os.path.join(RUNTIME_DIR, "venv", "bin", "python")
    if not os.path.exists(db):
        return [], "no vector index yet"
    if not os.path.exists(python):
        return [], "agent runtime venv is missing"
    try:
        r = subprocess.run(
            ["runuser", "-u", AGENT_USER, "--", python, "-I", "-c", AGENT_SEM_SNIPPET, db,
             str(AGENT_GRAPH_K), str(AGENT_GRAPH_MIN_SIM)],
            capture_output=True, text=True, timeout=60,
            env={"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                 "HOME": os.path.join(SHARED_DIR, "home"), "LANG": "C.UTF-8"})
    except subprocess.TimeoutExpired:
        return [], "the vector index did not answer in time"
    except OSError as exc:
        return [], "could not open the vector index: " + type(exc).__name__
    try:
        out = json.loads(r.stdout.strip().splitlines()[-1])
        return out.get("edges") or [], None
    except Exception:
        return [], (r.stderr.strip().splitlines() or ["could not read the vector index"])[-1][:200]


def agent_memory_graph(slug):
    vault = os.path.realpath(os.path.join(agent_dir(slug), "vault"))
    notes, truncated = [], False
    if os.path.isdir(vault):
        for dirpath, dirnames, filenames in os.walk(vault):
            dirnames[:] = sorted(d for d in dirnames if not d.startswith(".") and d not in AGENT_GRAPH_SKIP)
            for name in sorted(filenames):
                if not name.endswith(".md"):
                    continue
                if len(notes) >= AGENT_GRAPH_MAX_NOTES:
                    truncated = True
                    break
                full = os.path.join(dirpath, name)
                if os.path.islink(full):
                    continue
                rel = os.path.relpath(full, vault).replace(os.sep, "/")
                st = os.stat(full)
                with open(full, encoding="utf-8", errors="replace") as fh:
                    text = fh.read(64 * 1024)
                meta, body = note_frontmatter(text)
                title = meta.get("title") or ""
                if not title:
                    for line in body.splitlines():
                        if line.startswith("# "):
                            title = line[2:].strip()
                            break
                title = title or name[:-3]
                links = sorted({m.group(1).strip() for m in WIKILINK_RE.finditer(body)})[:60]
                snippet = " ".join(body.replace("#", " ").split())[:320]
                notes.append({
                    "path": rel, "title": title[:120], "type": note_type(rel, meta), "links": links,
                    "tags": note_tags(meta, body), "snippet": snippet, "bytes": st.st_size,
                    "modified": datetime.fromtimestamp(st.st_mtime, timezone.utc).isoformat(timespec="seconds"),
                })
    sem, sem_error = agent_semantic_links(slug)
    known = {n["path"] for n in notes}
    sem = [e for e in sem if e[0] in known and e[1] in known]
    return {"slug": slug, "notes": notes, "sem": sem, "sem_error": sem_error, "truncated": truncated,
            "limits": {"notes": AGENT_GRAPH_MAX_NOTES, "k": AGENT_GRAPH_K, "min_sim": AGENT_GRAPH_MIN_SIM}}


def cmd_agent_memory_graph(args):
    if len(args) != 1:
        fail("usage: agent-memory-graph <slug>")
    slug = check_slug(args[0])
    existing_agent(slug)
    ok(cc_redact_deep(agent_memory_graph(slug)))


# ============================================================== channels =====
#
# A channel is a way for messages to reach an agent: a Telegram bot, or a linked
# WhatsApp number. It is separate from the agent on purpose -- the credential
# belongs to the transport, not to the mind behind it, and the same agent should
# be able to change how people reach it without being rebuilt.
#
# Exactly one channel binds to one agent. That is not a modelling preference: the
# Telegram Bot API allows a single poller per token, so two agents sharing a
# channel would make both drop messages at random.


def channel_dir(slug):
    return os.path.join(CHANNELS_DIR, slug)


def check_channel_slug(slug):
    if not isinstance(slug, str) or not SLUG_RE.match(slug):
        fail("invalid channel name: must be lowercase letters, digits and hyphens")
    return slug


def existing_channel(slug):
    check_channel_slug(slug)
    if not os.path.isdir(channel_dir(slug)):
        fail("no such channel: " + slug)
    return channel_dir(slug)


def read_channel_json(slug):
    try:
        with open(os.path.join(channel_dir(slug), "channel.json")) as fh:
            return json.load(fh)
    except Exception:
        return {"slug": slug, "name": slug, "type": "telegram", "broken": True}


def channel_token(slug):
    path = os.path.join(channel_dir(slug), "channel.env")
    try:
        with open(path) as fh:
            for line in fh:
                if line.startswith("CHANNEL_TOKEN="):
                    return line.split("=", 1)[1].strip()
    except Exception:
        return ""
    return ""


def all_channels():
    if not os.path.isdir(CHANNELS_DIR):
        return []
    out = []
    for slug in sorted(os.listdir(CHANNELS_DIR)):
        if SLUG_RE.match(slug) and os.path.isdir(channel_dir(slug)):
            out.append(read_channel_json(slug))
    return out


def channel_bound_to(agent_slug):
    """The channel feeding this agent, with its token, or None."""
    for meta in all_channels():
        if meta.get("agent") == agent_slug:
            meta = dict(meta)
            meta["_token"] = channel_token(meta["slug"])
            return meta
    return None


def channel_summary(slug):
    meta = read_channel_json(slug)
    meta["token_set"] = bool(channel_token(slug))
    meta["dir"] = channel_dir(slug)
    if meta.get("type") == "whatsapp":
        meta["linked"] = os.path.isfile(
            os.path.join(channel_dir(slug), "session", "creds.json")
        )
    agent = meta.get("agent")
    if agent and os.path.isdir(agent_dir(agent)):
        meta["agent_state"] = unit_state(agent)
        meta["agent_name"] = read_agent_json(agent).get("name", agent)
    return meta


MAX_PRINCIPALS = 25


def normalise_principals(raw, pattern, what):
    """Clean an ordered allow-list, preserving order and dropping duplicates.

    Order carries meaning: the first entry is the administrator. Duplicates are
    removed keeping the earliest position, so promoting someone already on the
    list is just a matter of moving them to the front rather than remembering to
    delete the old entry -- and forgetting to would otherwise leave two
    candidates for "who is the administrator".
    """
    if raw is None:
        items = []
    elif isinstance(raw, (list, tuple)):
        items = [str(x) for x in raw]
    else:
        items = str(raw).replace("\n", ",").split(",")

    seen = set()
    out = []
    for item in items:
        item = item.strip().replace(" ", "")
        if not item:
            continue
        if not pattern.match(item):
            fail("not a valid " + what + ": " + repr(item[:40]))
        if item in seen:
            continue
        seen.add(item)
        out.append(item)
    if len(out) > MAX_PRINCIPALS:
        fail("at most " + str(MAX_PRINCIPALS) + " entries are allowed")
    return out


def principal_admin(channel):
    """The first entry on the allow-list, which the runtime treats as default."""
    if channel.get("type") == "telegram":
        raw = channel.get("allowed_users", "")
    else:
        raw = channel.get("allowed_numbers", "")
    parts = [p for p in str(raw).split(",") if p]
    return parts[0] if parts else ""


# ---------------------------------------------------------------- topics ----
#
# Telegram Topics: the runtime routes each forum topic to one project folder.
# Everything below mirrors what the runtime (v1.6.0) checks before it will
# start, so a configuration it would refuse is refused here, at save time, with
# a sentence -- instead of at boot, as a crash loop. The runtime's rules:
#
#   src/config/settings.py
#     - PROJECT_THREADS_MODE is "private" or "group".
#     - PROJECT_THREADS_CHAT_ID parses as an int (blank = none).
#     - PROJECTS_CONFIG_PATH, if set, exists and is a file.
#     - ENABLE_PROJECT_THREADS needs PROJECTS_CONFIG_PATH, and group mode needs
#       PROJECT_THREADS_CHAT_ID (model validator).
#   src/config/loader.py (_validate_config): the same two again, and the
#     projects file exists; APPROVED_DIRECTORY readable.
#   src/projects/registry.py (load_project_registry, called by main at start):
#     - the file is a YAML mapping with a non-empty `projects` list;
#     - each entry is a mapping with non-blank slug, name and path;
#     - path is relative, resolves (symlinks followed) inside
#       APPROVED_DIRECTORY, and is an existing directory;
#     - slugs, names and paths (as written) are each unique.
#   src/main.py + src/projects/thread_manager.py (group mode only): at start
#     the bot creates/reuses one forum topic per enabled project in the group.
#     A chat that is not a forum ("chat is not a forum", "topics are not
#     enabled", ...) raises out of startup and the process exits: an ordinary
#     group, whose id does not start with -100, can never hold topics. Any
#     other Telegram error only counts as a failed topic and the bot runs on,
#     unable to route anything -- which agent_start_check treats as a failure.
#
# Private mode does no Telegram call at start, so it cannot crash the bot; it
# needs Topics enabled for the bot in @BotFather to be of any use.

PROJECTS_FILE = "projects.yaml"
TOPICS_MODES = ("group", "private")
TOPIC_SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,39}$")
# Relative to the agent's folder. No control characters, quotes or
# backslashes; "/" separates folders. Unicode letters are fine (vault folders
# are named in Obsidian).
TOPIC_PATH_RE = re.compile(r'^[^\x00-\x1f\x7f"\\]{1,200}$')
# Topics live only in supergroups, whose Bot API ids are -100 followed by the
# group's number. An ordinary group (e.g. -5597160241) becomes a supergroup,
# with a new id, when Topics are switched on in its settings.
SUPERGROUP_ID_RE = re.compile(r"^-100\d{7,13}$")
MAX_TOPIC_PROJECTS = 20
# Rows the panel may post: the 20 the panel manages plus every auto project the
# runtime made (PROJECT_THREADS_AUTO_MAX is at most 500 on the runtime side).
MAX_TOPIC_ROWS = MAX_TOPIC_PROJECTS + 500

# --- group options (2026-10-02, mavix-bot) -----------------------------------
# Where the forum's General topic goes, whether the bot answers every group
# message or only when asked, and whether new forum topics get a folder of
# their own (the runtime keeps those in projects.auto.json; see read_auto_file).
RESPOND_MODES = ("all", "mention")
TOPICS_DELETED = ("trash", "keep")
DEFAULT_TRASH_DAYS = 30
MAX_TRASH_DAYS = 3650
MAX_NAME_ALIASES = 10
MAX_ALIAS_LEN = 40
ALIAS_BAD_RE = re.compile(r"[,\x00-\x1f\x7f]")
AUTO_FILE = "projects.auto.json"
AUTO_LOCK = "projects.auto.json.lock"
AUTO_MAX = 100              # the runtime's PROJECT_THREADS_AUTO_MAX default; the helper does not write it
AUTO_DIR = "topics"         # auto folders: <vault>/topics/<slug>
AUTO_TRASH_DIR = ".trash/topics"
AUTO_FILE_MAX_BYTES = 1024 * 1024
AUTO_LOCK_TIMEOUT = 10

# The proposal for an agent with no projects list yet: one topic, for the
# agent's own folder (APPROVED_DIRECTORY, i.e. its vault), named after the
# agent. Change it here; the panel shows whatever this returns.
DEFAULT_TOPIC_PROJECT_PATH = "."


def default_topic_projects(agent_slug, agent_name=""):
    name = str(agent_name or "").strip()
    if not name or not NAME_RE.match(name):
        name = agent_slug
    return [{"slug": agent_slug, "name": name, "path": DEFAULT_TOPIC_PROJECT_PATH, "enabled": True}]


def agent_vault(slug):
    """The agent's APPROVED_DIRECTORY (render_env sets it to the vault)."""
    return os.path.join(agent_dir(slug), "vault")


class TopicError(ValueError):
    pass


def normalise_topic_projects(raw):
    """Shape-check a projects list, or fail() with the reason."""
    try:
        return parse_topic_projects(raw)
    except TopicError as e:
        fail(str(e))


def parse_topic_projects(raw):
    """Shape-check a projects list; raises TopicError. Folder checks need the agent: see check_topic_projects."""
    if raw in (None, ""):
        return []
    if isinstance(raw, str):
        try:
            raw = json.loads(raw)
        except ValueError:
            raise TopicError("Topics: the projects list is not valid JSON")
    if not isinstance(raw, list):
        raise TopicError("Topics: the projects must be a list")
    if len(raw) > MAX_TOPIC_ROWS:
        raise TopicError("Topics: at most " + str(MAX_TOPIC_PROJECTS) + " projects")
    manual = sum(1 for item in raw if not (isinstance(item, dict) and parse_flag(item.get("auto"), False)))
    if manual > MAX_TOPIC_PROJECTS:
        raise TopicError("Topics: at most " + str(MAX_TOPIC_PROJECTS) + " projects")
    out = []
    for i, item in enumerate(raw):
        n = str(i + 1)
        if not isinstance(item, dict):
            raise TopicError("Topics: project " + n + " must be an object with slug, name and path")
        slug = str(item.get("slug") or "").strip()
        name = str(item.get("name") or "").strip()
        path = str(item.get("path") or "").strip()
        if not slug:
            raise TopicError("Topics: project " + n + " needs a short name (slug)")
        if not TOPIC_SLUG_RE.match(slug):
            raise TopicError("Topics: the short name '" + slug[:40] + "' may use only lowercase letters, "
                 "digits, '-' and '_', starting with a letter or digit (at most 40)")
        if not name:
            raise TopicError("Topics: project '" + slug + "' needs a name (it becomes the topic's title)")
        if not NAME_RE.match(name):
            raise TopicError("Topics: the name of project '" + slug + "' is too long or uses a character "
                 "that is not allowed (quotes, angle brackets, backslashes)")
        if not path:
            raise TopicError("Topics: project '" + slug + "' needs a folder ('.' is the agent's own folder)")
        if not TOPIC_PATH_RE.match(path):
            raise TopicError("Topics: the folder of project '" + slug + "' contains a character that is not allowed")
        if path.startswith("/") or path.startswith("~"):
            raise TopicError("Topics: the folder of project '" + slug + "' must be relative to the agent's "
                 "folder, not an absolute path like " + path[:60])
        path = os.path.normpath(path)
        if path == ".." or path.startswith("../"):
            raise TopicError("Topics: the folder of project '" + slug + "' points outside the agent's folder")
        row = {"slug": slug, "name": name, "path": path, "enabled": parse_flag(item.get("enabled", True), True)}
        if parse_flag(item.get("auto"), False):
            # A folder the runtime made for a new forum topic (projects.auto.json),
            # shown in the panel; see fold_auto_rows for what is kept of it.
            row["auto"] = True
        out.append(row)
    return out


def parse_flag(value, default):
    """A form or JSON boolean: true/false, "1"/"0", "on"/"off", "yes"/"no"."""
    if value is None:
        return default
    if isinstance(value, str):
        v = value.strip().lower()
        if v == "":
            return default
        return v not in ("0", "false", "off", "no")
    return bool(value)


def parse_aliases(raw):
    """The names that count as asking the bot. A list (or one name per line); raises TopicError."""
    if raw in (None, ""):
        return []
    if isinstance(raw, str):
        raw = raw.split("\n")
    if not isinstance(raw, (list, tuple)):
        raise TopicError("Respond in groups: the names must be a list")
    out, seen = [], set()
    for item in raw:
        name = str(item if item is not None else "").strip()
        if not name:
            continue
        if ALIAS_BAD_RE.search(name):
            raise TopicError("Respond in groups: the name '" + re.sub(r"[\x00-\x1f\x7f]", " ", name)[:40]
                             + "' contains a comma or a line break; put each name on a line of its own")
        if len(name) > MAX_ALIAS_LEN:
            raise TopicError("Respond in groups: the name '" + name[:40] + "...' is longer than "
                             + str(MAX_ALIAS_LEN) + " characters")
        if name.casefold() in seen:
            continue
        seen.add(name.casefold())
        out.append(name)
    if len(out) > MAX_NAME_ALIASES:
        raise TopicError("Respond in groups: at most " + str(MAX_NAME_ALIASES) + " names")
    return out


def default_aliases(agent_slug, agent_name=""):
    """The agent's own name, for "only when asked" with no names given."""
    name = str(agent_name or "").strip()
    if not name or ALIAS_BAD_RE.search(name) or len(name) > MAX_ALIAS_LEN:
        name = agent_slug
    return [name] if name else []


def respond_settings(channel, agent_slug="", agent_name=""):
    """GROUP_RESPOND_MODE / BOT_NAME_ALIASES from a stored channel. Lenient: a bad value is the default."""
    channel = channel or {}
    mode = str(channel.get("respond_mode") or "all").strip().lower()
    if mode not in RESPOND_MODES:
        mode = "all"
    try:
        aliases = parse_aliases(channel.get("name_aliases"))
    except TopicError:
        aliases = []
    if mode == "mention" and not aliases and agent_slug:
        aliases = default_aliases(agent_slug, agent_name)
    return {"mode": mode, "aliases": aliases}


def parse_trash_days(raw):
    if raw in (None, ""):
        return DEFAULT_TRASH_DAYS
    if isinstance(raw, bool):
        raise TopicError("Topics: the days in the trash must be a whole number")
    try:
        days = int(str(raw).strip()) if not isinstance(raw, int) else raw
    except ValueError:
        raise TopicError("Topics: the days in the trash must be a whole number")
    if days < 0 or days > MAX_TRASH_DAYS:
        raise TopicError("Topics: deleted topics' folders stay in the trash 0 to " + str(MAX_TRASH_DAYS)
                         + " days (0 deletes them at once), not " + str(days))
    return days


def topic_extras(channel):
    """The General topic, auto-folder and deleted-topic options of a stored channel, with defaults."""
    channel = channel or {}
    general = str(channel.get("topics_general") or "").strip().lower()
    if general == "off" or not TOPIC_SLUG_RE.match(general):
        general = ""
    deleted = str(channel.get("topics_deleted") or "trash").strip().lower()
    if deleted not in TOPICS_DELETED:
        deleted = "trash"
    try:
        days = parse_trash_days(channel.get("topics_trash_days"))
    except TopicError:
        days = DEFAULT_TRASH_DAYS
    return {
        "general": general,
        "auto": parse_flag(channel.get("topics_auto"), False),
        "auto_announce": parse_flag(channel.get("topics_auto_announce"), True),
        "deleted": deleted,
        "trash_days": days,
    }


def general_error(general, projects):
    """Why the General topic cannot go to `general`, or None."""
    if not general:
        return None
    for p in projects:
        if p["slug"] == general:
            if p.get("auto"):
                return ("the General topic can only go to a project of the list above, not to a folder "
                        "made for a new topic ('" + general + "')")
            if not p["enabled"]:
                return "the General topic goes to '" + p["name"] + "', which is switched off"
            return None
    return "the General topic goes to '" + general + "', which is not one of the projects"


def check_topic_projects(projects, approved_dir):
    """What registry.load_project_registry would refuse, as a sentence, or None."""
    if not projects:
        return "the projects list is empty; the bot needs at least one project to make a topic for"
    root = os.path.realpath(approved_dir)
    if not os.path.isdir(root):
        return "the agent's folder " + root + " does not exist"
    seen_slug, seen_name, seen_path = set(), set(), set()
    for p in projects:
        label = "project '" + p["name"] + "'"
        target = os.path.realpath(os.path.join(root, p["path"]))
        if not (target == root or target.startswith(root + "/")):
            return (label + ": the folder '" + p["path"] + "' leads outside the agent's folder ("
                    + root + "), probably through a link; the bot only accepts folders inside it")
        if not os.path.isdir(target):
            return label + ": there is no folder '" + p["path"] + "' in the agent's folder (" + root + ")"
        if p["slug"] in seen_slug:
            return "two projects share the short name '" + p["slug"] + "'"
        if p["name"] in seen_name:
            return "two projects share the name '" + p["name"] + "'"
        if p["path"] in seen_path:
            return "two projects use the same folder '" + p["path"] + "'"
        seen_slug.add(p["slug"])
        seen_name.add(p["name"])
        seen_path.add(p["path"])
    if not any(p["enabled"] for p in projects):
        return "every project is switched off, so the bot would have no topic to answer in"
    return None


def topic_chat_error(mode, chat_id):
    if mode not in TOPICS_MODES:
        return "the topic mode must be 'group' or 'private'"
    if mode != "group":
        return None
    if not chat_id:
        return "group topic mode needs the group's chat id"
    if not SUPERGROUP_ID_RE.match(chat_id):
        return ("the group chat id " + chat_id + " is not a group with Topics. Topics live only in "
                "supergroups, whose id starts with -100. Turn on Topics in the group's settings "
                "(Telegram then gives the group a new id starting with -100) and use that id")
    return None


def topic_config_error(mode, chat_id, projects, approved_dir):
    return topic_chat_error(mode, chat_id) or check_topic_projects(projects, approved_dir)


def topic_plan(cfg, channel):
    """Decide what Topics configuration this agent gets from its channel.

    {"enabled": False} when Topics are off; {"enabled": False, "skipped": why}
    when they are on but would not start (a folder removed since the save, say)
    -- the agent then runs without topics rather than crash-looping; otherwise
    the full plan: mode, chat id, projects and the path of the projects file.
    """
    if not channel or channel.get("type") != "telegram" or not channel.get("topics_enabled"):
        return {"enabled": False}
    slug = cfg["slug"]
    mode = str(channel.get("topics_mode") or "group").strip().lower()
    chat_id = str(channel.get("topics_chat_id") or "").strip()
    try:
        projects = parse_topic_projects(channel.get("topics_projects"))
    except TopicError as e:
        return {"enabled": False, "skipped": str(e)}
    if not projects:
        projects = default_topic_projects(slug, cfg.get("name"))
    err = topic_config_error(mode, chat_id, projects, agent_vault(slug))
    if err:
        return {"enabled": False, "skipped": err}
    extras = topic_extras(channel)
    # The General topic exists only in a group; in private mode it is off. A
    # target that no longer qualifies (cannot happen after a save, which checks
    # it with the list) is dropped rather than left to stop the bot.
    if mode != "group" or general_error(extras["general"], projects):
        extras["general"] = ""
    plan = {
        "enabled": True,
        "mode": mode,
        "chat_id": chat_id if mode == "group" else "",
        "projects": projects,
        "path": os.path.join(agent_dir(slug), PROJECTS_FILE),
    }
    plan.update(extras)
    return plan


def render_projects_yaml(projects):
    """The runtime's projects file. JSON-quoted scalars are valid YAML and need no escaping rules of their own."""
    q = lambda v: json.dumps(v, ensure_ascii=True)
    lines = [
        "# Generated by the MONI dashboard (channel Topics). Edit in the panel, not by hand:",
        "# the next save of the channel or the agent rewrites this file.",
        "projects:",
    ]
    for p in projects:
        lines.append("  - slug: " + q(p["slug"]))
        lines.append("    name: " + q(p["name"]))
        lines.append("    path: " + q(p["path"]))
        lines.append("    enabled: " + ("true" if p["enabled"] else "false"))
        if p.get("auto"):
            # An edited folder of a new topic: this entry overrides the
            # runtime's projects.auto.json one (same slug). The runtime ignores the key.
            lines.append("    auto: true")
    return "\n".join(lines) + "\n"


def write_projects_file(path, projects, gid):
    """Atomic, root-owned, readable by the agent's group (0640 root:moniagent)."""
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".projects-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(render_projects_yaml(projects))
        os.chown(tmp, 0, gid)
        os.chmod(tmp, 0o640)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# --- the runtime's auto file (projects.auto.json) ------------------------------
#
# With "new topics get their own folder" on, the runtime makes <vault>/topics/<slug>
# for every new forum topic and records it in <agent>/projects.auto.json; a
# deleted topic's folder goes to <vault>/.trash/topics/<slug>-<UTC stamp>. The
# runtime is that file's writer. The helper reads it for the panel and makes
# exactly two changes to it -- restore a folder from the trash, delete one now --
# both under the same flock the runtime takes (projects.auto.json.lock).
#
# The file and the folders are writable by the agent, so everything read from
# them is untrusted: every entry is checked, every path resolved, links refused,
# nothing outside <vault>/topics or <vault>/.trash/topics is ever touched, and a
# damaged file shows as an error, never as a crash.

class AutoFileError(Exception):
    pass


def _auto_root(agent):
    """The agent's vault, resolved, and its two subtrees -- or AutoFileError when one is a link."""
    root = os.path.realpath(agent_vault(agent))
    topics_dir = os.path.join(root, AUTO_DIR)
    trash_dir = os.path.join(root, AUTO_TRASH_DIR)
    for sub in (topics_dir, os.path.join(root, ".trash"), trash_dir):
        if os.path.islink(sub):
            raise AutoFileError("the folder " + os.path.relpath(sub, root) + " in the agent's folder is a link; "
                                "it must be a real folder")
    return root


def auto_entry_path(root, rel, subtree):
    """Check one relative path from the auto file: exactly one folder below `subtree`, no link anywhere.

    Returns (normalised relative path, absolute path, exists) or raises AutoFileError.
    """
    if not isinstance(rel, str) or not TOPIC_PATH_RE.match(rel) or rel.startswith(("/", "~")):
        raise AutoFileError("not a folder inside the agent's folder")
    norm = os.path.normpath(rel)
    if norm == ".." or norm.startswith("../") or os.path.dirname(norm) != subtree or not os.path.basename(norm):
        raise AutoFileError("the folder '" + rel[:80] + "' is not inside " + subtree + "/")
    full = os.path.join(root, norm)
    if os.path.islink(full):
        raise AutoFileError("the folder '" + norm + "' is a link")
    if not os.path.lexists(full):
        return norm, full, False
    if os.path.realpath(full) != full:
        raise AutoFileError("the folder '" + norm + "' leads elsewhere through a link")
    if not os.path.isdir(full):
        raise AutoFileError("'" + norm + "' is not a folder")
    return norm, full, True


def _auto_text(v, limit=80):
    return v.strip()[:limit] if isinstance(v, str) else ""


def _auto_int(v):
    return v if isinstance(v, int) and not isinstance(v, bool) else None


def read_auto_raw(agent):
    """The auto file's JSON as written, {} when there is none. Raises AutoFileError when it cannot be read."""
    path = os.path.join(agent_dir(agent), AUTO_FILE)
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return {}
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise AutoFileError("the file " + AUTO_FILE + " is a link")
        raise AutoFileError("the file " + AUTO_FILE + " could not be opened (" + type(e).__name__ + ")")
    with os.fdopen(fd, "rb") as fh:
        if not stat_is_file(os.fstat(fh.fileno())):
            raise AutoFileError("the file " + AUTO_FILE + " is not a plain file")
        data = fh.read(AUTO_FILE_MAX_BYTES + 1)
    if len(data) > AUTO_FILE_MAX_BYTES:
        raise AutoFileError("the file " + AUTO_FILE + " is too large")
    if not data.strip():
        return {}
    try:
        raw = json.loads(data.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        raise AutoFileError("the file " + AUTO_FILE + " is not valid JSON")
    if not isinstance(raw, dict):
        raise AutoFileError("the file " + AUTO_FILE + " is not a JSON object")
    for key in ("projects", "unlinked", "trash"):
        if key in raw and not isinstance(raw[key], list):
            raise AutoFileError("'" + key + "' in " + AUTO_FILE + " is not a list")
    return raw


def stat_is_file(st):
    import stat as _stat
    return _stat.S_ISREG(st.st_mode)


def validate_auto(raw, root):
    """The checked entries of an auto file; anything doubtful is left out and counted in `ignored`."""
    out = {"projects": [], "unlinked": [], "trash": [], "ignored": []}

    def common(e):
        slug = e.get("slug")
        if not isinstance(slug, str) or not TOPIC_SLUG_RE.match(slug):
            raise AutoFileError("a short name that is not allowed")
        name = e.get("name")
        name = name.strip() if isinstance(name, str) else ""
        if not name or not NAME_RE.match(name):
            name = slug
        return slug, name

    for e in raw.get("projects") or []:
        try:
            if not isinstance(e, dict):
                raise AutoFileError("not an object")
            slug, name = common(e)
            rel, _full, exists = auto_entry_path(root, e.get("path"), AUTO_DIR)
            out["projects"].append({"slug": slug, "name": name, "path": rel, "exists": exists,
                                    "thread_id": _auto_int(e.get("thread_id")),
                                    "created_at": _auto_text(e.get("created_at"), 40),
                                    "closed": e.get("closed") is True})
        except AutoFileError as err:
            out["ignored"].append("projects: " + str(err))
    for e in raw.get("unlinked") or []:
        try:
            if not isinstance(e, dict):
                raise AutoFileError("not an object")
            slug, name = common(e)
            rel, _full, exists = auto_entry_path(root, e.get("path"), AUTO_DIR)
            if not exists:
                raise AutoFileError("the folder '" + rel + "' is gone")
            out["unlinked"].append({"slug": slug, "name": name, "path": rel,
                                    "since": _auto_text(e.get("since"), 40),
                                    "reason": _auto_text(e.get("reason"), 40)})
        except AutoFileError as err:
            out["ignored"].append("unlinked: " + str(err))
    for e in raw.get("trash") or []:
        try:
            if not isinstance(e, dict):
                raise AutoFileError("not an object")
            slug, name = common(e)
            rel, _full, exists = auto_entry_path(root, e.get("trash_path"), AUTO_TRASH_DIR)
            original = e.get("original_path")
            original = os.path.normpath(original) if isinstance(original, str) and TOPIC_PATH_RE.match(original) else ""
            out["trash"].append({"slug": slug, "name": name, "trash_path": rel, "exists": exists,
                                 "original_path": original,
                                 "thread_id": _auto_int(e.get("thread_id")),
                                 "trashed_at": _auto_text(e.get("trashed_at"), 40)})
        except AutoFileError as err:
            out["ignored"].append("trash: " + str(err))
    return out


def read_auto_file(agent):
    """The panel's view of the auto file. Never raises: a problem is in `error`."""
    block = {"projects": [], "unlinked": [], "trash": [], "count": 0, "max": AUTO_MAX, "error": ""}
    if not agent or not os.path.isdir(agent_dir(agent)):
        return block
    try:
        root = _auto_root(agent)
        checked = validate_auto(read_auto_raw(agent), root)
    except AutoFileError as e:
        block["error"] = str(e)
        return block
    except Exception as e:  # never let a damaged file take the channel page down
        block["error"] = "the file " + AUTO_FILE + " could not be read (" + type(e).__name__ + ")"
        return block
    block.update({k: checked[k] for k in ("projects", "unlinked", "trash")})
    block["count"] = sum(1 for p in checked["projects"] if not p["closed"])
    if checked["ignored"]:
        n = len(checked["ignored"])
        block["error"] = (str(n) + (" entry" if n == 1 else " entries") + " of " + AUTO_FILE
                          + " left out: " + "; ".join(checked["ignored"][:3]))
    return block


def fold_auto_rows(projects, auto_projects, stored):
    """What of the panel's list goes to projects.yaml.

    Rows flagged auto that still equal the runtime's entry stay out (they live
    in the auto file). An edited one stays in, flagged, as an override. A row
    flagged auto whose entry has gone is kept only if it was an override before.
    """
    by_slug = {p["slug"]: p for p in auto_projects}
    before = {p.get("slug") for p in (stored or []) if isinstance(p, dict) and p.get("auto")}
    out = []
    for p in projects:
        if not p.get("auto"):
            out.append(p)
            continue
        entry = by_slug.get(p["slug"])
        if entry is None:
            if p["slug"] in before:
                out.append(p)
            continue
        if p["name"] == entry["name"] and p["path"] == entry["path"] and p["enabled"]:
            continue
        out.append(p)
    return out


class AutoLock:
    """Exclusive flock on <agent>/projects.auto.json.lock, as the runtime takes it.

    Waits up to `timeout` seconds; a lock file that is a link is refused.
    """

    def __init__(self, agent, timeout=None):
        self.path = os.path.join(agent_dir(agent), AUTO_LOCK)
        self.timeout = AUTO_LOCK_TIMEOUT if timeout is None else timeout
        self.fd = None

    def __enter__(self):
        try:
            self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o660)
        except OSError as e:
            raise AutoFileError("the lock file " + AUTO_LOCK + " could not be opened"
                                + (" (it is a link)" if e.errno == errno.ELOOP else ""))
        try:
            uid, gid = agent_ids()
            os.fchown(self.fd, uid, gid)
            os.fchmod(self.fd, 0o660)
        except (OSError, SystemExit):
            pass
        deadline = time.time() + self.timeout
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except OSError as e:
                if e.errno not in (errno.EAGAIN, errno.EACCES, errno.EWOULDBLOCK):
                    raise
            if time.time() >= deadline:
                os.close(self.fd)
                self.fd = None
                raise AutoFileError("the agent is busy with its topics file; try again in a moment")
            time.sleep(0.2)

    def __exit__(self, *exc):
        if self.fd is not None:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_UN)
            finally:
                os.close(self.fd)
                self.fd = None
        return False


def write_auto_raw(agent, raw):
    """Replace the auto file atomically, owned by the agent (moniagent 0660), as the runtime writes it."""
    d = agent_dir(agent)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".projects.auto-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(raw, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
        uid, gid = agent_ids()
        os.chown(tmp, uid, gid)
        os.chmod(tmp, 0o660)
        os.replace(tmp, os.path.join(d, AUTO_FILE))
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def free_topic_folder(root, slug):
    """topics/<slug>, or <slug>-2, -3 ... when taken (the short name kept at most 40 characters)."""
    for n in range(1, 100):
        suffix = "" if n == 1 else "-" + str(n)
        cand = slug[:40 - len(suffix)].rstrip("-_") + suffix
        if TOPIC_SLUG_RE.match(cand) and not os.path.lexists(os.path.join(root, AUTO_DIR, cand)):
            return cand
    raise AutoFileError("no free folder name for '" + slug + "' in " + AUTO_DIR + "/")


def cmd_channel_topics_trash(args):
    """channel-topics-trash <channel> restore|delete <trash_path>

    restore: <vault>/<trash_path> back to <vault>/topics/<slug> (or <slug>-2 ...),
             the trash entry removed, an "unlinked" entry added (reason "restored");
             the runtime links it again when a topic of that name is made.
    delete:  <vault>/<trash_path> removed for good, the trash entry removed.
    Both under the auto file's lock, re-reading the file under it.
    """
    if len(args) != 3 or args[1] not in ("restore", "delete"):
        fail("usage: channel-topics-trash <slug> restore|delete <trash_path>")
    slug = check_channel_slug(args[0])
    existing_channel(slug)
    action, wanted = args[1], args[2]
    agent = read_channel_json(slug).get("agent") or ""
    if not agent or not os.path.isdir(agent_dir(agent)):
        fail("This channel is not connected to an agent, so it has no topic folders.")
    try:
        root = _auto_root(agent)
        rel, full, exists = auto_entry_path(root, wanted, AUTO_TRASH_DIR)
    except AutoFileError as e:
        fail("Nothing changed: " + str(e) + ".")
    detail = {"slug": slug, "agent": agent, "action": action, "trash_path": rel}
    try:
        with AutoLock(agent):
            raw = read_auto_raw(agent)
            trash = raw.get("trash") or []
            index = None
            for i, e in enumerate(trash):
                if isinstance(e, dict) and isinstance(e.get("trash_path"), str) and os.path.normpath(e["trash_path"]) == rel:
                    index = i
                    break
            if index is None:
                raise AutoFileError("'" + rel + "' is not in the trash list (it may have been emptied already)")
            entry = trash[index]
            # Checked again under the lock: the runtime may have moved things.
            rel, full, exists = auto_entry_path(root, rel, AUTO_TRASH_DIR)
            result = {"action": action, "trash_path": rel}
            if action == "restore":
                if not exists:
                    raise AutoFileError("the folder '" + rel + "' is no longer in the trash")
                eslug = entry.get("slug") if isinstance(entry.get("slug"), str) and TOPIC_SLUG_RE.match(entry.get("slug")) else ""
                if not eslug:
                    raise AutoFileError("the trash entry has no usable short name")
                name = entry.get("name") if isinstance(entry.get("name"), str) and NAME_RE.match(entry.get("name").strip()) else eslug
                topics_dir = os.path.join(root, AUTO_DIR)
                if not os.path.isdir(topics_dir):
                    os.makedirs(topics_dir, exist_ok=True)
                    uid, gid = agent_ids()
                    os.chown(topics_dir, uid, gid)
                    os.chmod(topics_dir, 0o770)
                if os.path.islink(topics_dir) or os.path.realpath(topics_dir) != topics_dir:
                    raise AutoFileError("the folder topics/ is a link")
                new_slug = free_topic_folder(root, eslug)
                dest = os.path.join(topics_dir, new_slug)
                os.rename(full, dest)
                new_rel = AUTO_DIR + "/" + new_slug
                raw.setdefault("unlinked", []).append({"slug": new_slug, "name": name.strip(), "path": new_rel,
                                                       "since": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                                                       "reason": "restored"})
                result["path"] = new_rel
                detail["restored_to"] = new_rel
            else:
                if exists:
                    shutil.rmtree(full)
                result["deleted"] = exists
            del trash[index]
            raw["trash"] = trash
            write_auto_raw(agent, raw)
    except AutoFileError as e:
        fail("Nothing changed: " + str(e) + ".")
    except OSError as e:
        detail["error"] = type(e).__name__
        audit("channel-topics-trash", detail)
        fail("The folder could not be " + ("restored" if action == "restore" else "deleted")
             + " (" + type(e).__name__ + (": " + e.strerror if getattr(e, "strerror", None) else "") + ").")
    audit("channel-topics-trash", detail)
    ok(result)


def topics_signature(cfg):
    """What decides whether the Telegram pre-flight has to run again."""
    if not cfg.get("topics_enabled"):
        return None
    return json.dumps([cfg.get("agent"), cfg.get("topics_mode"), cfg.get("topics_chat_id")])


