    ok(agent_summary(args[0]))


def validate_config(cfg, creating):
    """Validate the dashboard-supplied agent configuration.

    The dashboard validates too, but it is a web app: this is the layer that has
    to hold if the web app is wrong.
    """
    out = {}

    slug = cfg.get("slug", "")
    check_slug(slug)
    out["slug"] = slug

    name = str(cfg.get("name") or slug).strip()
    if not NAME_RE.match(name):
        fail("display name contains disallowed characters")
    out["name"] = name

    role = str(cfg.get("role") or "").strip()
    if len(role) > 4000:
        fail("role description is too long (max 4000 characters)")
    out["role"] = role

    model = str(cfg.get("model") or "claude-opus-5").strip()
    if not MODEL_RE.match(model):
        fail("invalid model id")
    out["model"] = model

    # How hard the model thinks before answering. Medium is the default because
    # it is the right trade for the conversational work most agents do; the
    # higher levels cost noticeably more time and tokens per turn and are worth
    # it only for agents doing genuinely hard reasoning.
    effort = str(cfg.get("effort") or "medium").strip().lower()
    if effort not in EFFORT_LEVELS:
        fail("effort must be one of: " + ", ".join(EFFORT_LEVELS))
    out["effort"] = effort

    try:
        verbose = int(cfg.get("verbose_level", 1))
    except (TypeError, ValueError):
        fail("verbose level must be a number")
    if verbose not in (0, 1, 2):
        fail("verbose level must be 0, 1 or 2")
    out["verbose_level"] = verbose

    try:
        max_turns = int(cfg.get("max_turns", 100))
    except (TypeError, ValueError):
        fail("max turns must be a number")
    if not 1 <= max_turns <= 500:
        fail("max turns must be between 1 and 500")
    out["max_turns"] = max_turns

    try:
        timeout = int(cfg.get("timeout_seconds", 1800))
    except (TypeError, ValueError):
        fail("timeout must be a number")
    if not 60 <= timeout <= 7200:
        fail("timeout must be between 60 and 7200 seconds")
    out["timeout_seconds"] = timeout

    project = str(cfg.get("project_dir") or "").strip()
    if project:
        if not ABS_PATH_RE.match(project) or ".." in project:
            fail("project directory must be a plain absolute path")
        real = os.path.realpath(project)
        if not any(real == root or real.startswith(root + "/") for root in PROJECT_ROOTS):
            fail("project directory must live under one of: " + ", ".join(PROJECT_ROOTS))
        if not os.path.isdir(real):
            fail("project directory does not exist: " + real)
        project = real
    out["project_dir"] = project

    # Add-ons are named capabilities; the environment they imply is computed by
    # the dashboard from its catalogue and passed here as a flat map. The helper
    # does not trust that map -- it revalidates every key and value, because
    # these end up in a systemd EnvironmentFile read by a process that runs
    # model-authored commands.
    out["addons"] = validate_addon_ids(cfg.get("addons"))
    out["addon_env"] = validate_env_map(cfg.get("addon_env"))

    return out


def validate_addon_ids(raw):
    if raw in (None, ""):
        return []
    if not isinstance(raw, list):
        fail("addons must be a list of ids")
    if len(raw) > 60:
        fail("too many add-ons")
    out = []
    for item in raw:
        item = str(item)
        if not ADDON_ID_RE.match(item):
            fail("invalid add-on id: " + repr(item[:40]))
        if item not in out:
            out.append(item)
    return sorted(out)


def validate_env_map(raw):
    """Validate a dashboard-supplied environment fragment.

    A newline in a value would let one setting inject another into the
    EnvironmentFile, so it is rejected rather than escaped.
    """
    if raw in (None, ""):
        return {}
    if not isinstance(raw, dict):
        fail("addon_env must be an object")
    if len(raw) > 80:
        fail("too many environment entries")
    out = {}
    for key, value in raw.items():
        key = str(key)
        value = "" if value is None else str(value)
        if not ENV_KEY_RE.match(key):
            fail("invalid environment key: " + repr(key[:40]))
        if not ENV_VALUE_RE.match(value):
            fail("environment value for " + key + " contains a newline or null byte")
        if key in PROTECTED_ENV_KEYS:
            fail(key + " is set by the panel and cannot be overridden by an add-on")
        out[key] = value
    return out


# Keys the helper computes itself. An add-on that could set these could point an
# agent at another agent's vault, or hand it someone else's bot token.
PROTECTED_ENV_KEYS = {
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_BOT_USERNAME",
    "APPROVED_DIRECTORY",
    "ALLOWED_USERS",
    "DATABASE_URL",
    "MCP_CONFIG_PATH",
    "MONI_VAULT",
    "MONI_VECTOR_DB",
    "MONI_AGENT_SLUG",
    "CLAUDE_CODE_OAUTH_TOKEN",
    "ANTHROPIC_API_KEY",
    "ENVIRONMENT",
    "DEVELOPMENT_MODE",
}


def render_env(cfg, channel=None):
    """Build the agent's systemd EnvironmentFile.

    Three sources merge here, in increasing order of precedence:

      1. baseline    what every agent needs to run at all
      2. add-ons     capability switches chosen in the panel
      3. identity    paths and credentials the helper computes itself

    Identity comes last on purpose: an add-on cannot redirect an agent at
    another agent's vault or bot token, whatever the dashboard sends. Every
    value has been through validate_config, so none can contain a newline that
    would inject a second variable.
    """
    d = agent_dir(cfg["slug"])
    vault = os.path.join(d, "vault")

    env = {
        # --- baseline -------------------------------------------------------
        "USE_SDK": "true",
        "AGENTIC_MODE": "true",
        "ENABLE_TOKEN_AUTH": "false",
        "DISABLE_SECURITY_PATTERNS": "true",
        "DISABLE_TOOL_VALIDATION": "false",
        "SESSION_TIMEOUT_HOURS": "720",
        "MAX_SESSIONS_PER_USER": "10",
        "RATE_LIMIT_REQUESTS": "30",
        "RATE_LIMIT_WINDOW": "60",
        "RATE_LIMIT_BURST": "60",
        "CLAUDE_MODEL": cfg["model"],
        "CLAUDE_EFFORT": cfg.get("effort", "medium"),
        "CLAUDE_MAX_TURNS": str(cfg["max_turns"]),
        "CLAUDE_TIMEOUT_SECONDS": str(cfg["timeout_seconds"]),
        "VERBOSE_LEVEL": str(cfg["verbose_level"]),
    }

    # --- add-ons ------------------------------------------------------------
    env.update(cfg.get("addon_env") or {})
    if channel:
        env.update(channel.get("addon_env") or {})

    # --- identity: computed here, never overridable -------------------------
    env.update(
        {
            "APPROVED_DIRECTORY": vault,
            "DATABASE_URL": "sqlite:///" + os.path.join(d, "data", "bot.db"),
            "MCP_CONFIG_PATH": os.path.join(d, "mcp.json"),
            "MONI_AGENT_SLUG": cfg["slug"],
            "MONI_VAULT": vault,
            "MONI_VECTOR_DB": os.path.join(d, "vectors", "memory.db"),
            "ENVIRONMENT": "production",
            "DEVELOPMENT_MODE": "false",
        }
    )

    if channel and channel.get("type") == "telegram":
        env["TELEGRAM_BOT_TOKEN"] = channel.get("_token", "")
        env["TELEGRAM_BOT_USERNAME"] = channel.get("telegram_bot_username", "")
        env["ALLOWED_USERS"] = channel.get("allowed_users", "")
        if channel.get("topics_enabled"):
            env["ENABLE_PROJECT_THREADS"] = "true"
            env["PROJECT_THREADS_MODE"] = "group"
            env["PROJECT_THREADS_CHAT_ID"] = channel.get("topics_chat_id", "")
        else:
            env["ENABLE_PROJECT_THREADS"] = "false"

    lines = [
        "# Generated by the MONI dashboard. Edit through the panel, not by hand.",
        "# Regenerated on every configuration change to this agent or its channel.",
    ]
    for key in sorted(env):
        lines.append(key + "=" + env[key])
    return "\n".join(lines) + "\n"


def render_mcp(cfg):
    d = agent_dir(cfg["slug"])
    servers = {
        "memory": {
            "command": os.path.join(RUNTIME_DIR, "venv", "bin", "python"),
            "args": ["-m", "moni_memory.mcp_server"],
            "env": {
                "MONI_VAULT": os.path.join(d, "vault"),
                "MONI_VECTOR_DB": os.path.join(d, "vectors", "memory.db"),
                "MONI_MODEL_CACHE": os.path.join(SHARED_DIR, "models"),
            },
        }
    }

    return json.dumps({"mcpServers": servers}, indent=2) + "\n"


def scaffold_vault(cfg, uid, gid):
    d = agent_dir(cfg["slug"])
    vault = os.path.join(d, "vault")
    if not os.path.isdir(TEMPLATE_DIR):
        fail("vault template missing at " + TEMPLATE_DIR + "; run the bootstrap first")
    if not os.path.exists(vault):
        shutil.copytree(TEMPLATE_DIR, vault)

    substitutions = {
        "{{AGENT_NAME}}": cfg["name"],
        "{{AGENT_SLUG}}": cfg["slug"],
        "{{AGENT_ROLE}}": cfg["role"] or "General-purpose assistant. No specific role set yet.",
        "{{WORKSPACE}}": vault,
        "{{CREATED}}": now_iso()[:10],
    }
    for filename in ("CLAUDE.md", "MEMORY.md"):
        path = os.path.join(vault, filename)
        if not os.path.exists(path):
            continue
        text = open(path, encoding="utf-8").read()
        for needle, value in substitutions.items():
            text = text.replace(needle, value)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(text)

    if cfg["project_dir"]:
        link = os.path.join(vault, "project")
        if os.path.islink(link):
            os.unlink(link)
        if not os.path.exists(link):
            os.symlink(cfg["project_dir"], link)


def write_agent_files(cfg, uid, gid, channel=None):
    d = agent_dir(cfg["slug"])
    for sub in ("", "data", "logs", "vectors"):
        os.makedirs(os.path.join(d, sub), exist_ok=True)

    scaffold_vault(cfg, uid, gid)

    env_path = os.path.join(d, "agent.env")
    fd, tmp = tempfile.mkstemp(dir=d)
    with os.fdopen(fd, "w") as fh:
        fh.write(render_env(cfg, channel))
    os.chown(tmp, uid, gid)
    os.chmod(tmp, 0o600)  # holds the bot token
    os.replace(tmp, env_path)

    mcp_path = os.path.join(d, "mcp.json")
    with open(mcp_path, "w") as fh:
        fh.write(render_mcp(cfg))
    os.chown(mcp_path, uid, gid)
    os.chmod(mcp_path, 0o640)


def drop_in_path(slug):
    return "/etc/systemd/system/" + unit_name(slug) + ".d"


def write_drop_in(cfg):
    """Per-agent systemd overrides.

    The unit is sandboxed with ProtectSystem=strict, so an attached project
    directory has to be granted explicitly or the agent gets a read-only
    filesystem and confusing permission errors. That is the only thing an agent
    unit is ever allowed to relax -- nothing here loosens the sandbox itself.
    """
    path = drop_in_path(cfg["slug"])
    if not cfg["project_dir"]:
        if os.path.isdir(path):
            shutil.rmtree(path, ignore_errors=True)
        return
    os.makedirs(path, exist_ok=True)
    conf = os.path.join(path, "project.conf")
    with open(conf, "w") as fh:
        fh.write("[Service]\nReadWritePaths=" + cfg["project_dir"] + "\n")
    os.chmod(conf, 0o644)


DESKTOP_USER = "ubuntu"


def _obsidian_vaults(slug, remove=False):
    """Add or remove a vault in the desktop user's Obsidian vault switcher.

    Best effort by design: Obsidian may not be installed, and a failure here is
    a menu entry, not a broken agent. The id is derived from the path so
    re-registering the same vault never duplicates it.
    """
    try:
        pw = pwd.getpwnam(DESKTOP_USER)
    except KeyError:
        return False
    conf_dir = os.path.join(pw.pw_dir, ".config", "obsidian")
    conf_path = os.path.join(conf_dir, "obsidian.json")
    vault = os.path.join(agent_dir(slug), "vault")
    vid = hashlib.sha1(vault.encode()).hexdigest()[:16]
    try:
        os.makedirs(conf_dir, exist_ok=True)
        try:
            with open(conf_path) as fh:
                conf = json.load(fh)
        except Exception:
            conf = {}
        vaults = conf.setdefault("vaults", {})
        if remove:
            if vid not in vaults:
                return False
            del vaults[vid]
        else:
            entry = vaults.get(vid, {})
            entry.update(
                {"path": vault, "ts": int(datetime.now(timezone.utc).timestamp() * 1000)}
            )
            vaults[vid] = entry
        tmp = conf_path + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(conf, fh, indent=2)
        os.replace(tmp, conf_path)
        for path in (conf_dir, conf_path):
            os.chown(path, pw.pw_uid, pw.pw_gid)
        return True
    except Exception:
        return False


def register_obsidian_vault(slug):
    return _obsidian_vaults(slug, remove=False)


def unregister_obsidian_vault(slug):
    return _obsidian_vaults(slug, remove=True)


def public_meta(cfg):
    meta = {k: v for k, v in cfg.items() if not k.startswith("_")}
    meta["updated_at"] = now_iso()
    return meta


def cmd_agent_create(args):
    payload = read_stdin_json()
    cfg = validate_config(payload, creating=True)
    slug = cfg["slug"]
    if os.path.exists(agent_dir(slug)):
        fail("an agent called " + slug + " already exists")
    if not os.path.isdir(RUNTIME_DIR):
        fail("agent runtime is not installed at " + RUNTIME_DIR + "; run the bootstrap first")

    uid, gid = agent_ids()
    os.makedirs(AGENTS_DIR, exist_ok=True)
    try:
        write_agent_files(cfg, uid, gid, channel_bound_to(slug))
        meta = public_meta(cfg)
        meta["created_at"] = now_iso()
        write_agent_json(slug, meta, uid, gid)
        chown_tree(agent_dir(slug), uid, gid)
        os.chmod(os.path.join(agent_dir(slug), "agent.env"), 0o600)
        write_drop_in(cfg)
    except Exception as exc:
        # A half-created agent is worse than none: it shows up in the list and
        # fails mysteriously. Roll the directory back.
        shutil.rmtree(agent_dir(slug), ignore_errors=True)
        fail("could not create agent: " + type(exc).__name__ + ": " + str(exc))

    run(["systemctl", "daemon-reload"])
    run(["systemctl", "reset-failed", unit_name(slug)])  # clear any stale state
    registered = register_obsidian_vault(slug)

    # An agent with no channel has nothing to listen to, so starting it would
    # only produce a crash loop and a misleading "failed" badge. It waits.
    channel = channel_bound_to(slug)
    started = False
    message = "No channel is connected yet, so the agent is not running."
    if channel and channel.get("type") == "telegram":
        r = run(["systemctl", "enable", "--now", unit_name(slug)], timeout=30)
        started = r.returncode == 0
        message = "" if started else r.stderr.strip()
    elif channel:
        message = "Served by its WhatsApp bridge."

    audit("agent-create", {"slug": slug, "name": cfg["name"], "started": started})
    ok({
        "slug": slug,
        "started": started,
        "obsidian_registered": registered,
        "message": message,
        "state": unit_state(slug),
    })


def cmd_agent_update(args):
    payload = read_stdin_json()
    slug = check_slug(payload.get("slug", ""))
    existing_agent(slug)
    current = read_agent_json(slug)

    merged = dict(current)
    merged.update({k: v for k, v in payload.items() if v is not None})
    cfg = validate_config(merged, creating=False)

    uid, gid = agent_ids()
    channel = channel_bound_to(slug)
    write_agent_files(cfg, uid, gid, channel)
    meta = public_meta(cfg)
    meta["created_at"] = current.get("created_at", now_iso())
    write_agent_json(slug, meta, uid, gid)
    chown_tree(agent_dir(slug), uid, gid)
    os.chmod(os.path.join(agent_dir(slug), "agent.env"), 0o600)
    write_drop_in(cfg)

    run(["systemctl", "daemon-reload"])
    restarted = False
    if unit_state(slug)["active"] == "active":
        restarted = run(["systemctl", "restart", unit_name(slug)], timeout=30).returncode == 0
    audit("agent-update", {"slug": slug, "restarted": restarted})
    ok({"slug": slug, "restarted": restarted, "state": unit_state(slug)})


def read_stored_token(slug):
    path = os.path.join(agent_dir(slug), "agent.env")
