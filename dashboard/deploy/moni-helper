def agent_dir(slug):
    return os.path.join(AGENTS_DIR, slug)


def all_agent_slugs():
    """Every agent that exists, by slug.

    Not to be confused with agent_ids(), which returns the service account's
    uid and gid. The two names are close enough that one has already been used
    for the other; this one is the list of agents.
    """
    if not os.path.isdir(AGENTS_DIR):
        return []
    return [
        slug
        for slug in sorted(os.listdir(AGENTS_DIR))
        if SLUG_RE.match(slug) and os.path.isdir(agent_dir(slug))
    ]


def check_slug(slug):
    if not isinstance(slug, str) or not SLUG_RE.match(slug):
        fail("invalid agent name: must be lowercase letters, digits and hyphens")
    return slug


def existing_agent(slug):
    check_slug(slug)
    path = agent_dir(slug)
    if not os.path.isdir(path):
        fail("no such agent: " + slug)
    return path


def agent_ids():
    try:
        pw = pwd.getpwnam(AGENT_USER)
    except KeyError:
        fail("service account " + AGENT_USER + " does not exist; run the bootstrap first")
    return pw.pw_uid, pw.pw_gid


def chown_tree(path, uid, gid, dir_mode=0o770, file_mode=0o660):
    """Give the agent account ownership, and its group write access.

    Group-writable is deliberate: a human in the moniagent group edits these
    vaults in Obsidian over RDP, and a memory the operator cannot correct is a
    memory that stays wrong. agent.env is tightened back to 0600 afterwards, so
    the bot token is not part of this.
    """
    os.chown(path, uid, gid)
    os.chmod(path, dir_mode)
    for root, dirs, files in os.walk(path):
        for d in dirs:
            p = os.path.join(root, d)
            os.chown(p, uid, gid)
            os.chmod(p, dir_mode)
        for f in files:
            p = os.path.join(root, f)
            os.chown(p, uid, gid)
            os.chmod(p, file_mode)


def unit_name(slug):
    return UNIT_PREFIX + slug + ".service"


def unit_state(slug):
    active = run(["systemctl", "is-active", unit_name(slug)]).stdout.strip() or "unknown"
    enabled = run(["systemctl", "is-enabled", unit_name(slug)]).stdout.strip() or "unknown"
    since = ""
    r = run(["systemctl", "show", unit_name(slug), "-p", "ActiveEnterTimestamp", "--value"])
    if r.returncode == 0:
        since = r.stdout.strip()
    return {"active": active, "enabled": enabled, "since": since}


def read_agent_json(slug):
    path = os.path.join(agent_dir(slug), "agent.json")
    try:
        with open(path) as fh:
            return json.load(fh)
    except Exception:
        return {"slug": slug, "name": slug, "broken": True}


def write_agent_json(slug, meta, uid, gid):
    path = os.path.join(agent_dir(slug), "agent.json")
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(meta, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.chown(tmp, uid, gid)
    os.chmod(tmp, 0o640)
    os.replace(tmp, path)


def memory_counts(slug):
    """Read index size straight from SQLite.

    Deliberately not via the moni-memory CLI: this runs on every dashboard page
    load, and spawning a Python interpreter per agent to count two rows is waste.
    """
    db = os.path.join(agent_dir(slug), "vectors", "memory.db")
    if not os.path.exists(db):
        return {"files": 0, "chunks": 0, "bytes": 0, "indexed": False}
    try:
        import sqlite3

        conn = sqlite3.connect("file:" + db + "?mode=ro", uri=True, timeout=2)
        try:
            files = conn.execute("SELECT COUNT(*) FROM files").fetchone()[0]
            chunks = conn.execute("SELECT COUNT(*) FROM chunks").fetchone()[0]
            last = conn.execute("SELECT MAX(indexed_at) FROM files").fetchone()[0]
        finally:
            conn.close()
        return {
            "files": files,
            "chunks": chunks,
            "bytes": os.path.getsize(db),
            "last_indexed": last,
            "indexed": True,
        }
    except Exception:
        return {"files": 0, "chunks": 0, "bytes": 0, "indexed": False}


def vault_counts(slug):
    vault = os.path.join(agent_dir(slug), "vault")
    notes = 0
    if os.path.isdir(vault):
        for root, dirs, files in os.walk(vault):
            dirs[:] = [d for d in dirs if not d.startswith(".")]
            notes += sum(1 for f in files if f.endswith(".md"))
    return notes


def has_token(slug):
    path = os.path.join(agent_dir(slug), "agent.env")
    try:
        with open(path) as fh:
            for line in fh:
                if line.startswith("TELEGRAM_BOT_TOKEN="):
                    return bool(line.split("=", 1)[1].strip())
    except Exception:
        return False
    return False


def agent_summary(slug):
    meta = read_agent_json(slug)
    meta["state"] = unit_state(slug)
    meta["memory"] = memory_counts(slug)
    meta["notes"] = vault_counts(slug)
    meta["dir"] = agent_dir(slug)
    # The credential lives on the channel now, so "can this agent be reached"
    # is a question about its channel, not about the agent.
    channel = channel_bound_to(slug)
    if channel:
        meta["channel"] = {
            "slug": channel.get("slug"),
            "name": channel.get("name"),
            "type": channel.get("type"),
            "token_set": bool(channel.get("_token")),
            "telegram_bot_username": channel.get("telegram_bot_username", ""),
            "allowed_users": channel.get("allowed_users", ""),
            "allowed_numbers": channel.get("allowed_numbers", ""),
            "addons": channel.get("addons", []),
        }
        # "Is this agent running" means the process actually serving it, which
        # for a WhatsApp agent is the bridge, not the Telegram unit.
        if channel.get("type") == "whatsapp":
            meta["state"] = unit_state_for(wa_unit(channel["slug"]))
            meta["state"]["since"] = ""
            meta["served_by"] = "whatsapp"
    else:
        meta["channel"] = None
    return meta


