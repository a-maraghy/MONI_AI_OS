# ============================================================== channels =====
#
# A channel is a way for messages to reach an agent: a Telegram bot, or a linked
# WhatsApp number. It is separate from the agent on purpose -- the credential
# belongs to the transport, not to the mind behind it, and the same agent should
# be able to change how people reach it without being rebuilt.
#
# Exactly one channel binds to one agent. That is not a modelling preference: the
# Telegram Bot API allows a single poller per token, so two agents sharing a
# channel would make both drop messages at random.


def channel_dir(slug):
    return os.path.join(CHANNELS_DIR, slug)


def check_channel_slug(slug):
    if not isinstance(slug, str) or not SLUG_RE.match(slug):
        fail("invalid channel name: must be lowercase letters, digits and hyphens")
    return slug


def existing_channel(slug):
    check_channel_slug(slug)
    if not os.path.isdir(channel_dir(slug)):
        fail("no such channel: " + slug)
    return channel_dir(slug)


def read_channel_json(slug):
    try:
        with open(os.path.join(channel_dir(slug), "channel.json")) as fh:
            return json.load(fh)
    except Exception:
        return {"slug": slug, "name": slug, "type": "telegram", "broken": True}


def channel_token(slug):
    path = os.path.join(channel_dir(slug), "channel.env")
    try:
        with open(path) as fh:
            for line in fh:
                if line.startswith("CHANNEL_TOKEN="):
                    return line.split("=", 1)[1].strip()
    except Exception:
        return ""
    return ""


def all_channels():
    if not os.path.isdir(CHANNELS_DIR):
        return []
    out = []
    for slug in sorted(os.listdir(CHANNELS_DIR)):
        if SLUG_RE.match(slug) and os.path.isdir(channel_dir(slug)):
            out.append(read_channel_json(slug))
    return out


def channel_bound_to(agent_slug):
    """The channel feeding this agent, with its token, or None."""
    for meta in all_channels():
        if meta.get("agent") == agent_slug:
            meta = dict(meta)
            meta["_token"] = channel_token(meta["slug"])
            return meta
    return None


def channel_summary(slug):
    meta = read_channel_json(slug)
    meta["token_set"] = bool(channel_token(slug))
    meta["dir"] = channel_dir(slug)
    if meta.get("type") == "whatsapp":
        meta["linked"] = os.path.isfile(
            os.path.join(channel_dir(slug), "session", "creds.json")
        )
    agent = meta.get("agent")
    if agent and os.path.isdir(agent_dir(agent)):
        meta["agent_state"] = unit_state(agent)
        meta["agent_name"] = read_agent_json(agent).get("name", agent)
    return meta


MAX_PRINCIPALS = 25


def normalise_principals(raw, pattern, what):
    """Clean an ordered allow-list, preserving order and dropping duplicates.

    Order carries meaning: the first entry is the administrator. Duplicates are
    removed keeping the earliest position, so promoting someone already on the
    list is just a matter of moving them to the front rather than remembering to
    delete the old entry -- and forgetting to would otherwise leave two
    candidates for "who is the administrator".
    """
    if raw is None:
        items = []
    elif isinstance(raw, (list, tuple)):
        items = [str(x) for x in raw]
    else:
        items = str(raw).replace("\n", ",").split(",")

    seen = set()
    out = []
    for item in items:
        item = item.strip().replace(" ", "")
        if not item:
            continue
        if not pattern.match(item):
            fail("not a valid " + what + ": " + repr(item[:40]))
        if item in seen:
            continue
        seen.add(item)
        out.append(item)
    if len(out) > MAX_PRINCIPALS:
        fail("at most " + str(MAX_PRINCIPALS) + " entries are allowed")
    return out


def principal_admin(channel):
    """The first entry on the allow-list, which the runtime treats as default."""
    if channel.get("type") == "telegram":
        raw = channel.get("allowed_users", "")
    else:
        raw = channel.get("allowed_numbers", "")
    parts = [p for p in str(raw).split(",") if p]
    return parts[0] if parts else ""


def validate_channel(cfg, creating):
    out = {}
    slug = cfg.get("slug", "")
    check_channel_slug(slug)
    out["slug"] = slug

    name = str(cfg.get("name") or slug).strip()
    if not NAME_RE.match(name):
        fail("channel name contains disallowed characters")
    out["name"] = name

    ctype = str(cfg.get("type") or "telegram").strip()
    if ctype not in CHANNEL_TYPES:
        fail("channel type must be one of: " + ", ".join(CHANNEL_TYPES))
    out["type"] = ctype

    agent = str(cfg.get("agent") or "").strip()
    if agent:
        check_slug(agent)
        if not os.path.isdir(agent_dir(agent)):
            fail("no such agent: " + agent)
        # One poller per token, so one channel per agent.
        for other in all_channels():
            if other.get("agent") == agent and other.get("slug") != slug:
                fail(
                    "agent " + agent + " is already connected to channel "
                    + str(other.get("slug"))
                    + "; disconnect it first"
                )
    out["agent"] = agent

    out["addons"] = validate_addon_ids(cfg.get("addons"))
    out["addon_env"] = validate_env_map(cfg.get("addon_env"))

    if ctype == "telegram":
        username = str(cfg.get("telegram_bot_username") or "").lstrip("@").strip()
        if username and not BOT_USERNAME_RE.match(username):
            fail("bot username must be 4-32 characters of letters, digits or underscore")
        out["telegram_bot_username"] = username

        # An ordered list, not a set. Position zero is the administrator, whom
        # the runtime treats as the default user. Reordering the list is how
        # the administrator changes.
        allowed = normalise_principals(cfg.get("allowed_users"), USER_ID_RE, "Telegram user ID")
        out["allowed_users"] = ",".join(allowed)

        topics = bool(cfg.get("topics_enabled"))
        chat_id = str(cfg.get("topics_chat_id") or "").strip()
        if chat_id and not CHAT_ID_RE.match(chat_id):
            fail("Telegram chat id must be numeric (groups start with -100)")
        if topics and not chat_id:
            fail("group topic mode needs the group chat id")
        out["topics_enabled"] = topics
        out["topics_chat_id"] = chat_id

        token = cfg.get("token") or ""
        if token and not BOT_TOKEN_RE.match(token):
            fail("that does not look like a Telegram bot token")
        if creating and not token:
            fail("a Telegram bot token is required to create a Telegram channel")
        out["_token"] = token
    else:
        numbers = normalise_principals(cfg.get("allowed_numbers"), PHONE_RE, "phone number in E.164 form")
        out["allowed_numbers"] = ",".join(numbers)
        out["_token"] = ""

    return out


def write_channel_files(cfg, uid, gid, keep_token=""):
    d = channel_dir(cfg["slug"])
    os.makedirs(d, exist_ok=True)

    token = cfg.get("_token") or keep_token
    env_path = os.path.join(d, "channel.env")
    fd, tmp = tempfile.mkstemp(dir=d)
    with os.fdopen(fd, "w") as fh:
        fh.write("# Generated by the MONI dashboard.\n")
        fh.write("CHANNEL_TOKEN=" + token + "\n")
    os.chown(tmp, uid, gid)
    os.chmod(tmp, 0o600)
    os.replace(tmp, env_path)

    meta = {k: v for k, v in cfg.items() if not k.startswith("_")}
    meta["updated_at"] = now_iso()
    meta_path = os.path.join(d, "channel.json")
    with open(meta_path, "w") as fh:
        json.dump(meta, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.chown(meta_path, uid, gid)
    os.chmod(meta_path, 0o640)
    os.chown(d, uid, gid)
    os.chmod(d, 0o770)


def reconfigure_agent(agent_slug):
    """Regenerate an agent's environment from its current channel and restart it.

    Called whenever a channel changes, because the agent's EnvironmentFile is
    derived from the channel and would otherwise still hold the old token.
    """
    if not agent_slug or not os.path.isdir(agent_dir(agent_slug)):
        return {"reconfigured": False}
    cfg = validate_config(read_agent_json(agent_slug), creating=False)
    uid, gid = agent_ids()
    channel = channel_bound_to(agent_slug)
    write_agent_files(cfg, uid, gid, channel)
    chown_tree(agent_dir(agent_slug), uid, gid)
    os.chmod(os.path.join(agent_dir(agent_slug), "agent.env"), 0o600)

    run(["systemctl", "daemon-reload"])
    run(["systemctl", "reset-failed", unit_name(agent_slug)])

    # moni-agent@ is the *Telegram* runtime. An agent reached only over WhatsApp
    # is served by its bridge instead, so starting this unit would just produce a
    # crash loop over a missing bot token and a "failed" badge on a healthy
    # agent. No channel at all means nothing to listen to either way.
    if channel and channel.get("type") == "telegram":
        r = run(["systemctl", "enable", "--now", unit_name(agent_slug)], timeout=45)
        if unit_state(agent_slug)["active"] == "active":
            run(["systemctl", "restart", unit_name(agent_slug)], timeout=45)
        return {"reconfigured": True, "running": r.returncode == 0}

    run(["systemctl", "disable", "--now", unit_name(agent_slug)], timeout=45)
    run(["systemctl", "reset-failed", unit_name(agent_slug)])
    return {
        "reconfigured": True,
        "running": False,
        "note": "served by its WhatsApp bridge" if channel else "no channel connected",
    }


