def fact_get(c, req):
    fid = int(req["id"])
    got = rows(c, "SELECT " + FACT_COLS + " FROM facts WHERE id = %s", (fid,))
    if not got:
        raise LookupError("no such fact")
    fact = got[0]
    newer = None
    if fact["superseded_by"] and fact["superseded_by"] != fid:
        n = rows(c, "SELECT id, topic, ts, content, superseded_by FROM facts WHERE id = %s",
                 (fact["superseded_by"],))
        newer = n[0] if n else None
    older = rows(c, "SELECT id, topic, ts, content FROM facts WHERE superseded_by = %s AND id <> %s "
                    "ORDER BY ts DESC LIMIT 20", (fid, fid))
    return {"fact": fact, "newer": newer, "older": older}


def _insert(c, content, topic, session, confidence, meta):
    content = F.redact(content)
    vec = F._vec((F.embed([content]) or [None])[0])
    similar = []
    if vec is not None:
        similar = [s for s in F._candidates(c, vec, topic) if s["sim"] >= F.SIM_CANDIDATE][:5]
    new_id = c.execute(
        "INSERT INTO facts (content, topic, source_session, confidence, embedding, meta) "
        "VALUES (%s, %s, %s, %s, %s::vector, %s::jsonb) RETURNING id",
        (content, topic, session, confidence, vec, json.dumps(meta))).fetchone()[0]
    return new_id, vec is not None, similar


def fact_add(c, req):
    meta = {"source": "dashboard", "kind": req.get("kind") or "fact", "added_by": req["actor"]}
    if req.get("project"):
        meta["project"] = req["project"]
    new_id, embedded, similar = _insert(c, req["content"], req["topic"], None, None, meta)
    c.commit()
    return {"id": new_id, "embedded": embedded,
            "similar": [{"id": s["id"], "sim": round(s["sim"], 3), "content": s["content"][:200]}
                        for s in similar]}


def fact_edit(c, req):
    fid = int(req["id"])
    old = c.execute("SELECT content, topic, source_session, confidence, meta, superseded_by "
                    "FROM facts WHERE id = %s FOR UPDATE", (fid,)).fetchone()
    if not old:
        raise LookupError("no such fact")
    if old[5] is not None:
        raise ValueError("fact %d is already superseded; edit its current version instead" % fid)
    old_meta = old[4] or {}
    meta = {"source": "dashboard", "kind": req.get("kind") or old_meta.get("kind") or "fact",
            "edited_from": fid, "edited_by": req["actor"]}
    if old_meta.get("project"):
        meta["project"] = old_meta["project"]
    new_id, embedded, _ = _insert(c, req["content"], req["topic"], old[2], old[3], meta)
    c.execute("UPDATE facts SET superseded_by = %s WHERE id = %s AND superseded_by IS NULL",
              (new_id, fid))
    c.commit()
    return {"id": new_id, "superseded": fid, "embedded": embedded}


def fact_forget(c, req):
    fid = int(req["id"])
    if not F.forget(fid, req["reason"]):
        raise ValueError("fact %d is not current (already superseded or forgotten)" % fid)
    c.execute("UPDATE facts SET meta = meta || %s::jsonb WHERE id = %s",
              (json.dumps({"forgotten_by": req["actor"], "forgotten_via": "dashboard"}), fid))
    c.commit()
    return {"id": fid, "forgotten": True}


def session_memory(c, req):
    sid = req["session"]
    lim, off = int(req.get("limit", 40)), int(req.get("offset", 0))
    total = c.execute("SELECT count(*) FROM chunks WHERE session_id = %s", (sid,)).fetchone()[0]
    chunks = rows(c,
        "SELECT id, source, ts, role, turn_index, project, left(content, 1500) AS content, "
        "length(content) AS chars, meta->>'agent_type' AS agent_type, "
        "meta->>'subagent_id' AS subagent_id FROM chunks WHERE session_id = %s "
        "ORDER BY turn_index NULLS LAST, id LIMIT %s OFFSET %s", (sid, lim, off))
    facts = rows(c, "SELECT " + FACT_COLS + " FROM facts WHERE source_session = %s "
                    "ORDER BY ts DESC, id DESC LIMIT 200", (sid,))
    return {"total_chunks": total, "chunks": chunks, "facts": facts}


def index_info(c, req):
