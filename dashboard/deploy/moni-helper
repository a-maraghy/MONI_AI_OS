def cc_bridge(op, **params):
    if not os.path.exists(CC_VENV_PY):
        raise CCError("the claude-memory venv is not installed")
    env = {"PATH": "/usr/local/bin:/usr/bin:/bin", "HOME": "/root", "LANG": "C.UTF-8",
           "CLAUDE_MEMORY_INTERNAL": "1"}
    params["op"] = op
    try:
        r = subprocess.run([CC_VENV_PY, "-I", "-c", CC_BRIDGE], input=json.dumps(params),
                           capture_output=True, text=True, timeout=60, cwd=CC_MEM_ROOT, env=env)
    except subprocess.TimeoutExpired:
        raise CCError("the memory database did not answer in time")
    try:
        out = json.loads(r.stdout.strip().splitlines()[-1])
    except Exception:
        raise CCError("memory bridge failed: " + (r.stderr.strip()[-300:] or "no output"))
    if not out.get("ok"):
        raise CCError(out.get("error") or "memory bridge failed")
    return out["data"]


def cc_http(path, payload=None, timeout=20):
    data = None if payload is None else json.dumps(payload).encode()
    req = urllib.request.Request(CC_SERVICE_URL + path, data=data,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8", "replace"))


def cc_systemd(unit, props):
    r = run(["systemctl", "show", unit, "-p", ",".join(props), "--no-pager"], timeout=10)
    out = {}
    for line in r.stdout.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            out[k] = v
    return out


