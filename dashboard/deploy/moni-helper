# ----------------------------------------------------------------- redaction

# The helper's own pass. memlib's redactor runs after it when it can be loaded,
# and the dashboard runs redactDeep() over the JSON after that, so a secret has
# to slip past three different rule sets to reach a browser.
CC_SECRET_PATTERNS = [
    (re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----.*?(?:-----END [A-Z0-9 ]*PRIVATE KEY-----|\Z)", re.S),
     "[REDACTED:private_key]"),
    (re.compile(r"sk-ant-[A-Za-z0-9_\-]{8,}"), "[REDACTED:anthropic_key]"),
    (re.compile(r"(?<![A-Za-z0-9])sk-[A-Za-z0-9_\-]{20,}"), "[REDACTED:api_key]"),
    (re.compile(r"(?<![A-Za-z0-9])(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})"),
     "[REDACTED:github_token]"),
    (re.compile(r"(?i)(\bBearer\s+)[A-Za-z0-9\-._~+/]{8,}=*"), r"\1[REDACTED:bearer]"),
    (re.compile(r"(CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY|OPENAI_API_KEY)([\"']?\s*[=:]\s*[\"']?)[^\s\"',;]+"),
     r"\1\2[REDACTED:token]"),
    (re.compile(r"(?i)\b(password|passwd)([\"']?\s*[=:]\s*[\"']?)(?!\d+\b)[^\s\"',;}]{1,200}"),
     r"\1\2[REDACTED:password]"),
    (re.compile(r"\b\d{6,12}:[A-Za-z0-9_\-]{30,60}\b"), "[REDACTED:bot_token]"),
    (re.compile(r"(?<![A-Za-z0-9_\-])eyJ[A-Za-z0-9_\-]{10,}\.eyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}"),
     "[REDACTED:jwt]"),
]

_CC_MEMLIB_REDACT = []


def _cc_memlib_redact():
    """memlib.redact.redact, loaded by path (it is stdlib-only). None if absent."""
    if not _CC_MEMLIB_REDACT:
        fn = None
        try:
            spec = importlib.util.spec_from_file_location(
                "cc_memlib_redact", os.path.join(CC_MEM_ROOT, "memlib", "redact.py"))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            fn = mod.redact
        except Exception:
            fn = None
        _CC_MEMLIB_REDACT.append(fn)
    return _CC_MEMLIB_REDACT[0]


def cc_redact(text):
    if not isinstance(text, str) or not text:
        return text
    for pattern, repl in CC_SECRET_PATTERNS:
        text = pattern.sub(repl, text)
    fn = _cc_memlib_redact()
    if fn is not None:
        try:
            out = fn(text)
            text = out[0] if isinstance(out, tuple) else out
        except Exception:
            pass
    return text


def cc_redact_deep(value):
    if isinstance(value, str):
        return cc_redact(value)
    if isinstance(value, list):
        return [cc_redact_deep(v) for v in value]
    if isinstance(value, dict):
        return {k: cc_redact_deep(v) for k, v in value.items()}
    return value


def cc_ok(data):
    ok(cc_redact_deep(data))


def cc_run(fn, *a, **kw):
    """Run a core function and translate its refusal into the helper's fail()."""
    try:
        return fn(*a, **kw)
    except CCError as exc:
        fail(cc_redact(str(exc)))


# ---------------------------------------------------------------- validation

def cc_home(key):
    if key not in CC_HOMES:
        raise CCError("unknown Claude home: " + repr(key))
    return CC_HOMES[key]


def cc_uuid(value):
    value = str(value or "")
    if not UUID_RE.match(value):
        raise CCError("not a session id")
    return value


def cc_slug(value):
    value = str(value or "")
    if not CC_SLUG_RE.match(value) or value in (".", ".."):
        raise CCError("not a project folder name")
    return value


def cc_actor(payload):
    actor = str(payload.get("actor") or "")
    if not CC_ACTOR_RE.match(actor):
        raise CCError("missing or malformed actor")
    return actor


def cc_int(value, lo, hi, default):
    try:
        n = int(value)
    except (TypeError, ValueError):
        return default
    return max(lo, min(hi, n))


def cc_text(value, what, limit, single_line=False):
    text = str(value or "").replace("\r\n", "\n").strip()
    if not text:
        raise CCError(what + " is required")
    if len(text) > limit:
        raise CCError(what + " is too long (max %d characters)" % limit)
    if "\x00" in text or (single_line and ("\n" in text or CC_CONTROL_RE.search(text))):
        raise CCError(what + " contains characters that are not allowed")
    return text


def cc_under(path, root):
    """Resolve `path` and insist it stays inside `root` -- symlinks included."""
    real = os.path.realpath(path)
    real_root = os.path.realpath(root)
    if real != real_root and not real.startswith(real_root + os.sep):
        raise CCError("path escapes its allowed root")
    return real


def cc_plain_file(path, root):
    if os.path.islink(path):
        raise CCError("refusing to follow a symlink")
    real = cc_under(path, root)
    if not os.path.isfile(real):
        raise CCError("no such file")
    return real


def cc_read_payload():
    raw = sys.stdin.buffer.read(MAX_STDIN_BYTES + 1)
    if len(raw) > MAX_STDIN_BYTES:
        raise CCError("stdin payload too large")
    if not raw.strip():
        return {}
    try:
        payload = json.loads(raw.decode("utf-8"))
    except Exception:
        raise CCError("stdin is not valid JSON")
    if not isinstance(payload, dict):
        raise CCError("stdin must be a JSON object")
    return payload


