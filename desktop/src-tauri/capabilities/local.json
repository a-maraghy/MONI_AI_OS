{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-pages",
  "description": "The app's own pages (dist/): the connecting / offline card in the main window, and the Settings window.",
  "windows": [
    "mint",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "allow-get-state",
    "allow-set-hit-regions",
    "allow-go-site",
    "allow-open-full-cc",
    "allow-settings-get",
    "allow-settings-set",
    "allow-settings-check-update",
    "allow-settings-close"
  ]
}
