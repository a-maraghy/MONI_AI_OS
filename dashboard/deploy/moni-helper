# ============================================================= pulse feed ====
#
# What happened on the machine since the last time the overview asked: the
# events its "Machine core" web draws as pulses. Read-only, and deliberately
# thin: every event is a type, a time and at most a unit, jail or agent name.
# No address, no user name, no message text ever leaves this function -- the
# lines are parsed here and only the verdict is returned.
#
# The cursor is opaque to the dashboard and handed back on the next call: a
# journal cursor, an (inode, offset) per log file and the last message id per
# agent. A first call (no cursor) looks back PULSE_LOOKBACK seconds so the
# ticker opens with what just happened, then carries on from the end.

PULSE_FILES = {
    "f2b": "/var/log/fail2ban.log",
    "hooks": "/var/log/claude-memory-hooks.log",
    "web_panel": "/var/log/nginx/moni-access.log",
    "web_odoo": "/var/log/nginx/odoo-access.log",
    "web_other": "/var/log/nginx/access.log",
}
PULSE_LOOKBACK = 15 * 60
PULSE_MAX_READ = 512 * 1024
PULSE_MAX_EVENTS = 60  # per type and call; the rest are counted, not listed
JOURNAL_CURSOR_RE = re.compile(r"^[a-z0-9=;_-]{20,400}$")
SSH_OK_RE = re.compile(r"^Accepted \S+ for ")
SSH_FAIL_RE = re.compile(r"^(Connection (closed|reset) by (authenticating|invalid) user |Failed (password|publickey|none|keyboard-interactive) for )")
F2B_RE = re.compile(
    r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d),\d+ fail2ban\.actions\s+\[\d+\]:\s+NOTICE\s+\[([A-Za-z0-9_.-]{1,40})\] (Ban|Unban) "
)
HOOK_RE = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d) (\w+) (\{.*\})\s*$")
NGINX_TIME_RE = re.compile(r"\[(\d\d/\w{3}/\d{4}:\d\d:\d\d:\d\d [+-]\d{4})\]")


def pulse_journal(argv):
    """journalctl -o json lines as dicts; injectable so the tests can feed fixtures."""
    r = run(["journalctl", "--no-pager", "-o", "json",
             "--output-fields=MESSAGE,UNIT,JOB_TYPE,JOB_RESULT,_SYSTEMD_UNIT,_PID"] + argv, timeout=20)
    if r.returncode not in (0, 1):
        raise RuntimeError("journalctl failed")
    out = []
    for line in r.stdout.splitlines():
        try:
            out.append(json.loads(line))
        except ValueError:
            continue
    return out


def pulse_iso(epoch):
    return datetime.fromtimestamp(epoch, timezone.utc).isoformat(timespec="seconds")


def pulse_msg(entry):
    m = entry.get("MESSAGE")
    if isinstance(m, list):  # journald hands non-UTF-8 messages over as bytes
        try:
            m = bytes(m).decode("utf-8", "replace")
        except Exception:
            m = ""
    return m if isinstance(m, str) else ""


def pulse_classify_journal(entries, units, since_epoch=None):
    """Journal entries -> events. `units` is the set of tracked unit names."""
    events, counts = [], {}
    for e in entries:
        try:
            ts = int(e.get("__REALTIME_TIMESTAMP", "0")) / 1e6
        except ValueError:
            continue
        if since_epoch is not None and ts < since_epoch:
            continue
        msg = pulse_msg(e)
        ev = None
        if e.get("_SYSTEMD_UNIT") == "ssh.service":
            if SSH_OK_RE.match(msg):
                ev = {"type": "ssh-login"}
            elif SSH_FAIL_RE.match(msg):
                ev = {"type": "ssh-fail"}
        elif str(e.get("_PID")) == "1" and e.get("JOB_TYPE") == "start" and e.get("JOB_RESULT") == "done":
            unit = str(e.get("UNIT", ""))
            if unit.endswith(".service") and unit[:-8] in units:
                ev = {"type": "start", "unit": unit[:-8]}
        if not ev:
            continue
        counts[ev["type"]] = counts.get(ev["type"], 0) + 1
        if counts[ev["type"]] <= PULSE_MAX_EVENTS:
            ev["at"] = pulse_iso(ts)
            events.append(ev)
    return events, counts


def pulse_read_new(path, state, tail_bytes=0):
    """New complete lines of an append-only log since `state` = [inode, offset].

    No state: start at the end (or `tail_bytes` before it). A different inode or
    a shorter file means the log was rotated: read the new one from the start.
    Returns (lines, new_state). Never reads more than PULSE_MAX_READ.
    """
    st = os.stat(path)
    size, ino = st.st_size, st.st_ino
    if state is None:
        start = max(0, size - tail_bytes)
    elif state[0] != ino or state[1] > size:
        start = 0
    else:
        start = state[1]
    if size - start > PULSE_MAX_READ:
        start = size - PULSE_MAX_READ
    if start >= size:
        return [], [ino, size]
    with open(path, "rb") as fh:
        fh.seek(start)
        chunk = fh.read(size - start)
    end = chunk.rfind(b"\n")
    if end < 0:
        return [], [ino, start]
    lines = chunk[:end].decode("utf-8", "replace").split("\n")
    if start > 0 and (state is None or state[0] != ino or start != state[1]):
        lines = lines[1:]  # began mid-line
    return lines, [ino, start + end + 1]


def pulse_f2b(lines, since_epoch=None):
    events = []
    for line in lines:
        m = F2B_RE.match(line)
        if not m:
            continue
        ts = time_local(m.group(1))
        if ts is None or (since_epoch is not None and ts < since_epoch):
            continue
        events.append({"type": "ban" if m.group(3) == "Ban" else "unban", "jail": m.group(2), "at": pulse_iso(ts)})
    return events[-PULSE_MAX_EVENTS:]


def time_local(text):
    try:
        return datetime.strptime(text, "%Y-%m-%d %H:%M:%S").timestamp()  # the box's own zone
    except ValueError:
        return None


def pulse_hooks(lines, now):
    """claude-memory hook lines that started an ingest.

    The hook log is written by processes in different time zones, so its
    stamps are not trusted for live events: a line new since the last call
    happened within the last poll, and is stamped with the time it was read.
    """
    n = 0
    for line in lines:
        m = HOOK_RE.match(line)
        if not m:
            continue
        try:
            if json.loads(m.group(3)).get("ingest") is True:
                n += 1
        except ValueError:
            continue
    return [{"type": "ingest", "at": pulse_iso(now)} for _ in range(min(n, PULSE_MAX_EVENTS))]


def agent_db_path(slug):
    return os.path.join(agent_dir(slug), "data", "bot.db")


def pulse_replies(slug, last_id, since_epoch=None):
    """Replies an agent sent: rows of its own messages table that carry a response.

    The agents do not log replies to the journal (only start-up and errors), so
    their bot.db is the record. Opened read-only; only ids and times are read.
    """
    import sqlite3
    path = agent_db_path(slug)
    if not os.path.isfile(path):
        raise FileNotFoundError(path)
    con = sqlite3.connect("file:" + path + "?mode=ro", uri=True, timeout=2)
    try:
        if last_id is None:
            row = con.execute("SELECT COALESCE(MAX(message_id), 0) FROM messages").fetchone()
            top = int(row[0] or 0)
            rows = con.execute(
                "SELECT message_id, timestamp FROM messages WHERE response IS NOT NULL ORDER BY message_id DESC LIMIT 20"
            ).fetchall()
            rows = list(reversed(rows))
        else:
            rows = con.execute(
                "SELECT message_id, timestamp FROM messages WHERE message_id > ? AND response IS NOT NULL "
                "ORDER BY message_id LIMIT ?", (int(last_id), PULSE_MAX_EVENTS)
            ).fetchall()
            top = max([int(last_id)] + [int(r[0]) for r in rows])
    finally:
        con.close()
    events = []
    for mid, stamp in rows:
        ts = parse_any_time(stamp)
        if ts is None:
            continue
        if since_epoch is not None and ts < since_epoch:
            continue
        events.append({"type": "reply", "agent": slug, "at": pulse_iso(ts)})
    return events, top


def parse_any_time(stamp):
    if not isinstance(stamp, str) or not stamp:
        return None
    s = stamp.strip().replace(" ", "T", 1)
    try:
        d = datetime.fromisoformat(s)
    except ValueError:
        return None
    if d.tzinfo is None:
        d = d.replace(tzinfo=timezone.utc)  # SQLite CURRENT_TIMESTAMP is UTC
    return d.timestamp()


def pulse_check_cursor(cur):
    """Refuse anything but the exact shape this helper hands out."""
    if cur is None:
        return None
    if not isinstance(cur, dict) or set(cur) - {"j", "f", "r"}:
        fail("bad cursor")
    j = cur.get("j")
    if j is not None and (not isinstance(j, str) or not JOURNAL_CURSOR_RE.match(j)):
        fail("bad cursor")
    f = cur.get("f") or {}
    if not isinstance(f, dict) or set(f) - set(PULSE_FILES):
        fail("bad cursor")
    for v in f.values():
        if not (isinstance(v, list) and len(v) == 2 and all(isinstance(x, int) and 0 <= x < 2 ** 63 for x in v)):
            fail("bad cursor")
    r = cur.get("r") or {}
    if not isinstance(r, dict) or len(r) > 200:
        fail("bad cursor")
    for k, v in r.items():
        if not SLUG_RE.match(k) or not isinstance(v, int) or not 0 <= v < 2 ** 63:
            fail("bad cursor")
    return {"j": j, "f": f, "r": r}


def pulse_feed(cur, now=None):
    now = now or datetime.now(timezone.utc).timestamp()
    first = cur is None
    cur = cur or {"j": None, "f": {}, "r": {}}
    since = now - PULSE_LOOKBACK if first else None
    units = set(tracked_units())
    events, counts, unavailable = [], {}, []
    nxt = {"j": cur.get("j"), "f": dict(cur.get("f") or {}), "r": dict(cur.get("r") or {})}

    # the journal: SSH and unit starts, one call
    try:
        argv = ["_SYSTEMD_UNIT=ssh.service", "+", "_PID=1"]
        if cur.get("j"):
            argv = ["--after-cursor", cur["j"]] + argv
        else:
            argv = ["--since", "-%ds" % PULSE_LOOKBACK] + argv
        entries = pulse_journal(argv)
        if entries and isinstance(entries[-1].get("__CURSOR"), str) and JOURNAL_CURSOR_RE.match(entries[-1]["__CURSOR"]):
            nxt["j"] = entries[-1]["__CURSOR"]
        ev, cn = pulse_classify_journal(entries, units)
        events += ev
        for k, v in cn.items():
            counts[k] = counts.get(k, 0) + v
    except Exception:
        unavailable.append("journal")

    # fail2ban's own log: bans and unbans, with the jail
    try:
        lines, nxt["f"]["f2b"] = pulse_read_new(PULSE_FILES["f2b"], cur["f"].get("f2b"), 64 * 1024 if first else 0)
        ev = pulse_f2b(lines, since)
        events += ev
        for e in ev:
            counts[e["type"]] = counts.get(e["type"], 0) + 1
    except Exception:
        unavailable.append("fail2ban")

    # the memory service's hook log: ingests
    try:
        lines, nxt["f"]["hooks"] = pulse_read_new(PULSE_FILES["hooks"], cur["f"].get("hooks"))
        ev = pulse_hooks(lines if not first else [], now)
        events += ev
        if ev:
            counts["ingest"] = len(ev)
    except Exception:
        unavailable.append("memory-hooks")

    # nginx: request counts only, for the faint traffic
    for key in ("web_panel", "web_odoo", "web_other"):
        try:
            lines, nxt["f"][key] = pulse_read_new(PULSE_FILES[key], cur["f"].get(key))
            counts[key] = 0 if first else sum(1 for ln in lines if ln.strip())
        except Exception:
            unavailable.append(key.replace("_", "-"))

    # agent replies, from each agent's own database
    slugs = all_agent_slugs()
    for slug in slugs:
        try:
            ev, top = pulse_replies(slug, cur["r"].get(slug) if not first else None, since)
            nxt["r"][slug] = top
            events += ev
            if ev:
                counts["reply"] = counts.get("reply", 0) + len(ev)
        except Exception:
            unavailable.append("replies:" + slug)
    for gone in [s for s in nxt["r"] if s not in slugs]:
        del nxt["r"][gone]

    events.sort(key=lambda e: e["at"])
    return {"cursor": nxt, "events": events, "counts": counts, "unavailable": unavailable, "now": pulse_iso(now)}


def pulse_totals(now=None):
    """The last 24 hours per event type: what the web's thread thickness is drawn from."""
    now = now or datetime.now(timezone.utc).timestamp()
    since = now - 86400
    units = set(tracked_units())
    totals, unavailable, starts = {}, [], {}
    try:
        entries = pulse_journal(["--since", "-24h", "_SYSTEMD_UNIT=ssh.service", "+", "_PID=1"])
        global PULSE_MAX_EVENTS
        keep, PULSE_MAX_EVENTS = PULSE_MAX_EVENTS, 10 ** 9
        try:
            ev, cn = pulse_classify_journal(entries, units, since)
        finally:
            PULSE_MAX_EVENTS = keep
        totals.update({k: v for k, v in cn.items() if k != "start"})
        for e in ev:
            if e["type"] == "start":
                starts[e["unit"]] = starts.get(e["unit"], 0) + 1
        totals["start"] = sum(starts.values())
    except Exception:
        unavailable.append("journal")

    def lines_of(path):
        out = []
        for p in (path + ".1", path):
            if os.path.isfile(p):
                with open(p, "rb") as fh:
                    if os.path.getsize(p) > 64 * 1024 * 1024:
                        fh.seek(-64 * 1024 * 1024, 2)
                    out += fh.read().decode("utf-8", "replace").splitlines()
        return out

    try:
        n_ban = n_unban = 0
        for line in lines_of(PULSE_FILES["f2b"]):
            m = F2B_RE.match(line)
            if m:
                ts = time_local(m.group(1))
                if ts is not None and ts >= since:
                    if m.group(3) == "Ban":
                        n_ban += 1
                    else:
                        n_unban += 1
        totals["ban"], totals["unban"] = n_ban, n_unban
    except Exception:
        unavailable.append("fail2ban")
    try:
        # Stamps in this log come from processes in more than one zone; an hour
        # of slack either way is the honest precision of this count.
        n = 0
        for line in lines_of(PULSE_FILES["hooks"]):
            m = HOOK_RE.match(line)
            if not m:
                continue
            ts = time_local(m.group(1).replace("T", " "))
            if ts is None or ts < since:
                continue
            try:
                if json.loads(m.group(3)).get("ingest") is True:
                    n += 1
            except ValueError:
                pass
        totals["ingest"] = n
    except Exception:
        unavailable.append("memory-hooks")
    for key in ("web_panel", "web_odoo", "web_other"):
        try:
            n = 0
            for line in lines_of(PULSE_FILES[key]):
                m = NGINX_TIME_RE.search(line)
                if not m:
                    continue
                try:
                    ts = datetime.strptime(m.group(1), "%d/%b/%Y:%H:%M:%S %z").timestamp()
                except ValueError:
                    continue
                if ts >= since:
                    n += 1
            totals[key] = n
        except Exception:
            unavailable.append(key.replace("_", "-"))
    replies, by_agent = 0, {}
    for slug in all_agent_slugs():
        try:
            import sqlite3
            path = agent_db_path(slug)
            if not os.path.isfile(path):
                raise FileNotFoundError(path)
            con = sqlite3.connect("file:" + path + "?mode=ro", uri=True, timeout=2)
            try:
                for (stamp,) in con.execute("SELECT timestamp FROM messages WHERE response IS NOT NULL ORDER BY message_id DESC LIMIT 5000"):
                    ts = parse_any_time(stamp)
                    if ts is not None and ts >= since:
                        replies += 1
                        by_agent[slug] = by_agent.get(slug, 0) + 1
            finally:
                con.close()
        except Exception:
            unavailable.append("replies:" + slug)
    totals["reply"] = replies
    totals["reply_by_agent"] = by_agent
    return {"totals": totals, "starts": starts, "unavailable": unavailable, "now": pulse_iso(now)}


def cmd_pulse_feed(args):
    """pulse-feed [totals] -- cursor as {"cursor": ...} on stdin."""
    if args and args[0] == "totals":
        return ok(pulse_totals())
    if args:
        fail("usage: pulse-feed [totals]")
    payload = read_stdin_json()
    if set(payload) - {"cursor"}:
        fail("unexpected field")
    ok(pulse_feed(pulse_check_cursor(payload.get("cursor"))))


# =============================================================== firewall ====
#
# Two systems produce one answer here. ufw holds the standing rules; fail2ban
# watches the logs and inserts its own bans through ufw's own command, so a ban
# placed by a jail and a ban placed by hand land in the same table and can only
# be told apart by the comment each leaves behind. Everything below reads both
# and reports them as one list, because "who is blocked right now" is one
# question and answering it from two places is how an address stays blocked
# after somebody believes they have released it.

UFW = "/usr/sbin/ufw"
F2B = "/usr/bin/fail2ban-client"

# What each system stamps on the rules it owns. fail2ban's wording comes from
# its ufw action; ours is chosen to be obvious in `ufw status` to somebody who
# has never seen this panel.
MANUAL_TAG = "MONI panel"
F2B_TAG = "by Fail2Ban"

BLOCKING = ("DENY", "REJECT")

# A ban typed into a form outlives the session that typed it, so how much one
# may cover is capped. /24 is 256 addresses: wide enough to shut out a noisy
# subnet, narrow enough that a slipped keystroke cannot black-hole a continent.
MIN_PREFIX = {4: 24, 6: 64}

# `[ 1] Anywhere      DENY IN     198.51.100.7    # MONI panel: probing /admin`
# Columns are separated by runs of spaces, and the comment is optional.
UFW_RULE_RE = re.compile(
    r"^\[\s*(?P<num>\d+)\]\s+(?P<to>.+?)\s\s+"
    r"(?P<action>(?:ALLOW|DENY|REJECT|LIMIT)(?:\s+(?:IN|OUT|FWD))?)\s\s+"
    r"(?P<frm>.+?)\s*(?:#\s*(?P<comment>.*?))?\s*$"
)

# `187.18.8.5   2026-09-09 23:06:53 + 7200 = 2026-09-10 01:06:53`
F2B_BAN_RE = re.compile(
    r"^(?P<ip>\S+)\s+(?P<since>[\d-]{10} [\d:]{8})\s*\+\s*(?P<secs>-?\d+)"
    r"\s*=\s*(?P<until>[\d-]{10} [\d:]{8})"
)


def ufw_rules():
    r = run([UFW, "status", "numbered"], timeout=20)
    if r.returncode != 0:
        fail((r.stderr.strip() or "ufw status failed")[:300])
    rules = []
    for line in r.stdout.splitlines():
        m = UFW_RULE_RE.match(line.rstrip())
        if not m:
            continue
        rules.append({
            "num": int(m.group("num")),
            "to": m.group("to").strip(),
            "action": " ".join(m.group("action").split()),
            "from": m.group("frm").strip(),
            "comment": (m.group("comment") or "").strip(),
        })
    return rules


def ufw_state():
    r = run([UFW, "status", "verbose"], timeout=20)
    state = {"active": False, "logging": "unknown", "default": "unknown"}
    for line in r.stdout.splitlines():
        if line.startswith("Status:"):
            state["active"] = line.split(":", 1)[1].strip() == "active"
        elif line.startswith("Logging:"):
            state["logging"] = line.split(":", 1)[1].strip()
        elif line.startswith("Default:"):
            state["default"] = line.split(":", 1)[1].strip()
    return state


def rule_target(rule):
    """The single address a blocking rule applies to, or None."""
    parts = rule["from"].split()
    if not parts:
        return None
    try:
        return ipaddress.ip_network(parts[0], strict=False)
    except ValueError:
        return None


def blocking_rules_for(target):
    return [
        r for r in ufw_rules()
        if r["action"].split()[0] in BLOCKING and rule_target(r) == target
    ]


def f2b(*args, **kwargs):
    return run([F2B] + list(args), timeout=kwargs.pop("timeout", 15))


def jail_names():
    r = f2b("status")
    if r.returncode != 0:
        return []
    for line in r.stdout.splitlines():
        if "Jail list:" in line:
            return [n.strip() for n in line.split(":", 1)[1].split(",") if n.strip()]
    return []


def jail_setting(jail, key):
    r = f2b("get", jail, key)
    try:
        return int(r.stdout.strip())
    except (ValueError, TypeError):
        return None


def jail_bans(jail):
    r = f2b("get", jail, "banip", "--with-time")
    bans = []
    for line in r.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        m = F2B_BAN_RE.match(line)
        if m:
            bans.append({
                "ip": m.group("ip"),
                "since": m.group("since"),
                "until": m.group("until"),
                # -1 is fail2ban's "until somebody says otherwise".
                "seconds": int(m.group("secs")),
            })
        else:
            # A permanent ban, or a format this version words differently. The
            # address is still the first token and is the part that matters.
            bans.append({"ip": line.split()[0], "since": None, "until": None,
                         "seconds": None})
    return bans


def jail_total(jail):
    r = f2b("status", jail)
    for line in r.stdout.splitlines():
        if "Total banned:" in line:
            try:
                return int(line.split(":")[-1].strip())
            except ValueError:
                return None
    return None


def host_addresses():
    """Every address this machine answers on, so none of them can be banned."""
    r = run(["ip", "-json", "addr"], timeout=10)
    out = []
    try:
        for iface in json.loads(r.stdout or "[]"):
            for info in iface.get("addr_info") or []:
                try:
                    out.append(ipaddress.ip_address(info.get("local") or ""))
                except ValueError:
                    pass
    except Exception:
        pass
    return out


def check_ban_target(value, requester):
    """Validate a ban target, refusing the ones that would do harm."""
    text = str(value or "").strip()
    if not text or len(text) > 49:
        fail("enter an IP address or a CIDR block")
    try:
        net = ipaddress.ip_network(text, strict=False)
    except ValueError:
        fail("not an IP address or CIDR block: " + repr(text[:40]))

    # The two easy ways to lock yourself out are to block the address you are
    # sitting at and to block one of the machine's own. Neither is recoverable
    # from this panel afterwards -- it would be behind the rule it just wrote.
    #
    # Checked before the range rules below so that somebody reaching the panel
    # over a VPN or a LAN is told "that is you" rather than "that is private",
    # which is true but is not the reason they need to hear.
    here = str(requester or "").strip()
    if here:
        try:
            if ipaddress.ip_address(here) in net:
                fail("you are connected from " + here + ", which that rule covers. "
                     "Blocking it would lock you out of this panel.")
        except ValueError:
            pass
    for addr in host_addresses():
        if addr in net:
            fail("that covers " + str(addr) + ", an address of this machine.")

    if (net.is_loopback or net.is_link_local or net.is_multicast
            or net.is_unspecified or net.is_reserved):
        fail("that is not a public address, so blocking it would achieve nothing")
    if net.is_private:
        fail("that is a private range. Nobody on the internet reaches this machine "
             "from it, and blocking it can cut the host off from its own network.")

    limit = MIN_PREFIX[net.version]
    if net.prefixlen < limit:
        fail("that block is wider than /%d. Ban the address itself, or its /%d."
             % (limit, limit))
    return net


def ban_target_text(net):
    return str(net) if net.num_addresses > 1 else str(net.network_address)


def cmd_firewall_status(args):
    rules = ufw_rules()

    manual = []
    for rule in rules:
        if rule["action"].split()[0] not in BLOCKING:
            continue
        # fail2ban's rules are reported under the jail that owns them, with the
        # expiry the jail knows about. Listing them here as well would show the
        # same address twice with an Unban button that only half works.
        if F2B_TAG in rule["comment"]:
            continue
        net = rule_target(rule)
        if net is None:
            continue
        note = rule["comment"]
        panel = note.startswith(MANUAL_TAG)
        if panel:
            note = note[len(MANUAL_TAG):].lstrip(": ").strip()
        manual.append({
            "ip": ban_target_text(net),
            "num": rule["num"],
            "action": rule["action"],
            "note": note,
            "panel": panel,
        })

    jails = []
    for name in jail_names():
        jails.append({
            "name": name,
            "bans": jail_bans(name),
            "total": jail_total(name),
            "maxretry": jail_setting(name, "maxretry"),
            "findtime": jail_setting(name, "findtime"),
            "bantime": jail_setting(name, "bantime"),
        })

    ok({
        "ufw": ufw_state(),
        "fail2ban": bool(jails),
        # fail2ban stamps its bans in the host's local time with no offset on
        # them, so the page has to be told which clock it is reading.
        "tz": datetime.now().astimezone().tzname() or "server time",
        "jails": jails,
        "manual": manual,
        "allowed": [r for r in rules if r["action"].split()[0] in ("ALLOW", "LIMIT")],
    })


def cmd_firewall_ban(args):
    payload = read_stdin_json()
    net = check_ban_target(payload.get("ip"), payload.get("requester"))
    note = str(payload.get("note") or "").strip()
    if note and not COMMENT_RE.match(note):
        fail("the note may only use letters, numbers, spaces and . _ @ : + -")
    target = ban_target_text(net)

    rules = ufw_rules()
    if any(r["action"].split()[0] in BLOCKING and rule_target(r) == net for r in rules):
        fail(target + " is already blocked.")

    comment = MANUAL_TAG + (": " + note if note else "")
    # Position 1: the allow rules for SSH and this panel sit below, and a deny
    # placed after them would never be reached. An empty table has no position 1.
    argv = [UFW]
    if rules:
        argv += ["insert", "1"]
    argv += ["deny", "from", target, "comment", comment]

    r = run(argv, timeout=30)
    if r.returncode != 0:
        fail((r.stderr.strip() or r.stdout.strip() or "ufw refused the rule")[:300])
    audit("firewall-ban", {"target": target, "note": note})
    ok({"ip": target, "note": note})


def cmd_firewall_unban(args):
    payload = read_stdin_json()
    text = str(payload.get("ip") or "").strip()
    try:
        net = ipaddress.ip_network(text, strict=False)
    except ValueError:
        fail("not an IP address or CIDR block")
    target = ban_target_text(net)

    cleared = []
    # fail2ban is asked first and asked properly: `unban` drops its ufw rule and
    # clears the strike record together. Deleting the rule by hand would leave
    # the jail believing the address is still banned, and it would never be
    # re-banned on the next attempt because it never left.
    r = f2b("unban", target, timeout=30)
    if r.returncode == 0 and (r.stdout.strip() or "0") not in ("0", ""):
        cleared.append("fail2ban")

    # Re-listed every pass because deleting by number renumbers what is left.
    removed = 0
    while removed < 16:
        hits = blocking_rules_for(net)
        if not hits:
            break
        d = run([UFW, "--force", "delete", str(hits[0]["num"])], timeout=30)
        if d.returncode != 0:
            fail((d.stderr.strip() or "ufw refused to delete the rule")[:300])
        removed += 1
    if removed:
        cleared.append("%d firewall rule%s" % (removed, "" if removed == 1 else "s"))

    if not cleared:
        fail(target + " is not blocked.")
    audit("firewall-unban", {"target": target, "cleared": cleared})
    ok({"ip": target, "cleared": cleared})


# ============================================================ credentials ====


def check_credential(name):
    spec = CREDENTIAL_FILES.get(name)
    if not spec:
        fail("unknown credential file: " + repr(name))
    return spec


def cmd_credential_get(args):
    """Return a credential file with the secret values masked.

    The panel needs to show whether a credential is set and let it be replaced.
    It does not need to display the secret, and a token echoed into a browser is
    a token in a screenshot, a proxy log and a scrollback buffer.
    """
    if not args:
        fail("usage: credential-get <name>")
    spec = check_credential(args[0])
    path = spec["path"]
    exists = os.path.isfile(path)
    lines = []
    present = {}
    if exists:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for raw in fh.read().splitlines():
                stripped = raw.strip()
                if not stripped or stripped.startswith("#"):
                    lines.append(raw)
                    continue
                key, _, value = stripped.partition("=")
                key = key.strip()
                value = value.strip()
                if key in spec["keys"] and value:
                    present[key] = {
                        "length": len(value),
                        "preview": value[:8] + "…" + value[-4:] if len(value) > 16 else "set",
                    }
                    lines.append(key + "=" + "•" * 40)
                else:
                    lines.append(raw)
    st = os.stat(path) if exists else None
    ok(
        {
            "name": args[0],
            "label": spec["label"],
            "path": path,
            "exists": exists,
            "masked": "\n".join(lines),
            "keys": list(spec["keys"]),
            "present": present,
            "configured": bool(present),
            "mode": oct(st.st_mode & 0o777) if st else None,
            "modified": datetime.fromtimestamp(st.st_mtime, timezone.utc).isoformat(
                timespec="seconds"
            )
            if st
            else None,
        }
    )


def cmd_credential_set(args):
    """Replace one key in a credential file. Value arrives on stdin."""
    if len(args) < 2:
        fail("usage: credential-set <name> <KEY>   (value on stdin)")
    spec = check_credential(args[0])
    key = args[1]
    if key not in spec["keys"]:
        fail("key not permitted in " + args[0] + ": " + repr(key))
    value = read_stdin_text().strip()
    if not value:
        fail("empty value; use credential-clear to remove a key")
    if not ENV_VALUE_RE.match(value):
        fail("value contains a newline or null byte")
    if key in ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY") and not OAUTH_TOKEN_RE.match(value):
        fail("that does not look like an Anthropic credential (expected sk-ant-…)")
    _write_credential(spec, {key: value}, drop=[k for k in spec["keys"] if k != key])
    # systemd reads an EnvironmentFile once, at unit start. Writing the file
    # while agents are running therefore changes nothing for them -- they keep
    # the environment they booted with, the panel reports the credential as
    # configured, and the agent answers "not authenticated" with no visible
    # reason why. Restarting is not a nicety here; without it the write is a
    # no-op for every process that needs it.
    restarted = restart_all_agents()
    audit("credential-set", {"name": args[0], "key": key, "restarted": restarted})
    ok({"name": args[0], "key": key, "configured": True, "restarted": restarted})


def restart_all_agents():
    """Restart every running agent and WhatsApp bridge. Returns what it touched."""
    touched = []
    if os.path.isdir(AGENTS_DIR):
        for slug in sorted(os.listdir(AGENTS_DIR)):
            if not SLUG_RE.match(slug) or not os.path.isdir(agent_dir(slug)):
                continue
            if unit_state(slug)["active"] in ("active", "activating", "failed"):
                run(["systemctl", "reset-failed", unit_name(slug)])
                if run(["systemctl", "restart", unit_name(slug)], timeout=45).returncode == 0:
                    touched.append(slug)
    for meta in all_channels():
        if meta.get("type") != "whatsapp":
            continue
        unit = wa_unit(meta["slug"])
        if unit_state_for(unit)["active"] in ("active", "activating", "failed"):
            run(["systemctl", "reset-failed", unit])
            if run(["systemctl", "restart", unit], timeout=45).returncode == 0:
                touched.append(meta["slug"] + " (whatsapp)")
    return touched


def cmd_credential_clear(args):
    if len(args) < 2:
        fail("usage: credential-clear <name> <KEY>")
    spec = check_credential(args[0])
    key = args[1]
    if key not in spec["keys"]:
        fail("key not permitted in " + args[0] + ": " + repr(key))
    _write_credential(spec, {}, drop=[key])
    restarted = restart_all_agents()
    audit("credential-clear", {"name": args[0], "key": key, "restarted": restarted})
    ok({"name": args[0], "key": key, "configured": False, "restarted": restarted})


def _write_credential(spec, updates, drop=()):
    """Rewrite a credential file, preserving comments and ownership.

    Written through a temp file in the same directory and renamed, so a crash
    mid-write cannot leave agents with a truncated credential.
    """
    path = spec["path"]
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)

    existing = []
    if os.path.isfile(path):
        with open(path, encoding="utf-8", errors="replace") as fh:
            existing = fh.read().splitlines()

    out = []
    written = set()
    for raw in existing:
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            out.append(raw)
            continue
        key = stripped.partition("=")[0].strip()
        if key in drop and key not in updates:
            continue
        if key in updates:
            out.append(key + "=" + updates[key])
            written.add(key)
            continue
        out.append(raw)
    for key, value in updates.items():
        if key not in written:
            out.append(key + "=" + value)

    fd, tmp = tempfile.mkstemp(dir=directory)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out).rstrip() + "\n")
    uid = pwd.getpwnam(spec["owner"]).pw_uid
    gid = grp.getgrnam(spec["group"]).gr_gid
    os.chown(tmp, uid, gid)
    os.chmod(tmp, spec["mode"])
    os.replace(tmp, path)


def cmd_credential_list(args):
    out = []
    for name in sorted(CREDENTIAL_FILES):
        spec = CREDENTIAL_FILES[name]
        configured = False
        if os.path.isfile(spec["path"]):
            with open(spec["path"], encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    key, _, value = line.strip().partition("=")
                    if key.strip() in spec["keys"] and value.strip():
                        configured = True
                        break
        out.append(
            {
                "name": name,
                "label": spec["label"],
                "path": spec["path"],
                "configured": configured,
                "keys": list(spec["keys"]),
            }
        )
    ok(out)


# ========================================================== OpenAI voice ====
#
# The key the panel's voice uses: OpenAI's realtime model speaks MINT AI's
# replies and OpenAI's transcription model hears the person. Voice only --
# Claude does the thinking, so this key never reaches an agent or a model.
#
# Its own file rather than a CREDENTIAL_FILES entry: those are shared with every
# agent (group moniagent, restart-all on write), and this one is the panel's
# alone. root:root 0600 in a root-only directory under /var/lib (ProtectSystem
# makes /etc read-only to anything the panel's unit spawns). The value arrives
# on stdin, is never echoed back except by voice-key-read, and is never audited.
#
# This is deliberately a different credential from /etc/odoo/openai_key, which
# belongs to the Odoo walkthrough and is not read here.

VOICE_DIR = "/var/lib/moni-voice"
VOICE_FILE = os.path.join(VOICE_DIR, "openai-voice.env")
OPENAI_KEY_RE = re.compile(r"^sk-[A-Za-z0-9_\-]{20,300}$")
# gpt-realtime*, gpt-live*, and gpt-4o-mini-realtime-preview (and its dated
# snapshots): the voice models the panel offers (dashboard lib/voice.js VOICE_MODELS).
VOICE_MODEL_RE = re.compile(r"^gpt-(realtime|live|4o-mini-realtime)[a-z0-9.\-]{0,40}$")
VOICE_NAME_RE = re.compile(r"^[a-z]{2,20}$")
# The live session's own transcription model (always OpenAI's). gpt-transcribe
# is allowed since 2026-09-30 (Settings ▸ Voice ▸ Transcription offers it).
VOICE_TRANSCRIBE_RE = re.compile(r"^gpt-(4o-(mini-)?)?transcribe[a-z0-9.\-]{0,30}$")
VOICE_DEFAULTS = {
    "OPENAI_VOICE_MODEL": "gpt-realtime-mini",
    "OPENAI_VOICE_NAME": "marin",
    "OPENAI_TRANSCRIBE_MODEL": "gpt-4o-mini-transcribe",
}


def _voice_read():
    values = {}
    if os.path.isfile(VOICE_FILE):
        with open(VOICE_FILE, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                key, _, value = line.partition("=")
                values[key.strip()] = value.strip()
    return values


def _voice_write(values):
    os.makedirs(VOICE_DIR, mode=0o700, exist_ok=True)
    os.chown(VOICE_DIR, 0, 0)
    os.chmod(VOICE_DIR, 0o700)
    lines = ["# MONI dashboard voice (OpenAI). Written by moni-helper; root only."]
    for key in ("OPENAI_API_KEY", "OPENAI_VOICE_MODEL", "OPENAI_VOICE_NAME", "OPENAI_TRANSCRIBE_MODEL"):
        if values.get(key):
            lines.append(key + "=" + values[key])
    fd, tmp = tempfile.mkstemp(dir=VOICE_DIR)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines) + "\n")
        os.chown(tmp, 0, 0)
        os.replace(tmp, VOICE_FILE)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def _voice_options(values):
    return {
        "model": values.get("OPENAI_VOICE_MODEL") or VOICE_DEFAULTS["OPENAI_VOICE_MODEL"],
        "voice": values.get("OPENAI_VOICE_NAME") or VOICE_DEFAULTS["OPENAI_VOICE_NAME"],
        "transcribe_model": values.get("OPENAI_TRANSCRIBE_MODEL") or VOICE_DEFAULTS["OPENAI_TRANSCRIBE_MODEL"],
    }


def cmd_voice_status(args):
    """Whether a key is set, and enough to recognise it: its last four characters."""
    values = _voice_read()
    key = values.get("OPENAI_API_KEY", "")
    st = os.stat(VOICE_FILE) if os.path.isfile(VOICE_FILE) else None
    out = {
        "configured": bool(key),
        "last4": key[-4:] if len(key) >= 12 else None,
        "length": len(key) if key else 0,
        "path": VOICE_FILE,
        "mode": oct(st.st_mode & 0o777) if st else None,
        "modified": datetime.fromtimestamp(st.st_mtime, timezone.utc).isoformat(timespec="seconds") if st else None,
    }
    out.update(_voice_options(values))
    ok(out)


def cmd_voice_key_read(args):
    """The key itself, for the panel's own process, which makes the calls.

    The one place the value leaves this file. The panel keeps it in memory and
    never renders, logs or returns it; no route calls this on a browser's behalf.
    """
    values = _voice_read()
    out = {"key": values.get("OPENAI_API_KEY") or None}
    out.update(_voice_options(values))
    ok(out)


def cmd_voice_key_set(args):
    """Store the OpenAI key. Value on stdin, never argv."""
    value = read_stdin_text().strip()
    if not value:
        fail("empty value; use voice-key-clear to remove the key")
    if value.startswith("sk-ant-"):
        fail("that is an Anthropic key; the voice needs an OpenAI key (sk-…)")
    if not OPENAI_KEY_RE.match(value):
        fail("that does not look like an OpenAI API key (expected sk-…)")
    values = _voice_read()
    values["OPENAI_API_KEY"] = value
    _voice_write(values)
    audit("voice-key-set", {"last4": value[-4:], "length": len(value)})
    ok({"configured": True, "last4": value[-4:]})


def cmd_voice_key_clear(args):
    values = _voice_read()
    had = bool(values.pop("OPENAI_API_KEY", None))
    _voice_write(values)
    audit("voice-key-clear", {"had_key": had})
    ok({"configured": False})


def cmd_voice_options_set(args):
    """voice-options-set <model> <voice> <transcribe-model>"""
    if len(args) != 3:
        fail("usage: voice-options-set <model> <voice> <transcribe-model>")
    model, voice, transcribe = args
    if not VOICE_MODEL_RE.match(model):
        fail("not a realtime or live model id: " + repr(model[:60]))
    if not VOICE_NAME_RE.match(voice):
        fail("not a voice name: " + repr(voice[:30]))
    if not VOICE_TRANSCRIBE_RE.match(transcribe):
        fail("not a transcription model id: " + repr(transcribe[:60]))
    values = _voice_read()
    values.update({"OPENAI_VOICE_MODEL": model, "OPENAI_VOICE_NAME": voice, "OPENAI_TRANSCRIBE_MODEL": transcribe})
    _voice_write(values)
    audit("voice-options-set", {"model": model, "voice": voice, "transcribe_model": transcribe})
    ok(_voice_options(values))


