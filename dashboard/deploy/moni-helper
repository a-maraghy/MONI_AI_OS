def check_unit(unit):
    if unit not in MANAGED_UNITS:
        fail("service not managed by this panel: " + repr(unit))
    return unit


def service_state(unit):
    active = run(["systemctl", "is-active", unit]).stdout.strip() or "unknown"
    enabled = run(["systemctl", "is-enabled", unit]).stdout.strip() or "unknown"

    # Socket-activated units look alarming otherwise: on Ubuntu 24.04 ssh.service
    # is 'disabled' while ssh.socket is enabled, and SSH comes back on boot
    # perfectly well. Reporting the raw service state would have an operator
    # "fixing" a service that was never broken.
    via_socket = False
    if enabled in ("disabled", "static", "unknown"):
        socket_unit = unit.split(".")[0] + ".socket"
        if run(["systemctl", "is-enabled", socket_unit]).stdout.strip() == "enabled":
            enabled = "enabled"
            via_socket = True
    since = run(
        ["systemctl", "show", unit, "-p", "ActiveEnterTimestamp", "--value"]
    ).stdout.strip()
    mem = run(["systemctl", "show", unit, "-p", "MemoryCurrent", "--value"]).stdout.strip()
    try:
        mem_bytes = int(mem)
        if mem_bytes < 0:
            mem_bytes = None
    except (TypeError, ValueError):
        mem_bytes = None
    return {
        "unit": unit,
        "active": active,
        "enabled": enabled,
        "socket_activated": via_socket,
        "since": since,
        "memory": mem_bytes,
        "stoppable": unit not in UNSTOPPABLE_UNITS,
    }


