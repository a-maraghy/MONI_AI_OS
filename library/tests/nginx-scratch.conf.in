# Scratch nginx for the MINT Library tests: the same locations as the production server block
# (deploy/nginx-library.conf), on plain HTTP at 127.0.0.1:@WEB@. Generated by tests/scratch.sh.
user root;
worker_processes 1;
pid @SCR@/nginx.pid;
error_log @SCR@/logs/nginx-error.log;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    types { text/vtt vtt; }
    access_log @SCR@/logs/nginx-access.log;
    client_body_temp_path @SCR@/tmp/body;
    proxy_temp_path @SCR@/tmp/proxy;
    fastcgi_temp_path @SCR@/tmp/fcgi;
    uwsgi_temp_path @SCR@/tmp/uwsgi;
    scgi_temp_path @SCR@/tmp/scgi;
    sendfile on;
    limit_req_zone $binary_remote_addr zone=library_login:1m rate=20r/m;
    server {
        listen 127.0.0.1:@WEB@;
        server_name localhost;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        root @SCR@/site;
        index index.html;
        autoindex off;
        error_page 404 /404.html;
        include @REPO@/library/deploy/nginx-library-locations.conf;
        location ^~ /_store/ {
            internal;
            alias @SCR@/state/store/;
            add_header Cache-Control "private, no-store";
            add_header X-Content-Type-Options "nosniff" always;
        }
    }
    upstream mint_library { server 127.0.0.1:@API@; keepalive 8; }
}
