def index_info(c, req):
    paths = [r[0] for r in c.execute(
        "SELECT file_path FROM ingest_state WHERE file_path NOT LIKE 'doc:%' "
        "AND file_path NOT LIKE 'facts:%'").fetchall()]
    docs = [r[0][4:] for r in c.execute(
        "SELECT file_path FROM ingest_state WHERE file_path LIKE 'doc:%'").fetchall()]
    sessions = {r[0]: r[1] for r in c.execute(
        "SELECT session_id, count(*) FROM chunks WHERE source = 'transcript' "
        "AND session_id IS NOT NULL GROUP BY 1").fetchall()}
