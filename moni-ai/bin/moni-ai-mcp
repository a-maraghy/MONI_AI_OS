    inputSchema: {
      type: "object",
      properties: { mission_id: missionId, status: { type: "string", enum: ["planned", "active", "done", "failed", "cancelled"] }, title: { type: "string" } },
      required: ["mission_id"],
      additionalProperties: false,
    },
  },
  {
    name: "mission_list",
    op: "missions",
    description: "List missions with their steps: the open ones by default, or all.",
    inputSchema: { type: "object", properties: { status: { type: "string", enum: ["active", "all"] } }, additionalProperties: false },
    defaults: { status: "active" },
  },
  {
    name: "mission_get",
    op: "mission",
    description: "One mission with its steps and metrics.",
    inputSchema: { type: "object", properties: { mission_id: missionId }, required: ["mission_id"], additionalProperties: false },
  },
  {
    name: "decision_propose",
    op: "decision-propose",
    description:
      "After investigating a watcher alert (a turn that starts with [Watcher: … · decision #N]), record what you found and the fix you propose. " +
      "It appears as a decision card with Approve / Dismiss / Ask more. Do not run the fix yourself: you will be asked to once it is approved. " +
      "Leave fix_command out when nothing needs doing.",
    inputSchema: {
      type: "object",
      properties: {
        decision_id: { type: "integer", minimum: 1 },
        summary: { type: "string", description: "The cause and what the fix does, in two or three short sentences." },
        evidence: { type: "string", description: "The log lines or output you relied on (a few lines)." },
        fix_command: { type: "string", description: "The exact shell command(s) you would run." },
      },
      required: ["decision_id", "summary"],
      additionalProperties: false,
    },
  },
  {
    name: "decision_update",
    op: "decision-update",
    description: "After running an approved fix, record whether it worked.",
    inputSchema: {
      type: "object",
      properties: { decision_id: { type: "integer", minimum: 1 }, status: { type: "string", enum: ["done", "failed"] }, result: { type: "string" } },
      required: ["decision_id", "status"],
      additionalProperties: false,
    },
