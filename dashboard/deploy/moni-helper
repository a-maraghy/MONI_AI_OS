def validate_config(cfg, creating):
    """Validate the dashboard-supplied agent configuration.

    The dashboard validates too, but it is a web app: this is the layer that has
    to hold if the web app is wrong.
    """
    out = {}

    slug = cfg.get("slug", "")
    check_slug(slug)
    out["slug"] = slug

    name = str(cfg.get("name") or slug).strip()
    if not NAME_RE.match(name):
        fail("display name contains disallowed characters")
    out["name"] = name

    role = str(cfg.get("role") or "").strip()
    if len(role) > 4000:
        fail("role description is too long (max 4000 characters)")
    out["role"] = role

    model = str(cfg.get("model") or "claude-opus-5").strip()
    if not MODEL_RE.match(model):
        fail("invalid model id")
    out["model"] = model

    # How hard the model thinks before answering. Medium is the default because
    # it is the right trade for the conversational work most agents do; the
    # higher levels cost noticeably more time and tokens per turn and are worth
    # it only for agents doing genuinely hard reasoning.
    effort = str(cfg.get("effort") or "medium").strip().lower()
    if effort not in EFFORT_LEVELS:
        fail("effort must be one of: " + ", ".join(EFFORT_LEVELS))
    out["effort"] = effort

    try:
        verbose = int(cfg.get("verbose_level", 1))
    except (TypeError, ValueError):
        fail("verbose level must be a number")
    if verbose not in (0, 1, 2):
        fail("verbose level must be 0, 1 or 2")
    out["verbose_level"] = verbose

    try:
        max_turns = int(cfg.get("max_turns", 100))
    except (TypeError, ValueError):
        fail("max turns must be a number")
    if not 1 <= max_turns <= 500:
        fail("max turns must be between 1 and 500")
    out["max_turns"] = max_turns

    try:
        timeout = int(cfg.get("timeout_seconds", 1800))
    except (TypeError, ValueError):
        fail("timeout must be a number")
    if not 60 <= timeout <= 7200:
        fail("timeout must be between 60 and 7200 seconds")
    out["timeout_seconds"] = timeout

    project = str(cfg.get("project_dir") or "").strip()
    if project:
        if not ABS_PATH_RE.match(project) or ".." in project:
            fail("project directory must be a plain absolute path")
        real = os.path.realpath(project)
        if not any(real == root or real.startswith(root + "/") for root in PROJECT_ROOTS):
            fail("project directory must live under one of: " + ", ".join(PROJECT_ROOTS))
        if not os.path.isdir(real):
            fail("project directory does not exist: " + real)
        project = real
    out["project_dir"] = project

    # Whether the agent may post the files it makes (Word, PDF, Excel ...) into
    # the chat and topic that asked. On unless switched off: the administrator
    # wants it for every agent, and an agent.json from before this option
    # simply has no key.
    out["file_send"] = parse_flag(cfg.get("file_send"), True)
    # Pictures drawn in code: the agent writes SVG and the runtime renders it
    # to PNG (resvg) so Claude can look at its drawing, refine it and send the
    # SVG with a PNG preview. Free -- no image API, no key. On unless switched
    # off; it rides on file sending, so the environment says false whenever
    # file_send is off, whatever is stored here.
    out["drawing"] = parse_flag(cfg.get("drawing"), True)

    # Add-ons are named capabilities; the environment they imply is computed by
    # the dashboard from its catalogue and passed here as a flat map. The helper
    # does not trust that map -- it revalidates every key and value, because
    # these end up in a systemd EnvironmentFile read by a process that runs
    # model-authored commands.
    out["addons"] = validate_addon_ids(cfg.get("addons"))
    out["addon_env"] = validate_env_map(cfg.get("addon_env"))

    return out


def validate_addon_ids(raw):
    if raw in (None, ""):
        return []
    if not isinstance(raw, list):
        fail("addons must be a list of ids")
    if len(raw) > 60:
        fail("too many add-ons")
    out = []
    for item in raw:
        item = str(item)
        if not ADDON_ID_RE.match(item):
            fail("invalid add-on id: " + repr(item[:40]))
        if item not in out:
            out.append(item)
    return sorted(out)


def validate_env_map(raw):
    """Validate a dashboard-supplied environment fragment.

    A newline in a value would let one setting inject another into the
    EnvironmentFile, so it is rejected rather than escaped.
    """
    if raw in (None, ""):
        return {}
    if not isinstance(raw, dict):
        fail("addon_env must be an object")
    if len(raw) > 80:
        fail("too many environment entries")
    out = {}
    for key, value in raw.items():
        key = str(key)
        value = "" if value is None else str(value)
        if not ENV_KEY_RE.match(key):
            fail("invalid environment key: " + repr(key[:40]))
        if not ENV_VALUE_RE.match(value):
            fail("environment value for " + key + " contains a newline or null byte")
        if key in PROTECTED_ENV_KEYS:
            fail(key + " is set by the panel and cannot be overridden by an add-on")
        out[key] = value
    return out


# Keys the helper computes itself. An add-on that could set these could point an
# agent at another agent's vault, or hand it someone else's bot token.
PROTECTED_ENV_KEYS = {
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_BOT_USERNAME",
    "APPROVED_DIRECTORY",
    "ALLOWED_USERS",
    "DATABASE_URL",
    "MCP_CONFIG_PATH",
    "MONI_VAULT",
    "MONI_VECTOR_DB",
    "MONI_AGENT_SLUG",
    "CLAUDE_CODE_OAUTH_TOKEN",
    "ANTHROPIC_API_KEY",
    "ENVIRONMENT",
    "DEVELOPMENT_MODE",
    # Telegram Topics: written together with the projects file they point at
    # (see topic_plan), so an add-on cannot switch topic mode on half-way.
    "ENABLE_PROJECT_THREADS",
    "PROJECT_THREADS_MODE",
    "PROJECT_THREADS_CHAT_ID",
    "PROJECTS_CONFIG_PATH",
    # ... and the per-agent group options that go with them (see topic_plan
    # and respond_settings): validated at save time, written by the helper only.
    "PROJECT_THREADS_GENERAL_PROJECT",
    "PROJECT_THREADS_AUTO_MAP",
    "PROJECT_THREADS_AUTO_ANNOUNCE",
