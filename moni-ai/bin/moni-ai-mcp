  {
    name: "status_snapshot",
    op: "snapshot",
    description:
      "This VPS at a glance, read-only and instant: CPU, memory and disk (in GB and whole percent), the tracked services and which failed, " +
      "the live sessions, open missions with their steps, open decisions and pending approvals (counts and titles), and your own queue. " +
      "Use it FIRST for any status question; run shell checks only for what it does not cover.",
    inputSchema: { type: "object", properties: {}, additionalProperties: false },
    noArgs: true,
    shape: snapshotView,
  },
  ...uiTools(),
  // Hired sessions (M-6). Stable schemas from day one: plain strings, no enums (a resumed CLI keeps what it first loaded).
  {
    name: "session_hire",
    op: "session-hire",
    description:
      "Hire a worker session: start a new Claude Code session with its own context, under the given display name, in the given directory, " +
