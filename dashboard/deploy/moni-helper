def wa_unit(slug):
    return WA_UNIT_PREFIX + slug + ".service"


def render_bridge_env(cfg, agent_cfg):
    """Environment for the WhatsApp bridge process.

    Built here rather than in the bridge so the same rules apply as everywhere
    else: the panel decides what a channel may reach, and the process is handed
    the answer rather than working it out from user input.
    """
    d = agent_dir(cfg["agent"])
    env = {
        "MONI_CHANNEL_SLUG": cfg["slug"],
        "MONI_CHANNEL_DIR": channel_dir(cfg["slug"]),
        "MONI_AGENT_SLUG": cfg["agent"],
        "MONI_AGENT_NAME": agent_cfg.get("name", cfg["agent"]),
        "MONI_AGENT_VAULT": os.path.join(d, "vault"),
        "MONI_MCP_CONFIG": os.path.join(d, "mcp.json"),
        "MONI_MODEL": agent_cfg.get("model", "claude-opus-5"),
        "MONI_MAX_TURNS": str(agent_cfg.get("max_turns", 100)),
        "MONI_ALLOWED_NUMBERS": cfg.get("allowed_numbers", ""),
        "MONI_MODEL_CACHE": os.path.join(SHARED_DIR, "models"),
    }
    # Channel add-ons decide what this transport accepts, exactly as they do on
    # the Telegram side.
    for key, value in (cfg.get("addon_env") or {}).items():
        if key not in PROTECTED_ENV_KEYS:
            env[key] = value
    lines = ["# Generated by the MONI dashboard. Edit through the panel."]
    for key in sorted(env):
        lines.append(key + "=" + env[key])
    return "\n".join(lines) + "\n"


def write_bridge_env(cfg, uid, gid):
    if cfg.get("type") != "whatsapp":
        return False
    if not cfg.get("agent") or not os.path.isdir(agent_dir(cfg["agent"])):
        return False
    agent_cfg = read_agent_json(cfg["agent"])
    path = os.path.join(channel_dir(cfg["slug"]), "bridge.env")
    fd, tmp = tempfile.mkstemp(dir=channel_dir(cfg["slug"]))
    with os.fdopen(fd, "w") as fh:
        fh.write(render_bridge_env(cfg, agent_cfg))
    os.chown(tmp, uid, gid)
    os.chmod(tmp, 0o640)
    os.replace(tmp, path)
    return True


def reconcile_whatsapp(slug):
    """Start, restart or stop the bridge to match the channel's configuration."""
    meta = read_channel_json(slug)
    if meta.get("type") != "whatsapp":
        return {"bridge": "n/a"}
    if not os.path.isfile(os.path.join(WHATSAPP_DIR, "bridge.mjs")):
        return {"bridge": "not installed; run deploy/install-whatsapp.sh"}

    uid, gid = agent_ids()
    has_env = write_bridge_env({**meta, "slug": slug}, uid, gid)
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "reset-failed", wa_unit(slug)])

    if not has_env:
        # No agent connected: nothing to answer with, so do not run a process
        # that would collect messages and drop them.
        run(["systemctl", "disable", "--now", wa_unit(slug)], timeout=45)
        return {"bridge": "stopped (no agent connected)"}

    r = run(["systemctl", "enable", "--now", wa_unit(slug)], timeout=45)
    if r.returncode == 0 and unit_state_for(wa_unit(slug))["active"] == "active":
        run(["systemctl", "restart", wa_unit(slug)], timeout=45)
    return {"bridge": "running" if r.returncode == 0 else r.stderr.strip()[:200]}


